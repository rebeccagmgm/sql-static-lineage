{
  "name": "sql-static-lineage-l1",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-bound SQL Static Lineage L1 vertical slice.",
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "sql",
    "static-lineage",
    "machine-facts",
    "databricks"
  ],
  "scripts": {
    "prepare:deps": "node scripts/ensure-dependencies.mjs",
    "prebuild": "npm run prepare:deps",
    "build": "node --input-type=module -e \"import { SqlSession, Schema } from 'sqllens'; if (!SqlSession || !Schema) throw new Error('sqllens engine missing'); console.log('build: sqllens engine ready');\"",
    "pretypecheck": "npm run prepare:deps",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run prepare:deps",
    "test": "vitest run tests/machine-facts.test.ts tests/input-pack-machine-facts.test.ts tests/field-lineage.test.ts tests/field-lineage-baseline.test.ts tests/physical-field-resolver.test.ts tests/physical-field-expander.test.ts tests/semantic-dependency-contract.test.ts tests/operator-support-matrix.test.ts tests/semantic-dependency-normalizer.test.ts tests/plan-adapter-regression.test.ts tests/read-occurrence-resolver.test.ts tests/task-inspection.test.ts tests/input-pack.test.ts tests/sql-table-references.test.ts tests/repair-stored-input-packs.test.ts tests/rebuild-task-partition-evidence.test.ts tests/reconcile-one-hop.test.ts tests/producer-index.test.ts tests/producer-index-query.test.ts tests/reconcile-multi-hop.test.ts tests/reconcile-multi-hop-autofill.test.ts tests/task-partition-evidence.test.ts tests/visualize-multi-hop.test.ts tests/collect-one-task-input-pack-sparkindex.test.ts tests/schedule-detail-cache.test.ts tests/fill-hive-task-sql-cache.test.ts tests/fill-run-script-sql-cache.test.ts tests/jsonl-offset-index.test.ts tests/offline-table-resolver.test.ts tests/cache-task-evidence.test.ts tests/collect-input-pack-from-cache.test.ts",
    "test:input-pack:from-cache": "vitest run tests/jsonl-offset-index.test.ts tests/offline-table-resolver.test.ts tests/cache-task-evidence.test.ts tests/collect-input-pack-from-cache.test.ts",
    "pretest:engine": "npm run prepare:deps",
    "test:engine": "vitest run tests/plan-adapter-regression.test.ts",
    "test:read-occurrence": "vitest run tests/read-occurrence-resolver.test.ts",
    "pretest:machine-facts": "npm run prepare:deps",
    "test:machine-facts": "vitest run tests/machine-facts.test.ts",
    "pretest:consumer": "npm run prepare:deps",
    "test:consumer": "vitest run tests/task-inspection.test.ts",
    "test:input-pack": "vitest run tests/input-pack.test.ts tests/sql-table-references.test.ts",
    "test:input-pack:sparkindex": "vitest run tests/collect-one-task-input-pack-sparkindex.test.ts",
    "test:horae-task-type-cache": "vitest run tests/horae-task-type-cache.test.ts",
    "test:szdata-schedule-detail-cache": "vitest run tests/schedule-detail-cache.test.ts",
    "test:reconcile-one-hop": "vitest run tests/reconcile-one-hop.test.ts",
    "test:producer-index": "vitest run tests/producer-index.test.ts",
    "test:producer-index-query": "vitest run tests/producer-index-query.test.ts",
    "test:partition-evidence": "vitest run tests/task-partition-evidence.test.ts",
    "test:reconcile-multi-hop": "vitest run tests/reconcile-multi-hop.test.ts",
    "test:reconcile-multi-hop-autofill": "vitest run tests/reconcile-multi-hop-autofill.test.ts",
    "test:reconcile-multi-hop-closure-audit": "vitest run tests/audit-multi-hop-closure.test.ts",
    "test:visualize-multi-hop": "vitest run tests/visualize-multi-hop.test.ts",
    "test:input-pack-closure": "vitest run tests/input-pack-closure.test.ts",
    "test:lineage-all": "vitest run tests/lineage-all.test.ts",
    "test:field-lineage": "vitest run tests/input-pack-machine-facts.test.ts tests/field-lineage.test.ts tests/field-lineage-baseline.test.ts tests/physical-field-resolver.test.ts tests/physical-field-expander.test.ts tests/semantic-dependency-contract.test.ts tests/operator-support-matrix.test.ts tests/semantic-dependency-normalizer.test.ts",
    "test:causal-slice": "vitest run tests/target-field-causal-slice --no-file-parallelism",
    "test:target-table-causal-closure": "vitest run tests/target-table-upstream-causal-closure --no-file-parallelism",
    "reconcile-one-hop": "tsx scripts/reconcile/consumer/one-hop/reconcile-one-hop.ts",
    "reconcile-one-hop:autofill": "tsx scripts/reconcile/consumer/one-hop/reconcile-one-hop-autofill.ts",
    "reconcile-one-hop:batch": "tsx scripts/reconcile/consumer/one-hop/reconcile-one-hop-batch.ts",
    "reconcile-multi-hop": "node --max-old-space-size=384 --import tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop.ts",
    "reconcile-multi-hop:autofill": "node --max-old-space-size=512 --import tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop-autofill.ts",
    "reconcile-multi-hop:bounded": "node --max-old-space-size=384 --import tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop.ts",
    "reconcile-multi-hop:throughput": "tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop.ts",
    "reconcile-multi-hop:batch": "node --max-old-space-size=512 --import tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop-batch.ts",
    "reconcile-multi-hop:batch:bounded": "node --max-old-space-size=512 --import tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop-batch.ts",
    "reconcile-multi-hop:batch:throughput": "tsx scripts/reconcile/consumer/multi-hop/reconcile-multi-hop-batch.ts",
    "reconcile-multi-hop:closure-audit": "tsx scripts/reconcile/consumer/multi-hop/audit-multi-hop-closure.ts",
    "input-pack:machine-facts": "tsx scripts/machine-facts/input-pack-machine-facts.ts",
    "reconcile-field-lineage": "tsx scripts/reconcile/consumer/field-lineage/reconcile-field-lineage.ts",
    "reconcile-target-table-causal-closure": "node --max-old-space-size=1024 --import tsx scripts/reconcile/consumer/target-table-upstream-causal-closure/reconcile-target-table-causal-closure.ts",
    "visualize-multi-hop": "tsx scripts/visualize/multi-hop-visualize.ts",
    "visualize-field-lineage": "tsx scripts/visualize/field-lineage-visualize.ts",
    "lineage:all": "node --max-old-space-size=512 --import tsx scripts/pipeline/lineage-all.ts",
    "producer-index": "tsx scripts/reconcile/producer/producer-index.ts",
    "producer-index:pin": "tsx scripts/reconcile/producer/producer-index.ts --pin",
    "producer-index:update": "tsx scripts/reconcile/producer/producer-index.ts --update",
    "producer-index:query": "tsx scripts/query/producer-index-query.ts",
    "input-pack:tasks": "tsx scripts/input/mainline/collect-task-input-pack.ts",
    "input-pack:from-cache": "tsx scripts/input/mainline/collect-input-pack-from-cache.ts",
    "input-pack:sparkindex": "tsx scripts/input/mainline/collect-one-task-input-pack-sparkindex.ts",
    "input-pack:fill-horae-detail-cache": "tsx scripts/input/mainline/fill-horae-task-detail-cache.ts",
    "input-pack:fill-horae-relation-cache": "tsx scripts/input/mainline/fill-horae-relation-cache.ts",
    "input-pack:fill-hive-task-sql-cache": "tsx scripts/input/mainline/fill-hive-task-sql-cache.ts",
    "input-pack:fill-run-script-sql-cache": "tsx scripts/input/mainline/fill-run-script-sql-cache.ts",
    "input-pack:fill-szdata-detail-cache": "tsx scripts/input/mainline/fill-szdata-schedule-detail-cache.ts",
    "input-pack:fill-sparkindex-schedule-detail-cache": "tsx scripts/input/mainline/fill-sparkindex-schedule-detail-cache.ts",
    "input-pack:fill-missing": "tsx scripts/input/mainline/fill-missing-task-input-packs.ts",
    "input-pack:rebuild-partitions": "tsx scripts/input/partition/rebuild-task-partition-evidence.ts",
    "input-pack:repair-stored": "tsx scripts/input/repair/repair-stored-input-packs.ts",
    "repair:missing-table-packs": "tsx scripts/input/repair/repair-missing-table-packs.ts",
    "preinspect": "npm run prepare:deps",
    "inspect": "tsx scripts/query/task-inspection.ts",
    "preformat:check": "npm run prepare:deps",
    "format:check": "prettier --check package.json README.md docs tests/gold"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "sqllens": "^1.8.0"
  }
}
