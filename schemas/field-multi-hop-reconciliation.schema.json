{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field-multi-hop-reconciliation.schema.json",
  "title": "Field Multi-Hop Reconciliation",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "generatedAt",
    "request",
    "overallStatus",
    "rootNodeIds",
    "nodes",
    "edges",
    "rowsetControls",
    "candidates",
    "gaps",
    "tableEdges",
    "limits",
    "counts",
    "boundaries",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "FIELD_MULTI_HOP_RECONCILIATION" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "required": ["rootTaskId", "rootTable", "rootFields", "factsPolicy"],
      "properties": {
        "rootTaskId": { "type": "string", "minLength": 1 },
        "rootTable": { "type": "string", "minLength": 1 },
        "rootFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "factsPolicy": { "enum": ["current-only", "allow-legacy-partial"] }
      },
      "additionalProperties": false
    },
    "overallStatus": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
    "rootNodeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "rowsetControls": { "type": "array", "items": { "type": "object" } },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "gaps": { "type": "array", "items": { "type": "object" } },
    "tableEdges": { "type": "array", "items": { "type": "object" } },
    "limits": { "type": "object", "required": ["maxDepth", "maxStates", "maxPaths", "truncated", "reasons"] },
    "counts": { "type": "object", "required": ["nodes", "edges", "rowsetControls", "candidates", "gaps"] },
    "boundaries": { "type": "object", "required": ["staticSqlOnly", "runtimeExecution", "dataCorrectness", "businessAcceptance"] },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "physicalField": {
      "type": "object",
      "required": ["platform", "dataSource", "stableTableId", "qualifiedName", "column", "identityStatus"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "dataSource": { "type": "string", "minLength": 1 },
        "stableTableId": { "type": "string", "minLength": 1 },
        "qualifiedName": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "identityStatus": { "enum": ["SCHEMA_BACKED", "TASK_LOCAL_SCHEMA_BACKED"] }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["nodeId", "taskId", "taskName", "depth", "field", "bindingId", "expressionId", "expressionText", "evidenceStatus"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "taskName": { "type": ["string", "null"] },
        "depth": { "type": "integer", "minimum": 0 },
        "field": { "$ref": "#/$defs/physicalField" },
        "bindingId": { "type": ["string", "null"] },
        "expressionId": { "type": ["string", "null"] },
        "expressionText": { "type": ["string", "null"] },
        "evidenceStatus": { "enum": ["CONFIRMED", "PROVISIONAL_LEGACY", "UNRESOLVED"] }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["edgeId", "fromNodeId", "toNodeId", "consumerTaskId", "producerTaskId", "kind", "mapping", "evidenceStatus", "evidenceRefs"],
      "properties": {
        "edgeId": { "type": "string", "minLength": 1 },
        "fromNodeId": { "type": "string", "minLength": 1 },
        "toNodeId": { "type": "string", "minLength": 1 },
        "consumerTaskId": { "type": "string", "minLength": 1 },
        "producerTaskId": { "type": ["string", "null"] },
        "kind": { "const": "VALUE_FLOW" },
        "mapping": { "type": "string", "minLength": 1 },
        "evidenceStatus": { "enum": ["CONFIRMED", "PROVISIONAL_LEGACY", "UNRESOLVED"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
