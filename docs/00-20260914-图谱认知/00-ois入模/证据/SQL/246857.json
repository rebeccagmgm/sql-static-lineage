      "text": ""
    },
    {
      "line": 34,
      "text": "-- querySql"
    },
    {
      "line": 35,
      "text": "INSERT OVERWRITE TABLE T05_OTC_DERI_COMP_SALE_INCOME_PARA_APPR_EVT PARTITION(Src_Tbl='${src_table}',Busi_Date='${data_day_str}')"
    },
    {
      "line": 36,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 37,
      "text": "--Group1.: Source Table:[ODATA_N_OIS.G_CROSS_SELL_APPROVAL_PROCESS:销售收入审批流] "
    },
    {
      "line": 38,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 39,
      "text": "SELECT"
    },
    {
      "line": 40,
      "text": "      CONCAT('OIS061-',ID)                              AS  Evt_Id                  --事件编号        "
    },
    {
      "line": 41,
      "text": "     ,DRAFTER                                           AS  Dft_Prsn_User_Id_Str    --拟稿人用户编号串"
    },
    {
      "line": 42,
      "text": "     ,CASE WHEN CURRENT_STATUS ='DRAFT'         THEN '21'"
    },
    {
      "line": 43,
      "text": "           WHEN CURRENT_STATUS ='TRADER_REVIEW' THEN '1'"
    },
    {
      "line": 44,
      "text": "           WHEN CURRENT_STATUS ='CLOSED'        THEN '38' "
    },
    {
      "line": 45,
      "text": "           ELSE CURRENT_STATUS END                      AS  Appr_Stat_Cd            --审批状态代码    "
    },
    {
      "line": 46,
      "text": "     ,CURRENT_OPERATOR                                  AS  Procsr_User_Id          --处理人用户编号  "
    },
    {
      "line": 47,
      "text": "     ,CURRENT_ACTIVITY_NAME                             AS  Proc_Idde_Name          --处理流程节点名称"
    },
    {
      "line": 48,
      "text": "     ,CASE WHEN CURRENT_ACTIVITY_ID ='01' THEN 'draft'"
    },
    {
      "line": 49,
      "text": "           WHEN CURRENT_ACTIVITY_ID ='02' THEN 'auditing'"
    },
    {
      "line": 50,
      "text": "           WHEN CURRENT_ACTIVITY_ID ='03' THEN 'ended' "
    },
    {
      "line": 51,
      "text": "           ELSE CURRENT_ACTIVITY_ID END  "
    },
    {
      "line": 52,
      "text": "                                                        AS  Proc_Stat_Cd            --流程状态代码    "
    },
    {
      "line": 53,
      "text": "     ,CROSS_OR_INR                                      AS  Coef_Type               --系数类型        "
    },
    {
      "line": 54,
      "text": "     ,CURRENT_OPERATOR_NAME                             AS  Procsr_User_Name        --处理人用户名称  "
    },
    {
      "line": 55,
      "text": "     ,DRAFTER_NAME                                      AS  Dft_Prsn_Name           --拟稿人名称      "
    },
    {
      "line": 56,
      "text": "     ,DEPARTMENT                                        AS  Own_Busi_Dept           --所属业务部门    "
    },
    {
      "line": 57,
      "text": "     ,CREATED_DATETIME                                  AS  Create_Time             --创建时间        "
    },
    {
      "line": 58,
      "text": "     ,UPDATED_DATETIME                                  AS  Upd_Time                --更新时间        "
    },
    {
      "line": 59,
      "text": "     ,trim(CREATED_BY)                                  AS  Create_User_Id          --创建用户编号    "
    },
    {
      "line": 60,
      "text": "     ,trim(UPDATED_BY)                                  AS  Upd_User_Id             --更新用户编号    "
    },
    {
      "line": 61,
      "text": "     ,'${data_src_cd}'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 62,
      "text": "     ,'${filename}'                                AS  Task_Name               --任务名"
    },
    {
      "line": 63,
      "text": "     ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 64,
      "text": "     ,'${data_day_str}'                            AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 65,
      "text": "     ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 66,
      "text": "     ,'${src_table}'                               AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 67,
      "text": "FROM (SELECT *  FROM ${src_table} WHERE  Busi_Date='${data_day_str}' )A"
    },
