    {
      "line": 55,
      "text": "    INSERT OVERWRITE TABLE t02_fin_prd_preterm_info PARTITION(src_id='OIS' ,grp_id = '01' )"
    },
    {
      "line": 56,
      "text": "    SELECT                       "
    },
    {
      "line": 57,
      "text": "        '${data_day_str}'                                          AS busi_date        \t\t-- 数据日期         "
    },
    {
      "line": 58,
      "text": "\t\t,a.prod_code\t\t\t\t\t\t\t\t\t\t\t\t\tAS rec_id\t\t\t\t \t-- 记录编号"
    },
    {
      "line": 59,
      "text": "\t\t,b.secu_id\t\t\t\t\t\t\t\t\t\t\t\t\t\tAS secu_id\t\t\t \t\t-- 统一证券编号"
    },
    {
      "line": 60,
      "text": "\t\t,concat('OIS-',a.prod_code)\t\t\t\t\t\t\t\t\t\tAS src_sys_prdno\t\t \t-- 源系统产品编号"
    },
    {
      "line": 61,
      "text": "\t\t,a.termination_balance\t\t\t\t\t\t\t\t\t\t\tAS preterm_prd_amt\t\t\t-- 提前终止产品金额(元)"
    },
    {
      "line": 62,
      "text": "\t\t,regexp_replace(substr(a.termination_date,1,10),'-','')\t\t\tAS preterm_date\t\t\t\t-- 提前终止日"
    },
    {
      "line": 63,
      "text": "\t\t,a.termination_price\t\t\t\t\t\t\t\t\t\t\tAS preterm_pric\t\t\t\t-- 提前终止价格(元)"
    },
    {
      "line": 64,
      "text": "\t\t,regexp_replace(substr(a.termination_payment_date,1,10),'-','')\tAS preterm_pay_date\t\t\t-- 提前终止兑付日"
    },
    {
      "line": 65,
      "text": "\t\t,a.termination_rate\t\t\t\t\t\t\t\t\t\t\t\tAS preterm_prd_yield\t\t-- 提前终止产品收益率（绝对）"
    },
    {
      "line": 66,
      "text": "\t\t,a.termination_pay_balance\t\t\t\t\t\t\t\t\t\tAS preterm_pay_amt\t\t\t-- 提前终止兑付金额(元)"
    },
    {
      "line": 67,
      "text": "\t\t,a.prod_id\t\t\t\t\t\t\t\t\t\t\t\t\t\tAS float_income_vchr_rec_id\t-- 浮动收益凭证记录编号"
    },
    {
      "line": 68,
      "text": "\t\t,case when a.end_report_flag = 'true' then '1'"
    },
    {
      "line": 69,
      "text": "\t\t\twhen a.end_report_flag = 'false' then '0'"
    },
    {
      "line": 70,
      "text": "\t\t\telse '' "
    },
    {
      "line": 71,
      "text": "\t\t\tend \t\t\t\t\t\t\t\t\t\t\t\t\t\tAS trmt_rgst_flag\t\t\t-- 终止报备标志(0-否 1-是)"
    },
    {
      "line": 72,
      "text": "\t\t,concat('{\\\\\"id\\\\\":\\\\\"',coalesce(a.id,''),'\\\\\"}')               AS remark "
    },
    {
      "line": 73,
      "text": "\t\t,'odata_n_ois.o_exchange_pre_termination_list'\t\t\t\t\tAS src_tbl\t\t\t \t\t-- 来源表"
    },
    {
      "line": 74,
      "text": "\t\t,a.prod_code\t\t\t\t\t\t\t\t\t\t\t\t\tAS src_rec_id\t\t\t \t-- 来源记录"
    },
    {
      "line": 75,
      "text": "\t\t,from_unixtime(unix_timestamp(), 'yyyy-MM-dd HH:mm:ss')\t\t\tAS rec_upd_time\t\t \t\t-- 记录修改时间"
    },
    {
      "line": 76,
      "text": "\t\t,from_unixtime(unix_timestamp(), 'yyyy-MM-dd HH:mm:ss')\t\t\tAS rec_down_time\t\t \t-- 记录创建时间"
    },
    {
      "line": 77,
      "text": "    from "
    },
    {
      "line": 78,
      "text": "    (select * from odata_n_ois.o_exchange_pre_termination_list where busi_date = '${data_day_str}' ) a"
    },
    {
      "line": 79,
      "text": "    left join "
    },
    {
      "line": 80,
      "text": "    (select * from t02_scr_base_info where src_id = 'OTC') b"
    },
    {
      "line": 81,
      "text": "    on a.prod_code = b.scr_cd"
    },
