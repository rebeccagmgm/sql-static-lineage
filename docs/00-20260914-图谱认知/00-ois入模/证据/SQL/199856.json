      "text": "           A.*,B.*"
    },
    {
      "line": 53,
      "text": "           ,CASE WHEN A.Pty_Id IS NULL     AND B.Pty_Id1 IS NOT NULL THEN 'I'           --当天不存在历史的数据为新增"
    },
    {
      "line": 54,
      "text": "                 WHEN A.Pty_Id IS NOT NULL AND B.Pty_Id1 IS NULL THEN 'D'           --历史不存在当天的数据为删除"
    },
    {
      "line": 55,
      "text": "                 WHEN A.Pty_Id IS NOT NULL AND B.Pty_Id1 IS NOT NULL AND"
    },
    {
      "line": 56,
      "text": "                 (   COALESCE(A.Oact_Bnk_Name           ,'')   <> COALESCE(B.Oact_Bnk_Name1          ,'')"
    },
    {
      "line": 57,
      "text": "                  OR COALESCE(A.Bnk_Acct                ,'')   <> COALESCE(B.Bnk_Acct1               ,'')"
    },
    {
      "line": 58,
      "text": "                  OR COALESCE(A.Bnk_Acct_Name           ,'')   <> COALESCE(B.Bnk_Acct_Name1          ,'')"
    },
    {
      "line": 59,
      "text": "                  OR COALESCE(A.Bnk_Acct_City           ,'')   <> COALESCE(B.Bnk_Acct_City1          ,'')"
    },
    {
      "line": 60,
      "text": "                  OR COALESCE(A.Larg_Pymt_No            ,'')   <> COALESCE(B.Larg_Pymt_No1           ,'')"
    },
    {
      "line": 61,
      "text": "             ) THEN 'U'                                                        --当天和历史均存在,除主键外如有字段变更为变更"
    },
    {
      "line": 62,
      "text": "                 ELSE 'S' END AS DATA_TYPE                                         --其他为无变更"
    },
    {
      "line": 63,
      "text": "    FROM   (  SELECT"
    },
    {
      "line": 64,
      "text": "                *"
