      "text": "    FULL OUTER JOIN ${db_temp}.T01_PTY_BNK_ACCT_H_TEMP_OIS039 B               --当天的数据"
    },
    {
      "line": 70,
      "text": "    ON  NVL(A.Pty_Id             ,'')= NVL(B.Pty_Id1               ,'')"
