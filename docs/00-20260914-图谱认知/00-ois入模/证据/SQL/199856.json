      "text": "    AND NVL(A.Bnk_Acct           ,'')= NVL(B.Bnk_Acct1             ,'')"
    },
    {
      "line": 73,
      "text": "    AND NVL(A.Bnk_Acct_Name      ,'')= NVL(B.Bnk_Acct_Name1        ,'')"
