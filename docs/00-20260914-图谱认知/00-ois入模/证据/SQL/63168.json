      "text": "SELECT"
    },
    {
      "line": 66,
      "text": "       A.*"
    },
    {
      "line": 67,
      "text": "      ,B.Pty_Id         AS Pty_Id1"
    },
    {
      "line": 68,
      "text": "      ,B.Pty_Name       AS Pty_Name1"
    },
    {
      "line": 69,
      "text": "      ,B.Pty_Cate_Cd    AS Pty_Cate_Cd1"
    },
    {
      "line": 70,
      "text": "      ,B.Pty_Stat_Cd    AS Pty_Stat_Cd1"
    },
    {
      "line": 71,
      "text": "      ,B.Oact_Date      AS Oact_Date1"
    },
    {
      "line": 72,
      "text": "      ,B.Clos_Date      AS Clos_Date1"
    },
    {
      "line": 73,
      "text": "      ,B.Data_Src_Cd    AS Data_Src_Cd1"
    },
    {
      "line": 74,
      "text": "      ,B.Src_Tbl        AS Src_Tbl1"
    },
    {
      "line": 75,
      "text": "      ,B.Task_Name      AS Task_Name1"
    },
    {
      "line": 76,
      "text": "      ,B.Data_Etl_Date  AS Data_Etl_Date1"
    },
    {
      "line": 77,
      "text": "      ,B.Data_Upt_Date  AS Data_Upt_Date1"
    },
    {
      "line": 78,
      "text": "      ,B.Del_Flag       AS Del_Flag1"
    },
    {
      "line": 79,
      "text": "      ,B.Del_Date       As Del_Date1"
    },
    {
      "line": 80,
      "text": "      ,B.Real_Src_Tbl   AS Real_Src_Tbl1"
    },
    {
      "line": 81,
      "text": "      ,CASE WHEN A.Pty_Id IS NULL AND B.Pty_Id IS NOT NULL THEN 'I' --新增"
    },
    {
      "line": 82,
      "text": "            WHEN A.Pty_Id IS NOT NULL AND B.Pty_Id IS NULL THEN 'D' --删除"
    },
    {
      "line": 83,
      "text": "            WHEN A.Pty_Id IS NOT NULL AND B.Pty_Id IS NOT NULL AND ("
    },
    {
      "line": 84,
      "text": "                COALESCE(A.Pty_Name        ,'')   <> COALESCE(B.Pty_Name           ,'')"
    },
    {
      "line": 85,
      "text": "             OR COALESCE(A.Pty_Cate_Cd     ,'')   <> COALESCE(B.Pty_Cate_Cd        ,'')"
    },
    {
      "line": 86,
      "text": "             OR COALESCE(A.Pty_Stat_Cd     ,'')   <> COALESCE(B.Pty_Stat_Cd        ,'')"
    },
    {
      "line": 87,
      "text": "             OR COALESCE(A.Oact_Date       ,'')   <> COALESCE(B.Oact_Date          ,'')"
    },
    {
      "line": 88,
      "text": "             OR COALESCE(A.Clos_Date       ,'')   <> COALESCE(B.Clos_Date          ,'')"
    },
    {
      "line": 89,
      "text": "             OR COALESCE(A.Del_Flag        ,'')   <> COALESCE(B.DEL_FLAG           ,'')"
    },
    {
      "line": 90,
      "text": "            )"
    },
    {
      "line": 91,
      "text": "            THEN     'U' --变更"
    },
    {
      "line": 92,
      "text": "            ELSE     'S' --无变更"
    },
    {
      "line": 93,
      "text": "            END AS DATA_TYPE"
    },
    {
      "line": 94,
      "text": "FROM  (SELECT * FROM T01_PTY WHERE SRC_TBL='ODATA_N_OIS.O_OTC_DERIVATIVE_COUNTERPARTY' )A --拆分后只对比该表的数据"
    },
