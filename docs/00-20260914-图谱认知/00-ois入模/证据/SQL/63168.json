      "text": "PARTITIONED BY (SRC_TBL  STRING COMMENT '源表')"
    },
    {
      "line": 26,
      "text": "STORED AS ORC;"
    },
    {
      "line": 27,
      "text": ""
    },
    {
      "line": 28,
      "text": "DROP TABLE IF EXISTS TEMP.T01_PTY_TEMP_OIS001;"
    },
    {
      "line": 29,
      "text": "CREATE TABLE TEMP.T01_PTY_TEMP_OIS001"
    },
    {
      "line": 30,
      "text": "AS"
    },
    {
      "line": 31,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 32,
      "text": "---Groups6: Source Table:[ODATA_N_OIS.O_OTC_DERIVATIVE_COUNTERPARTY:衍生品交易对手维护表]"
    },
    {
      "line": 33,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 34,
      "text": "SELECT"
    },
    {
      "line": 35,
      "text": "        A.CLIENT_ID                                         AS Pty_Id                   --当事人编号"
    },
    {
      "line": 36,
      "text": "       ,A.CORPORATE_NAME                                    AS Pty_Name                 --当事人名称"
    },
    {
      "line": 37,
      "text": "       ,CASE WHEN A.IS_PROD_HOLDER='01' THEN '110500'"
    },
    {
      "line": 38,
      "text": "             WHEN A.IS_PROD_HOLDER in ('02','03') THEN '210500'"
    },
    {
      "line": 39,
      "text": "             ELSE A.IS_PROD_HOLDER END                      AS Pty_Cate_Cd              --当事人类别代码"
    },
    {
      "line": 40,
      "text": "       ,CASE A.VALID_FLAG WHEN 'Y' THEN '04'"
    },
    {
      "line": 41,
      "text": "                        WHEN 'N' THEN '07'"
    },
    {
      "line": 42,
      "text": "                        ELSE '99' END                       AS Pty_Stat_Cd              --当事人状态代码"
    },
    {
      "line": 43,
      "text": "       ,''                                                  AS Oact_Date                --开户日期"
    },
    {
      "line": 44,
      "text": "       ,DEFAULT.DATE2DATEKEY(SUBSTR(A.INVALID_DATE,1,10))   AS Clos_Date                --销户日期"
    },
    {
      "line": 45,
      "text": "       ,A.DELETE_FLAG                                       AS Del_Flag                 --删除标志"
    },
    {
      "line": 46,
      "text": "       ,CASE WHEN A.DELETE_FLAG='1' THEN NVL(B.DEL_DATE,'${data_day_str}')"
    },
    {
      "line": 47,
      "text": "             ELSE '' END                                    AS DEL_DATE                 --删除日期  取历史删除日期"
    },
    {
      "line": 48,
      "text": "       ,'OIS'                                               AS Data_Src_Cd              --数据来源代码"
    },
    {
      "line": 49,
      "text": "       ,'ODATA_N_OIS.O_OTC_DERIVATIVE_COUNTERPARTY'         AS Src_Tbl                  --源表"
    },
    {
      "line": 50,
      "text": "       ,UPPER('${filename}')                           AS Task_Name                --任务名"
    },
    {
      "line": 51,
      "text": "       ,'${data_day_str}'                              AS Data_Etl_Date            --数据加载日期"
    },
    {
      "line": 52,
      "text": "       ,'${data_day_str}'                            AS Data_Upt_Date            --数据更新日期"
    },
    {
      "line": 53,
      "text": "       ,'ODATA_N_OIS.O_OTC_DERIVATIVE_COUNTERPARTY'         AS Real_Src_Tbl             --真实源表"
    },
    {
      "line": 54,
      "text": "FROM  ODATA_N_OIS.O_OTC_DERIVATIVE_COUNTERPARTY A"
    },
    {
      "line": 55,
      "text": "LEFT JOIN (SELECT * FROM T01_PTY WHERE SRC_TBL='ODATA_N_OIS.O_OTC_DERIVATIVE_COUNTERPARTY' )B"
    },
    {
      "line": 56,
      "text": "ON     A.CLIENT_ID  =B.Pty_Id"
    },
    {
      "line": 57,
      "text": "AND    A.Delete_Flag=B.Del_Flag"
    },
    {
      "line": 58,
      "text": "WHERE  A.BUSI_DATE='${data_day_str}'"
    },
    {
      "line": 59,
      "text": "  AND  A.DEPARTMENT<>'HK'"
    },
    {
      "line": 60,
      "text": ";"
    },
    {
      "line": 61,
      "text": ""
    },
    {
      "line": 62,
      "text": "DROP TABLE IF EXISTS TEMP.T01_PTY_MID_OIS001;"
    },
    {
      "line": 63,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T01_PTY_MID_OIS001"
