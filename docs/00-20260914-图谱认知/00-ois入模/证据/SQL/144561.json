      "line": 8,
      "text": "-- createSql"
    },
    {
      "line": 9,
      "text": "CREATE TABLE IF NOT EXISTS T01_PTY_NAME("
    },
    {
      "line": 10,
      "text": "     Pty_Id         string comment'当事人编号',"
    },
    {
      "line": 11,
      "text": "     Pty_Cate_Cd    string comment'当事人类别代码',"
    },
    {
      "line": 12,
      "text": "     Full_Name_Ch   string comment'中文全称',"
    },
    {
      "line": 13,
      "text": "     Shor_Name_Ch   string comment'中文简称',"
    },
    {
      "line": 14,
      "text": "     Full_Name_En   string comment'英文全称',"
    },
    {
      "line": 15,
      "text": "     Shor_Name_En   string comment'英文简称',"
    },
    {
      "line": 16,
      "text": "     Data_Src_Cd    string comment'数据来源代码',"
    },
    {
      "line": 17,
      "text": "     Task_Name      string comment'任务名',"
    },
    {
      "line": 18,
      "text": "     Data_Etl_Date  string comment'数据加载日期',"
    },
    {
      "line": 19,
      "text": "     Data_Upt_Date  string comment'数据更新日期',"
    },
    {
      "line": 20,
      "text": "     DATA_TIME      string comment'数据时间'"
    },
    {
      "line": 21,
      "text": ")COMMENT '当事人名称'"
    },
    {
      "line": 22,
      "text": "PARTITIONED BY (Src_Tbl string comment'源表',BUSI_DATE  STRING COMMENT '业务日期')"
    },
    {
      "line": 23,
      "text": "STORED AS ORC;"
    },
    {
      "line": 24,
      "text": ""
    },
    {
      "line": 25,
      "text": "-- querySql"
    },
    {
      "line": 26,
      "text": "INSERT OVERWRITE TABLE T01_PTY_NAME PARTITION(Src_Tbl,BUSI_DATE)"
    },
    {
      "line": 27,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 28,
      "text": "--Group52: Source Table:[ODATA_N_OIS.G_HK_COUNTERPARTY:衍生品交易对手维护表]"
    },
    {
      "line": 29,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 30,
      "text": ""
    },
    {
      "line": 31,
      "text": "SELECT"
    },
    {
      "line": 32,
      "text": "        CLIENT_ID                          as Pty_Id               --当事人编号"
    },
    {
      "line": 33,
      "text": "       ,CASE WHEN CLIENT_TYPE='Individual(PI Confirmed)' THEN '110500'"
    },
    {
      "line": 34,
      "text": "              WHEN CLIENT_TYPE in ('CPI','IPI')           THEN '210500'"
    },
    {
      "line": 35,
      "text": "              ELSE CLIENT_TYPE END         as Pty_Cate_Cd          --当事人类别代码"
    },
    {
      "line": 36,
      "text": "       ,FULL_NAME                          as Full_Name_Ch         --中文全称"
    },
    {
      "line": 37,
      "text": "       ,ABBREVIATION                       as Shor_Name_Ch         --中文简称"
    },
    {
      "line": 38,
      "text": "       ,''                                 as Full_Name_En         --英文全称"
    },
    {
      "line": 39,
      "text": "       ,NAME_ABBREVIATION                  as Shor_Name_En         --英文简称"
    },
    {
      "line": 40,
      "text": "       ,'OIS'                              as DATA_SRC_CD          --数据来源代码"
    },
    {
      "line": 41,
      "text": "       ,UPPER('${filename}')          as TASK_NAME            --任务名"
    },
    {
      "line": 42,
      "text": "       ,'${data_day_str}'             as DATA_ETL_DATE        --数据加载日期"
    },
    {
      "line": 43,
      "text": "       ,'${data_today_str}'           as DATA_UPT_DATE        --数据更新日期"
    },
    {
      "line": 44,
      "text": "       ,'${data_today}'               as DATA_TIME            --数据时间"
    },
    {
      "line": 45,
      "text": "       ,'ODATA_N_OIS.G_HK_COUNTERPARTY'    as SRC_TBL              --源表"
    },
    {
      "line": 46,
      "text": "       ,'${data_day_str}'             as BUSI_DATE            --业务日期"
    },
    {
      "line": 47,
      "text": "FROM  (SELECT * FROM ODATA_N_OIS.G_HK_COUNTERPARTY WHERE BUSI_DATE='${data_day_str}' )A"
    },
    {
      "line": 48,
      "text": ";"
    },
