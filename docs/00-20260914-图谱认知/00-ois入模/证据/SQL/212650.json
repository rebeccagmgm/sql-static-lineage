    {
      "line": 42,
      "text": "INSERT OVERWRITE TABLE T01_OTC_DERI_CUTP_ISDA_AGT_THRH PARTITION(SRC_TBL='ODATA_N_OIS.G_HK_THRESHOLD')"
    },
    {
      "line": 43,
      "text": "SELECT"
    },
    {
      "line": 44,
      "text": "ID                                    AS  Src_Id                  --源ID"
    },
    {
      "line": 45,
      "text": ",CLIENT_ID                             AS  Pty_Id                  --当事人编号"
    },
    {
      "line": 46,
      "text": ",CSA_PARTYA_CURRENCY                   AS  Csa_Pty_A_Crrc_Cd       --PARTYA担保品门槛金额币种代码"
    },
    {
      "line": 47,
      "text": ",CSA_PARTYA_AMOUNT                     AS  Csa_Pty_A_Amt           --PARTYA担保品门槛金额"
    },
    {
      "line": 48,
      "text": ",CASE WHEN CSA_PARTYA_INFINITY = 'true'  THEN '1'"
    },
    {
      "line": 49,
      "text": "WHEN CSA_PARTYA_INFINITY = 'false' THEN '0'"
    },
    {
      "line": 50,
      "text": "ELSE CSA_PARTYA_INFINITY END     AS  Csa_Pty_A_Infi_Flag     --PARTYA担保品门槛金额无穷大标志      true 转1 ，false 转0"
    },
    {
      "line": 51,
      "text": ",CSA_PARTYB_CURRENCY                   AS  Csa_Pty_B_Crrc_Cd       --PARTYB担保品门槛金额币种代码"
    },
    {
      "line": 52,
      "text": ",CSA_PARTYB_AMOUNT                     AS  Csa_Pty_B_Amt           --PARTYB担保品门槛金额"
    },
    {
      "line": 53,
      "text": ",CASE WHEN CSA_PARTYB_INFINITY = 'true'  THEN '1'"
    },
    {
      "line": 54,
      "text": "WHEN CSA_PARTYB_INFINITY = 'false' THEN '0'"
    },
    {
      "line": 55,
      "text": "ELSE CSA_PARTYB_INFINITY END     AS  Csa_Pty_B_Infi_Flag     --PARTYB担保品门槛金额无穷大标志      true转1 ，false转0"
    },
    {
      "line": 56,
      "text": ",SCHEDULE_PARTYA_CURRENCY              AS  Schd_Pty_A_Crrc_Cd      --PARTYA违约金上限币种代码"
    },
