    {
      "line": 32,
      "text": "    --GROUP66: SOURCE TABLE:[ODATA_N_OIS.G_HK_COUNTERPARTY: 香港交易对手]"
    },
    {
      "line": 33,
      "text": "    -----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 34,
      "text": "    SELECT"
    },
    {
      "line": 35,
      "text": "         CLIENT_ID                                AS  Pty_Id                  --当事人编号     "
    },
    {
      "line": 36,
      "text": "        ,CLIENT_NAME                              AS  Pty_Name                --当事人名称     "
    },
    {
      "line": 37,
      "text": "        ,CASE WHEN CLIENT_TYPE='Individual(PI Confirmed)' THEN '110500'"
    },
    {
      "line": 38,
      "text": "              WHEN CLIENT_TYPE in ('CPI','IPI')           THEN '210500'"
    },
    {
      "line": 39,
      "text": "              ELSE CLIENT_TYPE END                AS  Pty_Cate_Cd             --当事人类别代码 "
    },
    {
      "line": 40,
      "text": "        ,NVL(DW_CD_VAL,AUDIT_STATUS)              AS  Pty_Stat_Cd             --当事人状态代码 "
    },
    {
      "line": 41,
      "text": "        ,DEFAULT.DATE2DATEKEY(SUBSTR(OPEN_ACCOUNT_COMPLETE_DATE,1,10))"
    },
    {
      "line": 42,
      "text": "                                                  AS  Oact_Date               --开户日期       "
    },
    {
      "line": 43,
      "text": "        ,''                                       AS  Clos_Date               --销户日期       "
    },
    {
      "line": 44,
      "text": "        ,'${data_src_cd}'                    AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 45,
      "text": "        ,'${src_table}'                      AS  Src_Tbl                 --源表"
    },
    {
      "line": 46,
      "text": "        ,'${filename}'                       AS  Task_Name               --任务名"
    },
    {
      "line": 47,
      "text": "        ,'${data_day_str}'                   AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 48,
      "text": "        ,'${data_day_str}'                   AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 49,
      "text": "        ,'${src_table}'                      AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 50,
      "text": "    FROM  (SELECT * FROM ${src_table}  WHERE BUSI_DATE='${data_day_str}' )A"
    },
    {
      "line": 51,
      "text": "    LEFT JOIN ("
    },
    {
      "line": 52,
      "text": "             SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 53,
      "text": "              FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 54,
      "text": "              WHERE TGT_TAB_NAME = 'T01_PTY'"
    },
    {
      "line": 55,
      "text": "                 AND TGT_TAB_FLD  = 'Pty_Stat_Cd'"
    },
    {
      "line": 56,
      "text": "                 AND SRC_TAB_NAME = 'HK_COUNTERPARTY'"
    },
    {
      "line": 57,
      "text": "                 AND SRC_FLD_NAME = 'AUDIT_STATUS'"
    },
    {
      "line": 58,
      "text": "                 AND SRC_SYS_NAME='OIS')B"
    },
    {
      "line": 59,
      "text": "          ON      A.AUDIT_STATUS =B.SRC_CD_VAL                  --AUDIT_STATUS 转码"
    },
    {
      "line": 60,
      "text": "    ;"
    },
    {
