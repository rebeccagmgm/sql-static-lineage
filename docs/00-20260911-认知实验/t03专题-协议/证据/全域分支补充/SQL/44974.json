      "text": "\t\t,AGREEMENT_FLAG                         as Agt_Flag            --出借协议标志"
    },
    {
      "line": 92,
      "text": "\t\t,NVL(B.DW_CD_VAL,REFCONTRACT_STATUS)    as Ref_Contr_Stat_Cd   --转融通合同状态代码"
