      "text": "\t\t,IF(FUND_ACCOUNT IS NOT NULL AND TRIM(FUND_ACCOUNT)<>'','10201','')   as Ast_Acct_Agt_Modifr  --资产账户协议修饰符"
    },
    {
      "line": 88,
      "text": "\t\t,REFACCT_TYPE                           as Ref_Acct_Type_Cd    --转融通账户类型代码"
