    {
      "line": 91,
      "text": "   -----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 92,
      "text": "   --Group1: Source Table:[ODATA_N_GLM.P_CON_CONTRACT_HD:融资租赁合同主表] "
    },
    {
      "line": 93,
      "text": "   -----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 94,
      "text": "   SELECT"
    },
    {
      "line": 95,
      "text": "         A.CONTRACT_PARENT_ID                                AS  Agt_Id                  --协议编号          "
    },
    {
      "line": 96,
      "text": "        ,'20408'                                             AS  Agt_Modifr              --协议修饰符        "
    },
    {
      "line": 97,
      "text": "        ,IF(NVL(TRIM(A.BP_ID_TENANT),'')='','',CONCAT('GLM003-',A.BP_ID_TENANT))"
    },
    {
      "line": 98,
      "text": "                                                             AS  Agt_Holder              --协议持有人        "
    },
    {
      "line": 99,
      "text": "        ,A.CONTRACT_HD_NAME                                  AS  Agt_Name                --协议名称          "
    },
    {
      "line": 100,
      "text": "        ,NVL(A1.DW_CD_VAL,A.CONTRACT_STATUS)                 AS  Agt_Stat_Cd             --协议状态代码      "
    },
    {
      "line": 101,
      "text": "        ,A.CONTRACT_HD_NUMBER                                AS  Contr_No                --合同编号          "
    },
    {
      "line": 102,
      "text": "        ,A.CONTRACT_HD_ID                                    AS  Contr_Admin_No          --合同管理编号      "
    },
    {
      "line": 103,
      "text": "        ,A.BUSINESS_TYPE                                     AS  Leas_Busi_Type_Cd       --租赁业务类型代码  "
    },
    {
      "line": 104,
      "text": "        ,A.CALC_SESSION_ID                                   AS  Rent_Calc_Id            --租金计算ID        "
    },
    {
      "line": 105,
      "text": "        ,A.FINANCE_AMOUNT                                    AS  Fin_Amt                 --融资金额          "
    },
    {
      "line": 106,
      "text": "        ,IF(NVL(TRIM(A.PROJECT_ID),'')='','',CONCAT('GLM012-',A.PROJECT_ID))"
    },
    {
      "line": 107,
      "text": "                                                             AS  Proj_Id                 --项目编号          "
    },
    {
      "line": 108,
      "text": "        ,A.REF_V01                                           AS  Proj_Assis_Seg          --项目辅助段        "
    },
    {
      "line": 109,
      "text": "        ,IF(NVL(TRIM(A.UNIT_ID),'')='','',CONCAT('GLM006-',A.UNIT_ID))"
    },
    {
      "line": 110,
      "text": "                                                             AS  Inr_Org_Id              --内部机构编号      "
    },
    {
      "line": 111,
      "text": "        ,IF(NVL(TRIM(A.OWNER_USER_ID),'')='','',CONCAT('GLM004-',A.OWNER_USER_ID))"
    },
    {
      "line": 112,
      "text": "                                                             AS  Prin_User_No            --负责人用户编号    "
    },
    {
      "line": 113,
      "text": "        ,NVL(C.ERP_ID,A.OWNER_USER_ID)                       AS  Prin_Emp_No             --负责人员工编号       "
    },
    {
      "line": 114,
      "text": "        ,NVL(A2.DW_CD_VAL,A.WB_STATUS)                       AS  Contr_Text_Appr_Stat_Cd --合同文本审核状态代码 "
    },
    {
      "line": 115,
      "text": "        ,NVL(A3.DW_CD_VAL,A.MQ_STATUS)                       AS  Intv_Proc_Stat_Cd       --面签流程状态代码     "
    },
    {
      "line": 116,
      "text": "        ,A.SIGNING_DESCRIPTION                               AS  Sign_Desc               --签约说明             "
    },
    {
      "line": 117,
      "text": "        ,A.SIGNING_DATE                                      AS  Expe_Sign_Time          --预计签约时间         "
    },
    {
      "line": 118,
      "text": "        ,A.SIGNING_PLACE                                     AS  Expe_Sign_Site          --预计签约地点         "
    },
    {
      "line": 119,
      "text": "        ,A.ACTUAL_SIGNING_DATE                               AS  Actl_Intv_Time          --实际面签时间         "
    },
    {
      "line": 120,
      "text": "        ,A.ACTUAL_SIGNING_DESCRIPTION                        AS  Actl_Intv_Place         --实际面签地点       "
    },
    {
      "line": 121,
      "text": "        ,A.SIGNING_INFO                                      AS  Intv_Situ               --面签情况             "
    },
    {
      "line": 122,
      "text": "        ,A.CDD_LIST_ID                                       AS  Dd_List_Id              --尽职调查清单ID       "
    },
    {
      "line": 123,
      "text": "        ,A.DESCRIPTION                                       AS  Remark                  --备注                 "
    },
    {
      "line": 124,
      "text": "        ,A.CREATION_DATE                                     AS  Create_Time             --创建日期             "
    },
    {
      "line": 125,
      "text": "        ,A.LAST_UPDATE_DATE                                  AS  Last_Upd_time           --最后更新日期         "
    },
    {
      "line": 126,
      "text": "        ,'${data_src_cd}'                               AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 127,
      "text": "        ,'${filename}'                                  AS  Task_Name               --任务名"
    },
    {
      "line": 128,
      "text": "        ,'${data_day_str}'                              AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 129,
      "text": "        ,'${data_day_str}'                              AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 130,
      "text": "        ,'${data_today}'                                AS  Data_Time               --数据时间"
    },
    {
      "line": 131,
      "text": "        ,'${src_table}'                                 AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 132,
      "text": "   FROM (SELECT *  FROM ${src_table} WHERE  Busi_Date='${data_day_str}' AND DEL_FLAG='N')A"
    },
    {
      "line": 133,
      "text": "   LEFT JOIN(SELECT *  FROM ODATA_N_GLM.P_SYS_USER  WHERE  Busi_Date='${data_day_str}' )B"
    },
    {
      "line": 134,
      "text": "          ON A.OWNER_USER_ID=B.USER_ID"
    },
    {
      "line": 135,
      "text": "   LEFT JOIN (SELECT DISTINCT ERP_ID,LOGIN_ID FROM ODATA_N_IOA.I_GF_USER WHERE BUSI_DATE='${data_day_str}'"
    },
    {
      "line": 136,
      "text": "                        AND MAIN_DEPARTMENT = 'true' AND ERP_ID IS NOT NULL"
    },
    {
      "line": 137,
      "text": "              UNION ALL"
    },
    {
      "line": 138,
      "text": "              SELECT DISTINCT ERP_ID,LOGIN_ID FROM ODATA_N_IOA.I_GF_USER_DEL WHERE BUSI_DATE='${data_day_str}'"
    },
    {
      "line": 139,
      "text": "                       AND MAIN_DEPARTMENT = 'true' AND ERP_ID IS NOT NULL) C"
    },
    {
      "line": 140,
      "text": "   ON lower(B.USER_NAME)= C.LOGIN_ID"
    },
    {
      "line": 141,
      "text": "   LEFT JOIN ("
    },
    {
      "line": 142,
      "text": "            SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 143,
      "text": "             FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 144,
      "text": "             WHERE TGT_TAB_NAME = 'T03_AGT'"
    },
    {
      "line": 145,
      "text": "                AND TGT_TAB_FLD  = 'Agt_Stat_Cd'"
    },
    {
      "line": 146,
      "text": "                AND SRC_TAB_NAME = 'CON_CONTRACT_HD'"
    },
    {
      "line": 147,
      "text": "                AND SRC_FLD_NAME = 'CONTRACT_STATUS'"
    },
    {
      "line": 148,
      "text": "                AND SRC_SYS_NAME='GLM')A1"
    },
    {
      "line": 149,
      "text": "         ON      A.CONTRACT_STATUS =A1.SRC_CD_VAL                  --CONTRACT_STATUS 转码"
    },
    {
      "line": 150,
      "text": "   LEFT JOIN ("
    },
    {
      "line": 151,
      "text": "            SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 152,
      "text": "              FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 153,
      "text": "            WHERE TGT_TAB_NAME = 'T03_AGT_STAT_H'"
    },
    {
      "line": 154,
      "text": "               AND TGT_TAB_FLD  = 'Agt_Stat_Cd'"
    },
    {
      "line": 155,
      "text": "               AND SRC_TAB_NAME = 'CON_CONTRACT_HD'"
    },
    {
      "line": 156,
      "text": "               AND SRC_FLD_NAME = 'WB_STATUS'"
    },
    {
      "line": 157,
      "text": "               AND SRC_SYS_NAME='GLM')A2"
    },
    {
      "line": 158,
      "text": "      ON      A.WB_STATUS =A2.SRC_CD_VAL                  --WB_STATUS 转码"
    },
    {
      "line": 159,
      "text": "   LEFT JOIN ("
    },
    {
      "line": 160,
      "text": "            SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 161,
      "text": "              FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 162,
      "text": "            WHERE TGT_TAB_NAME = 'T03_AGT_STAT_H'"
    },
    {
      "line": 163,
      "text": "               AND TGT_TAB_FLD  = 'Agt_Stat_Cd'"
    },
    {
      "line": 164,
      "text": "               AND SRC_TAB_NAME = 'CON_CONTRACT_HD'"
    },
    {
      "line": 165,
      "text": "               AND SRC_FLD_NAME = 'MQ_STATUS'"
    },
    {
      "line": 166,
      "text": "               AND SRC_SYS_NAME='GLM')A3"
    },
    {
      "line": 167,
      "text": "      ON      A.MQ_STATUS =A3.SRC_CD_VAL                  --MQ_STATUS 转码"
    },
    {
      "line": 168,
      "text": "   ;"
    },
    {
      "line": 169,
      "text": ""
