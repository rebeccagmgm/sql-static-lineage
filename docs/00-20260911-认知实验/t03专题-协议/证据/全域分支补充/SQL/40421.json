      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 36,
      "text": "--Group1: Source Table:[ODATA_N_STA.S_TACCOINFO:基金账户表]"
    },
    {
      "line": 37,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 38,
      "text": "DROP TABLE IF EXISTS TEMP.T03_AMS_FND_ACCT_TEMP_STA002;"
    },
    {
      "line": 39,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_AMS_FND_ACCT_TEMP_STA002"
    },
    {
      "line": 40,
      "text": "AS"
    },
    {
      "line": 41,
      "text": "SELECT"
    },
    {
      "line": 42,
      "text": "        C_FUNDACCO                              AS Agt_Id1                                  --协议编号"
    },
    {
      "line": 43,
      "text": "       ,'10105'                                 AS Agt_Modifr1                              --协议修饰符"
    },
    {
      "line": 44,
      "text": "       ,CONCAT('STA001-',C_CUSTNO)              AS Agt_Holder1                              --协议持有人编号"
    },
    {
      "line": 45,
      "text": "       ,'101'                                   AS Agt_Cate_Cd1                             --协议类别代码"
    },
    {
      "line": 46,
      "text": "       ,'10105'                                 AS Agt_Type_Cd1                             --协议类型代码"
    },
    {
      "line": 47,
      "text": "       ,NVL(C.DW_CD_VAL,C_ACCOSTATUS)           AS Agt_Stat_Cd1                             --协议状态代码"
    },
    {
      "line": 48,
      "text": "       ,C_AGENCYNO                              AS Sler_Id1                                 --销售商编号"
    },
    {
      "line": 49,
      "text": "       ,C_CHILDNETNO                            AS Oper_Net_No1                             --操作网点编号"
    },
    {
      "line": 50,
      "text": "       ,C_FREEZECAUSE                           AS Acct_Frz_Rsn_Cd1                         --账户冻结原因代码"
    },
    {
      "line": 51,
      "text": "       ,''                                      AS Src_Prd_Id1                              --源产品编号"
    },
    {
      "line": 52,
      "text": "       ,''                                      AS Clr_Bat_No1                              --清算批次号"
    },
    {
      "line": 53,
      "text": "       ,C_BOURSEFLAG                            AS Exch_Shr_Clas_Cd1                        --交易所份额分类代码"
    },
    {
      "line": 54,
      "text": "       ,'STA'                                   AS Data_Src_Cd1                             --数据来源代码"
    },
    {
      "line": 55,
      "text": "       ,'ODATA_N_STA.S_TACCOINFO'               AS Src_Tbl1                                 --源表"
    },
    {
      "line": 56,
      "text": "       ,UPPER('${filename}')               AS Task_Name1                               --任务名"
    },
    {
      "line": 57,
      "text": "       ,'${data_day_str}'                  AS Data_Etl_Date1                           --数据加载日期"
    },
    {
      "line": 58,
      "text": "       ,'${data_day_str}'                  AS Data_Upt_Date1                           --数据更新日期"
    },
    {
      "line": 59,
      "text": "       ,''                                      AS Tnt_Id1                                   --租户号"
    },
    {
      "line": 60,
      "text": "       ,''                                      AS Ta_No1                                   --TA编号"
    },
    {
      "line": 61,
      "text": "FROM  (SELECT * FROM ODATA_N_STA.S_TACCOINFO WHERE BUSI_DATE='${data_day_str}')A"
    },
    {
      "line": 62,
      "text": ""
    },
    {
      "line": 63,
      "text": "LEFT JOIN ("
    },
    {
      "line": 64,
      "text": "          SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 65,
      "text": "          FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 66,
      "text": "          WHERE TGT_TAB_NAME = 'T03_AMS_FND_ACCT'"
    },
    {
      "line": 67,
      "text": "            AND TGT_TAB_FLD  = 'Agt_Stat_Cd'"
    },
    {
      "line": 68,
      "text": "            AND SRC_TAB_NAME = 'TACCOINFO'"
    },
    {
      "line": 69,
      "text": "            AND SRC_FLD_NAME = 'C_ACCOSTATUS'"
    },
    {
      "line": 70,
      "text": "            AND SRC_SYS_NAME='STA') C"
    },
    {
      "line": 71,
      "text": "ON        A.C_ACCOSTATUS = C.SRC_CD_VAL                  --C_ACCOSTATUS转码"
    },
    {
      "line": 72,
      "text": ""
    },
    {
      "line": 73,
      "text": ";"
    },
    {
      "line": 74,
      "text": ""
    },
    {
      "line": 75,
      "text": "DROP TABLE IF EXISTS TEMP.T03_AMS_FND_ACCT_MID_STA002;"
    },
    {
      "line": 76,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_AMS_FND_ACCT_MID_STA002"
    },
    {
      "line": 77,
      "text": "AS"
    },
    {
      "line": 78,
      "text": "SELECT"
    },
    {
      "line": 79,
      "text": "       A.*"
    },
    {
      "line": 80,
      "text": "      ,B.*"
    },
    {
      "line": 81,
      "text": "      ,CASE WHEN A.AGT_ID IS NULL AND B.AGT_ID1 IS NOT NULL THEN 'I' --新增"
    },
    {
      "line": 82,
      "text": "            WHEN A.AGT_ID IS NOT NULL AND B.AGT_ID1 IS NULL THEN 'D' --删除"
    },
    {
      "line": 83,
      "text": "            WHEN A.AGT_ID IS NOT NULL AND B.AGT_ID1 IS NOT NULL AND ("
    },
    {
      "line": 84,
      "text": "                COALESCE(A.Agt_Holder        ,'')   <> COALESCE(B.Agt_Holder1        ,'')"
    },
    {
      "line": 85,
      "text": "             OR COALESCE(A.Agt_Cate_Cd       ,'')   <> COALESCE(B.Agt_Cate_Cd1       ,'')"
    },
    {
      "line": 86,
      "text": "             OR COALESCE(A.Agt_Type_Cd       ,'')   <> COALESCE(B.Agt_Type_Cd1       ,'')"
    },
    {
      "line": 87,
      "text": "             OR COALESCE(A.Agt_Stat_Cd       ,'')   <> COALESCE(B.Agt_Stat_Cd1       ,'')"
    },
    {
      "line": 88,
      "text": "             OR COALESCE(A.Sler_Id           ,'')   <> COALESCE(B.Sler_Id1           ,'')"
    },
    {
      "line": 89,
      "text": "             OR COALESCE(A.Oper_Net_No       ,'')   <> COALESCE(B.Oper_Net_No1       ,'')"
    },
    {
      "line": 90,
      "text": "             OR COALESCE(A.Acct_Frz_Rsn_Cd   ,'')   <> COALESCE(B.Acct_Frz_Rsn_Cd1   ,'')"
    },
    {
      "line": 91,
      "text": "             OR COALESCE(A.Src_Prd_Id        ,'')   <> COALESCE(B.Src_Prd_Id1        ,'')"
    },
    {
      "line": 92,
      "text": "             OR COALESCE(A.Clr_Bat_No        ,'')   <> COALESCE(B.Clr_Bat_No1        ,'')"
    },
    {
      "line": 93,
      "text": "             OR COALESCE(A.Exch_Shr_Clas_Cd  ,'')   <> COALESCE(B.Exch_Shr_Clas_Cd1  ,'')"
    },
    {
      "line": 94,
      "text": "             OR COALESCE(A.Tnt_Id            ,'')   <> COALESCE(B.Tnt_Id1            ,'')"
    },
    {
      "line": 95,
      "text": "             OR COALESCE(A.Ta_No             ,'')   <> COALESCE(B.Ta_No1             ,'')"
    },
    {
      "line": 96,
      "text": "             )"
    },
    {
      "line": 97,
      "text": "            THEN     'U' --变更"
    },
    {
      "line": 98,
      "text": "            ELSE     'S' --无变更"
    },
    {
      "line": 99,
      "text": "            END AS DATA_TYPE"
    },
    {
      "line": 100,
      "text": "FROM  (SELECT * FROM T03_AMS_FND_ACCT"
    },
    {
      "line": 101,
      "text": "        WHERE SRC_TBL ='ODATA_N_STA.S_TACCOINFO'   --只对比ODATA_N_STA.S_TACCOINFO表的数据"
    },
    {
      "line": 102,
      "text": "          AND BUSI_DATE=default.pretradedate('${data_day_str}',1)"
    },
    {
      "line": 103,
      "text": "      )A"
    },
    {
      "line": 104,
      "text": "FULL OUTER JOIN TEMP.T03_AMS_FND_ACCT_TEMP_STA002 B"
    },
    {
      "line": 105,
      "text": "ON    A.AGT_ID=B.AGT_ID1"
    },
    {
      "line": 106,
      "text": "AND   A.AGT_MODIFR=B.AGT_MODIFR1"
    },
    {
      "line": 107,
      "text": ";"
    },
    {
