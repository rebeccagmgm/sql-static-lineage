    {
      "line": 147,
      "text": "        ,A.BASE_RATE                             AS  Bm_Rate                 --基准利率          "
    },
    {
      "line": 148,
      "text": "        ,A.INT_RATE                              AS  Leas_Rate               --租赁利率          "
    },
    {
      "line": 149,
      "text": "        ,NVL(A2.DW_CD_VAL,A.INT_RATE_TYPE)       AS  Rate_Type_Cd            --利率类型代码      "
    },
    {
      "line": 150,
      "text": "        ,A.INT_RATE_PRECISION                    AS  Intrt_Precision         --利率精度          "
