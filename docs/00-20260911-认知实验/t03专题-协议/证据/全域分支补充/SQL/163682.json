    },
    {
      "line": 94,
      "text": "    SELECT"
    },
    {
      "line": 95,
      "text": "         A.CONTRACT_ID                           AS  Det_Id                  --明细编号          "
    },
    {
      "line": 96,
      "text": "        ,A.PARENT_CON_ID                         AS  Agt_Id                  --协议编号          "
    },
    {
      "line": 97,
      "text": "        ,IF(NVL(TRIM(A.PARENT_CON_ID),'')='','','20408')"
    },
    {
      "line": 98,
      "text": "                                                 AS  Agt_Modifr              --协议修饰符        "
    },
    {
      "line": 99,
      "text": "        ,A.CONTRACT_HD_NUMBER                    AS  Contr_No                --合同编号          "
    },
    {
      "line": 100,
      "text": "        ,A.CONTRACT_NUMBER                       AS  Loan_Bat_No             --放款批次号        "
    },
    {
      "line": 101,
      "text": "        ,A.CONTRACT_NAME                         AS  Contr_Name              --合同名称          "
    },
    {
      "line": 102,
      "text": "        ,A.BUSINESS_TYPE                         AS  Leas_Busi_Type_Cd       --租赁业务类型代码  "
    },
    {
      "line": 103,
      "text": "        ,IF(NVL(TRIM(A.PROJECT_ID),'')='','',CONCAT('GLM012-',A.PROJECT_ID))"
    },
    {
      "line": 104,
      "text": "                                                 AS  Proj_Id                 --项目编号          "
    },
    {
      "line": 105,
      "text": "        ,IF(NVL(TRIM(A.BP_ID_TENANT),'')='','',CONCAT('GLM003-',A.BP_ID_TENANT))"
    },
    {
      "line": 106,
      "text": "                                                 AS  Pty_Id                  --当事人编号        "
    },
    {
      "line": 107,
      "text": "        ,A.OWNER_USER_ID                         AS  Prin_User_Id            --负责人用户编号    "
    },
    {
      "line": 108,
      "text": "        ,NVL(D.ERP_ID,A.OWNER_USER_ID)           AS  Prin_Emp_Id             --负责人员工编号    "
    },
    {
      "line": 109,
      "text": "        ,IF(NVL(TRIM(A.UNIT_ID),'')='','',CONCAT('GLM006-',A.UNIT_ID))"
    },
    {
      "line": 110,
      "text": "                                                 AS  Inr_Org_Id              --内部机构编号      "
    },
    {
      "line": 111,
      "text": "        ,NVL(A1.DW_CD_VAL,A.CONTRACT_STATUS)     AS  Contr_Loan_Stat_Cd      --合同放款状态代码  "
    },
    {
      "line": 112,
      "text": "        ,A.PRICE_LIST                            AS  Pric_List               --价目表            "
    },
    {
      "line": 113,
      "text": "        ,A.CDD_LIST_ID                           AS  Dd_List_Id              --尽职调查清单Id    "
    },
    {
      "line": 114,
      "text": "        ,SUBSTR(A.INCEPTION_OF_LEASE,1,10)       AS  Actl_Lease_Strt_Date    --实际租赁开始日期  "
    },
    {
      "line": 115,
      "text": "        ,SUBSTR(A.LEASE_START_DATE  ,1,10)       AS  Leas_Pd_Strt_Date       --租赁期开始日期    "
    },
    {
      "line": 116,
