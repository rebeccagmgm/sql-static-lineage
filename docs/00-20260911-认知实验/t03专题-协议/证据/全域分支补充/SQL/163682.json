      "text": "        ,A.INT_RATE_FIXING_WAY                   AS  Intrt_Adj_Method_Cd     --利率调整方式代码  "
    },
    {
      "line": 145,
      "text": "        ,A.INT_RATE_FIXING_RANGE                 AS  Intrt_Fix_Range         --利率幅度          "
    },
    {
      "line": 146,
      "text": "        ,A.BASE_RATE_TYPE                        AS  Bm_Rate_Cate_Cd         --基准利率类别代码  "
