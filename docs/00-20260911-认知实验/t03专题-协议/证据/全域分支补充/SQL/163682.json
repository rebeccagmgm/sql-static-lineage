      "text": "        ,B.PENALTY                               AS  Ovdu_Fine_Intr          --逾期罚息          "
    },
    {
      "line": 159,
      "text": "        ,CASE WHEN B.OVERDUE_STATUS = 'Y' THEN '1'"
