    {
      "line": 153,
      "text": "        ,A.GRACE_PERIOD                          AS  Free_Intr_Days          --免息天数          "
    },
    {
      "line": 154,
      "text": "        ,A.PENALTY_RATE                          AS  Ovdu_Fine_Rate          --逾期罚金率        "
    },
    {
      "line": 155,
      "text": "        ,B.OVERDUE_TIMES                         AS  Ovdu_Pd_Num             --逾期期数          "
