    {
      "line": 178,
      "text": "        ,'${data_day_str}'                  AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 179,
      "text": "        ,'${data_day_str}'                  AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 180,
      "text": "        ,'${data_today}'                    AS  Data_Time               --数据时间"
    },
    {
      "line": 181,
      "text": "        ,'${src_table}'                     AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 182,
      "text": "    FROM   (SELECT *  FROM ${src_table} WHERE  BUSI_DATE='${data_day_str}' AND DEL_FLAG='N')A"
    },
    {
      "line": 183,
      "text": "    LEFT JOIN (SELECT *  FROM ODATA_N_GLM.P_CON_CONTRACT_RPT_NOW WHERE  BUSI_DATE='${data_day_str}' )B"
    },
    {
      "line": 184,
      "text": "           ON A.CONTRACT_ID =B.CONTRACT_ID"
    },
    {
      "line": 185,
      "text": "    LEFT JOIN(SELECT *  FROM ODATA_N_GLM.P_SYS_USER  WHERE  Busi_Date='${data_day_str}' )C"
    },
    {
      "line": 186,
      "text": "           ON A.OWNER_USER_ID=C.USER_ID"
    },
    {
      "line": 187,
      "text": "    LEFT JOIN (SELECT DISTINCT ERP_ID,LOGIN_ID FROM ODATA_N_IOA.I_GF_USER WHERE BUSI_DATE='${data_day_str}'"
    },
    {
      "line": 188,
      "text": "                         AND MAIN_DEPARTMENT = 'true' AND ERP_ID IS NOT NULL"
    },
    {
      "line": 189,
      "text": "               UNION ALL"
    },
    {
      "line": 190,
      "text": "               SELECT DISTINCT ERP_ID,LOGIN_ID FROM ODATA_N_IOA.I_GF_USER_DEL WHERE BUSI_DATE='${data_day_str}'"
    },
    {
      "line": 191,
      "text": "                        AND MAIN_DEPARTMENT = 'true' AND ERP_ID IS NOT NULL) D"
    },
    {
      "line": 192,
      "text": "    ON lower(C.USER_NAME)= D.LOGIN_ID"
    },
    {
      "line": 193,
      "text": "    LEFT JOIN ("
    },
    {
      "line": 194,
      "text": "             SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 195,
      "text": "               FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 196,
      "text": "             WHERE TGT_TAB_NAME = 'T03_FIN_LEAS_COMP_LOAN_DET'"
    },
    {
      "line": 197,
      "text": "                AND TGT_TAB_FLD  = 'Contr_Loan_Stat_Cd'"
    },
    {
      "line": 198,
      "text": "                AND SRC_TAB_NAME = 'CON_CONTRACT'"
    },
    {
      "line": 199,
      "text": "                AND SRC_FLD_NAME = 'CONTRACT_STATUS'"
    },
    {
      "line": 200,
      "text": "                AND SRC_SYS_NAME='GLM')A1"
    },
    {
      "line": 201,
      "text": "       ON      A.CONTRACT_STATUS =A1.SRC_CD_VAL                  --CONTRACT_STATUS 转码"
    },
    {
      "line": 202,
      "text": "    LEFT JOIN ("
    },
    {
      "line": 203,
      "text": "             SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 204,
      "text": "               FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 205,
      "text": "             WHERE TGT_TAB_NAME = 'T03_FIN_LEAS_COMP_LOAN_DET'"
    },
    {
      "line": 206,
      "text": "                AND TGT_TAB_FLD  = 'Rate_Type_Cd'"
    },
    {
      "line": 207,
      "text": "                AND SRC_TAB_NAME = 'CON_CONTRACT'"
    },
    {
      "line": 208,
      "text": "                AND SRC_FLD_NAME = 'INT_RATE_TYPE'"
    },
    {
      "line": 209,
      "text": "                AND SRC_SYS_NAME='GLM')A2"
    },
    {
      "line": 210,
      "text": "       ON      A.INT_RATE_TYPE =A2.SRC_CD_VAL                  --INT_RATE_TYPE 转码"
    },
    {
      "line": 211,
      "text": "    ;"
    },
    {
      "line": 212,
      "text": ""
    }
  ]
}
