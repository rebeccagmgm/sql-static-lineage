      "line": 49,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_FND_SAV_AGT_TEMP_FMS006 AS SELECT PK_HTZB AS Agt_Id --协议编码 ,'20112' AS Agt_Modifr --协议修饰符 ,HTCODE AS Contr_No --合同编号 ,VBILLNO AS Sys_Doc_No --系统单据号 ,PK_BUSITYPE AS Src_Busi_Type_Id --源业务类型编码 ,ZCFZ AS Fms_Ast_Liab_Cd --源资产负债代码 ,CASE WHEN A.PK_CURRTYPE = '00010000000000000001' THEN 'CNY' WHEN A.PK_CURRTYPE = '00010000000000000002' THEN 'USD' WHEN A.PK_CURRTYPE = '0001A11000000000BFAE' THEN 'HKD' ELSE A.PK_CURRTYPE END AS Crrc_Cd --币种代码 ,PK_CURRTYPE AS Src_Crrc_Cd --源币种代码 ,HTJE AS Contr_Amt --发行规模 ("
    },
    {
      "line": 50,
      "text": "  合同金额"
    },
    {
      "line": 51,
      "text": ")"
    },
    {
      "line": 52,
      "text": ",CASE WHEN A.ISZFLAG = 'Y' THEN '1' WHEN A.ISZFLAG = 'N' THEN '0' ELSE A.ISZFLAG END AS Has_Chld_Contr_Flag --有子合同标志 ,CASE WHEN A.ISYDYP = 'Y' THEN '1' WHEN A.ISYDYP = 'N' THEN '0' ELSE A.ISYDYP END AS Has_Guar_Flag --有担保标志 ,RATEJSTS AS Intrt_Calc_Days --利率计算天数 ,HTQSRQ AS Contr_Begn_Date --合同起始日期 ,HTYDDQSJ AS Contr_Maty_Date --合同到期日期 ,HTZZSJ AS Contr_Trmt_Date --合同终止日期 ,JGHYDQR AS Opt_Emb_Maty_Date --含权到期日 ,QSSX AS Clr_Spd --清算速度 ,NVL(B.DW_CD_VAL,QSRL) AS Exch_Type_Cd --市场代码 ,QSRL AS Src_Exch_Type_Cd --源市场编码 ,'' AS Prd_Id --产品编号 ,ZZPZ AS Bond_Cd --债券代码 ,JXPL AS Inta_Freq --计息频率 ,NVL(C.DW_CD_VAL,JXPLDW) AS Inta_Freq_Cd --计息频率代码 ,FXR AS Itpy_Day --付息日 ,JXFS AS Src_Inta_Way_Cd --源计息方法代码 ,RATE AS Year_Intrt --年利率 ,MEMO AS Remark --备注 ,'FMS' AS Data_Src_Cd --数据来源代码 ,'ODATA_N_FMS.K_HTGL_HTZB' AS Src_Tbl --源表 ,'PDATA_N.T03_FND_SAV_AGT_FMS006' AS Task_Name --任务名 ,'2026-05-21' AS Data_Etl_Date --数据加载日期 ,'2026-05-21' AS Data_Upt_Date --数据更新日期 FROM (SELECT *FROM ODATA_N_FMS.K_HTGL_HTZB WHERE dr!=1) A LEFT JOIN ( SELECT SRC_CD_VAL,DW_CD_VAL FROM PDATA_N.REF_CD_CVT_MAP WHERE TGT_TAB_NAME = 'T03_FND_SAV_AGT' AND TGT_TAB_FLD = 'Exch_Type_Cd' AND SRC_TAB_NAME = 'HTGL_HTZB' AND TRIM(SRC_FLD_NAME) = 'QSRL' AND SRC_SYS_NAME='FMS')B ON A.QSRL =B.SRC_CD_VAL --QSRL 转码 LEFT JOIN ( SELECT SRC_CD_VAL,DW_CD_VAL FROM PDATA_N.REF_CD_CVT_MAP WHERE TGT_TAB_NAME = 'T03_FND_SAV_AGT' AND TGT_TAB_FLD = 'Inta_Freq_Cd' AND SRC_TAB_NAME = 'HTGL_HTZB' AND TRIM(SRC_FLD_NAME) = 'JXPLDW' AND SRC_SYS_NAME='FMS')C ON A.JXPLDW =C.SRC_CD_VAL --JXPLDW 转码 ;"
    },
    {
      "line": 53,
      "text": ""
    },
    {
      "line": 54,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_FND_SAV_AGT_MID_FMS006 AS SELECT A.* ,B.Agt_Id AS Agt_Id1 --协议编码 ,B.Agt_Modifr AS Agt_Modifr1 --协议修饰符 ,B.Contr_No AS Contr_No1 --合同编号 ,B.Sys_Doc_No AS Sys_Doc_No1 --系统单据号 ,B.Src_Busi_Type_Id AS Src_Busi_Type_Id1 --源业务类型编码 ,B.Fms_Ast_Liab_Cd AS Fms_Ast_Liab_Cd1 --源资产负债代码 ,B.Crrc_Cd AS Crrc_Cd1 --币种代码 ,B.Src_Crrc_Cd AS Src_Crrc_Cd1 --源币种代码 ,B.Contr_Amt AS Contr_Amt1 --发行规模 ("
    },
    {
      "line": 55,
      "text": "  合同金额"
    },
    {
      "line": 56,
      "text": ")"
    },
    {
      "line": 57,
      "text": ",B.Has_Chld_Contr_Flag AS Has_Chld_Contr_Flag1 --有子合同标志 ,B.Has_Guar_Flag AS Has_Guar_Flag1 --有担保标志 ,B.Intrt_Calc_Days AS Intrt_Calc_Days1 --利率计算天数 ,B.Contr_Begn_Date AS Contr_Begn_Date1 --合同起始日期 ,B.Contr_Maty_Date AS Contr_Maty_Date1 --合同到期日期 ,B.Contr_Trmt_Date AS Contr_Trmt_Date1 --合同终止日期 ,B.Opt_Emb_Maty_Date AS Opt_Emb_Maty_Date1 --含权到期日 ,B.Clr_Spd AS Clr_Spd1 --清算速度 ,B.Exch_Type_Cd AS Exch_Type_Cd1 --市场代码 ,B.Src_Exch_Type_Cd AS Src_Exch_Type_Cd1 --源市场编码 ,B.Prd_Id AS Prd_Id1 --产品编号 ,B.Bond_Cd AS Bond_Cd1 --债券代码 ,B.Inta_Freq AS Inta_Freq1 --计息频率 ,B.Inta_Freq_Cd AS Inta_Freq_Cd1 --计息频率代码 ,B.Itpy_Day AS Itpy_Day1 --付息日 ,B.Src_Inta_Way_Cd AS Src_Inta_Way_Cd1 --源计息方法代码 ,B.Year_Intrt AS Year_Intrt1 --年利率 ,B.Remark AS Remark1 --备注 ,B.DATA_SRC_CD AS DATA_SRC_CD1 --数据来源代码 ,B.SRC_TBL AS SRC_TBL1 --源表 ,B.TASK_NAME AS TASK_NAME1 --任务名 ,B.DATA_ETL_DATE AS DATA_ETL_DATE1 --数据加载日期 ,B.DATA_UPT_DATE AS DATA_UPT_DATE1 --数据更新日期 ,CASE WHEN A.Agt_Id IS NULL AND B.Agt_Id IS NOT NULL THEN 'I' --新增 WHEN A.Agt_Id IS NOT NULL AND B.Agt_Id IS NULL THEN 'D' --删除 WHEN A.Agt_Id IS NOT NULL AND B.Agt_Id IS NOT NULL AND ( COALESCE(A.Agt_Modifr ,'') <> COALESCE(B.Agt_Modifr ,'') OR COALESCE(A.Contr_No ,'') <> COALESCE(B.Contr_No ,'') OR COALESCE(A.Sys_Doc_No ,'') <> COALESCE(B.Sys_Doc_No ,'') OR COALESCE(A.Src_Busi_Type_Id ,'') <> COALESCE(B.Src_Busi_Type_Id ,'') OR COALESCE(A.Fms_Ast_Liab_Cd ,'') <> COALESCE(B.Fms_Ast_Liab_Cd ,'') OR COALESCE(A.Crrc_Cd ,'') <> COALESCE(B.Crrc_Cd ,'') OR COALESCE(A.Src_Crrc_Cd ,'') <> COALESCE(B.Src_Crrc_Cd ,'') OR COALESCE(A.Contr_Amt ,'') <> COALESCE(B.Contr_Amt ,'') OR COALESCE(A.Has_Chld_Contr_Flag ,'') <> COALESCE(B.Has_Chld_Contr_Flag ,'') OR COALESCE(A.Has_Guar_Flag ,'') <> COALESCE(B.Has_Guar_Flag ,'') OR COALESCE(A.Intrt_Calc_Days ,'') <> COALESCE(B.Intrt_Calc_Days ,'') OR COALESCE(A.Contr_Begn_Date ,'') <> COALESCE(B.Contr_Begn_Date ,'') OR COALESCE(A.Contr_Maty_Date ,'') <> COALESCE(B.Contr_Maty_Date ,'') OR COALESCE(A.Contr_Trmt_Date ,'') <> COALESCE(B.Contr_Trmt_Date ,'') OR COALESCE(A.Opt_Emb_Maty_Date ,'') <> COALESCE(B.Opt_Emb_Maty_Date ,'') OR COALESCE(A.Clr_Spd ,'') <> COALESCE(B.Clr_Spd ,'') OR COALESCE(A.Exch_Type_Cd ,'') <> COALESCE(B.Exch_Type_Cd ,'') OR COALESCE(A.Src_Exch_Type_Cd ,'') <> COALESCE(B.Src_Exch_Type_Cd ,'') OR COALESCE(A.Prd_Id ,'') <> COALESCE(B.Prd_Id ,'') OR COALESCE(A.Bond_Cd ,'') <> COALESCE(B.Bond_Cd ,'') OR COALESCE(A.Inta_Freq ,'') <> COALESCE(B.Inta_Freq ,'') OR COALESCE(A.Inta_Freq_Cd ,'') <> COALESCE(B.Inta_Freq_Cd ,'') OR COALESCE(A.Itpy_Day ,'') <> COALESCE(B.Itpy_Day ,'') OR COALESCE(A.Src_Inta_Way_Cd ,'') <> COALESCE(B.Src_Inta_Way_Cd ,'') OR COALESCE(A.Year_Intrt ,'') <> COALESCE(B.Year_Intrt ,'') OR COALESCE(A.Remark ,'') <> COALESCE(B.Remark ,'') ) THEN 'U' --变更 ELSE 'S' --无变更 END AS DATA_TYPE --数据类型 FROM (SELECT * FROM T03_FND_SAV_AGT WHERE SRC_TBL='ODATA_N_FMS.K_HTGL_HTZB')A FULL OUTER JOIN TEMP.T03_FND_SAV_AGT_TEMP_FMS006 B ON A.Agt_Id=B.Agt_Id ;"
    },
