    {
      "line": 48,
      "text": "--Group1: Source Table:[ODATA_N_ZSO.H_T_CSDC_RAW_SQ_HYCC_HISTORY:历史衍生品合约持仓库]"
    },
    {
      "line": 49,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 50,
      "text": "SELECT"
    },
    {
      "line": 51,
      "text": "       ZQZH                                            AS SCR_ACCT_AGT_ID     --证券账户协议编号"
    },
    {
      "line": 52,
      "text": "      ,IF(NVL(TRIM(ZQZH),'')!='','10109-2','')         AS SCR_ACCT_AGT_MODIFR --证券账户协议修饰符"
    },
    {
      "line": 53,
      "text": "      ,HYBM                                            AS PRD_ID              --产品编号"
    },
    {
      "line": 54,
      "text": "      ,CASE WHEN CCFX='L' THEN 'LONG'"
    },
    {
      "line": 55,
      "text": "            WHEN CCFX='S' THEN 'SHOR'   "
    },
    {
      "line": 56,
      "text": "            ELSE ''"
    },
    {
      "line": 57,
      "text": "        END                                           AS LONG_SHOR_CLAS      --多空分类"
    },
    {
      "line": 58,
      "text": "      ,CASE WHEN CCFX='L' THEN 'OPT_HOLD'"
    },
    {
      "line": 59,
      "text": "            WHEN CCFX='S' THEN 'OPT_OBLI' "
    },
    {
      "line": 60,
      "text": "            ELSE ''"
    },
    {
      "line": 61,
      "text": "        END                                            AS HOLD_TYPE_CD        --持仓类型代码"
    },
    {
      "line": 62,
      "text": "      ,ZHBS                                            AS COMP_ACCT           --合约账户"
    },
    {
      "line": 63,
      "text": "      ,'SZSE'                                          AS EXCH_TYPE_CD        --市场代码"
    },
    {
      "line": 64,
      "text": "      ,SCDM                                            AS SRC_EXCH_TYPE_CD    --源市场代码"
    },
    {
      "line": 65,
      "text": "      ,HYBM                                            AS COMP_ID             --合约编码"
    },
    {
      "line": 66,
      "text": "      ,JSZH                                            AS SETT_ACCT           --结算账号"
    },
    {
      "line": 67,
      "text": "      ,JYDY                                            AS TRD_UNIT            --交易单元"
    },
    {
      "line": 68,
      "text": "      ,BDBZ                                            AS COVD_TYPE_CD        --备兑类型代码"
    },
    {
      "line": 69,
      "text": "      ,CCSL                                            AS CURR_VOL            --当前份额"
    },
    {
      "line": 70,
      "text": "      ,WCBZJ                                           AS KEEP_MARG           --维持保证金"
    },
    {
      "line": 71,
      "text": "      ,BYJE                                            AS RSRV_AMT            --备用金额"
    },
    {
      "line": 72,
      "text": "      ,BYSL                                            AS RSRV_NUM            --备用数量"
    },
    {
      "line": 73,
      "text": "      ,BYZF                                            AS RSRV_CHAR           --备用字符"
    },
    {
      "line": 74,
      "text": "      ,'${data_src_cd}'                           AS DATA_SRC_CD         --数据来源代码"
    },
    {
      "line": 75,
      "text": "      ,UPPER('${filename}')                       AS TASK_NAME           --任务名"
    },
    {
      "line": 76,
      "text": "      ,'${data_day_str}'                          AS DATA_ETL_DATE       --数据加载日期"
    },
    {
      "line": 77,
      "text": "      ,'${data_today_str}'                        AS DATA_UPT_DATE       --数据更新日期"
    },
    {
      "line": 78,
      "text": "      ,'${data_today}'                            AS DATA_TIME           --数据时间"
    },
    {
      "line": 79,
      "text": "      ,'${src_table}'                             AS Real_Src_Tbl        --真实源表"
    },
    {
      "line": 80,
      "text": "      ,ID                                              AS Src_Id              --源Id"
    },
    {
      "line": 81,
      "text": "      ,''                                              AS Clr_No              --清算编号"
    },
    {
      "line": 82,
      "text": "      ,''                                              AS Opt_Sub_Acct        --期权子账户"
    },
    {
      "line": 83,
      "text": "      ,CCSL                                            AS Opt_Comp_Hold_Vol   --期权合约持仓数量"
    },
    {
      "line": 84,
      "text": "      ,BYSL                                            AS Prtc_Portfl_Opt_Comp_Hold_Vol--参与组合的期权合约持仓数量"
    },
    {
      "line": 85,
      "text": "      ,''                                              AS Amt1                --金额1"
    },
    {
      "line": 86,
      "text": "      ,''                                              AS Amt2                --金额2"
    },
    {
      "line": 87,
      "text": "      ,ADD_TIME                                        AS Create_Time         --创建时间"
    },
