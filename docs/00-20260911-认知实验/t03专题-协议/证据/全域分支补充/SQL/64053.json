      "line": 34,
      "text": "CREATE TABLE TEMP.T03_SCR_ACCT_CSTD_CHK_INFO_CSS001_TEMP AS SELECT YMTH AS UNIF_ACCT1 --中登一码通账户 ,ZHLB AS SCR_ACCT_CATE_CD1 --中登证券账户类别代码 ,ZQZH AS SCR_ACCT1 --中登证券账户 ,'SSE' AS EXCH_TYPE_CD1 --市场代码 ,NVL ("
    },
    {
      "line": 35,
      "text": "  B.DW_CD_VAL,"
    },
    {
      "line": 36,
      "text": "  ZQZHZT"
    },
    {
      "line": 37,
      "text": ")"
    },
    {
      "line": 38,
      "text": "AS CSDC_SCR_ACCT_STAT_CD1--中登证券账户状态代码 ,JYDY AS TRD_UNIT1 --交易单元 ,QSBH1 AS CLR_NO11 --清算编号1 ,QSBH2 AS CLR_NO21 --清算编号2 ,FZBZ AS ASSIS_FLAG1 --辅助标志 ,KHJGDM AS OACT_AGCY_ID1 --开户代理机构代码 ,TGYWDY AS CSTD_BUSI_UNIT1 --托管业务单元 ,IF(SXRQ='0','',SXRQ) AS ASGN_TRD_EFF_DATE1 --指定交易生效日期 ,'CSS' AS DATA_SRC_CD1 --数据来源代码 ,'ODATA_N_CSS.E_SRC_DBF_HSTGDZ' AS SRC_TBL1 --源表 ,UPPER('PDATA_N.T03_SCR_ACCT_CSTD_CHK_INFO_CSS001') AS TASK_NAME1 --任务名 ,'2026-05-20' AS DATA_ETL_DATE1 --数据加载日期 ,'2026-05-20' AS DATA_UPT_DATE1 --数据更新日期 FROM ODATA_N_CSS.E_SRC_DBF_HSTGDZ A LEFT JOIN ( SELECT SRC_CD_VAL,DW_CD_VAL FROM PDATA_N.REF_CD_CVT_MAP WHERE TGT_TAB_NAME = 'T03_SCR_ACCT_CSTD_CHK_INFO' AND TGT_TAB_FLD = 'Csdc_Scr_Acct_Stat_Cd' AND SRC_TAB_NAME = 'RC_DBF_HSTGDZ' AND SRC_FLD_NAME = 'ZQZHZT' AND SRC_SYS_NAME='CSS') B ON A.ZQZHZT = B.SRC_CD_VAL --ZQZHZT 转码 ;"
    },
    {
      "line": 39,
      "text": ""
    },
    {
      "line": 40,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_SCR_ACCT_CSTD_CHK_INFO_CSS001_MID AS SELECT A.* ,B.* ,CASE WHEN A.UNIF_ACCT IS NULL AND B.UNIF_ACCT1 IS NOT NULL THEN 'I' --新增 WHEN A.UNIF_ACCT IS NOT NULL AND B.UNIF_ACCT1 IS NULL THEN 'D' --删除 WHEN A.UNIF_ACCT IS NOT NULL AND B.UNIF_ACCT1 IS NOT NULL AND ("
    },
    {
      "line": 41,
      "text": "  COALESCE(A.SCR_ACCT_CATE_CD ,'') <> COALESCE(B.SCR_ACCT_CATE_CD1 ,'') OR COALESCE(A.EXCH_TYPE_CD ,'') <> COALESCE(B.EXCH_TYPE_CD1 ,'') OR COALESCE(A.CSDC_SCR_ACCT_STAT_CD,'') <> COALESCE(B.CSDC_SCR_ACCT_STAT_CD1,'') OR COALESCE(A.TRD_UNIT ,'') <> COALESCE(B.TRD_UNIT1 ,'') OR COALESCE(A.CLR_NO1 ,'') <> COALESCE(B.CLR_NO11 ,'') OR COALESCE(A.CLR_NO2 ,'') <> COALESCE(B.CLR_NO21 ,'') OR COALESCE(A.ASSIS_FLAG ,'') <> COALESCE(B.ASSIS_FLAG1 ,'') OR COALESCE(A.OACT_AGCY_ID ,'') <> COALESCE(B.OACT_AGCY_ID1 ,'') OR COALESCE(A.CSTD_BUSI_UNIT ,'') <> COALESCE(B.CSTD_BUSI_UNIT1 ,'') OR COALESCE(A.ASGN_TRD_EFF_DATE ,'') <> COALESCE(B.ASGN_TRD_EFF_DATE1 ,'')"
    },
    {
      "line": 42,
      "text": ")"
    },
    {
      "line": 43,
      "text": "THEN 'U' --变更 ELSE 'S' --无变更 END AS DATA_TYPE FROM (SELECT * FROM T03_SCR_ACCT_CSTD_CHK_INFO WHERE SRC_TBL='ODATA_N_CSS.E_SRC_DBF_HSTGDZ')A --只对比ODATA_N_CSS.E_SRC_DBF_HSTGDZ该表的数据 FULL OUTER JOIN TEMP.T03_SCR_ACCT_CSTD_CHK_INFO_CSS001_TEMP B ON A.UNIF_ACCT=B.UNIF_ACCT1 AND A.SCR_ACCT =B.SCR_ACCT1 ;"
    },
