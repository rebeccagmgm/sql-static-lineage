      "text": "\t\t,CONCAT('10208-',BRANCH_NO)             as Agt_Modifr               --协议修饰符"
    },
    {
      "line": 70,
      "text": "\t\t,'102'                                  as Agt_Cate_Cd              --协议类别代码"
