      "text": "-- querySql"
    },
    {
      "line": 63,
      "text": "INSERT OVERWRITE TABLE T03_FIN_LEAS_COMP_LOAN_DET_CASH_FLOW PARTITION(Src_Tbl='${src_table}',Busi_Date='${data_day_str}')"
    },
    {
      "line": 64,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 65,
      "text": "--Group1: Source Table:[ODATA_N_GLM.P_CON_CONTRACT_CASHFLOW:合同现金流] "
    },
    {
      "line": 66,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 67,
      "text": "SELECT"
    },
    {
      "line": 68,
      "text": "      CONCAT('GLM025-',A.CASHFLOW_ID)                     AS  Cash_Flow_Id            --现金流编号                 "
    },
    {
      "line": 69,
      "text": "     ,A.CONTRACT_ID                                       AS  Det_Id                  --明细编号                   "
    },
    {
      "line": 70,
      "text": "     ,B.PARENT_CON_ID                                     AS  Agt_Id                  --协议编号                   "
    },
    {
      "line": 71,
      "text": "     ,IF(NVL(TRIM(B.PARENT_CON_ID),'')='','','20408')     AS  Agt_Modifr              --协议修饰符                 "
    },
    {
      "line": 72,
      "text": "     ,IF(NVL(TRIM(A.CF_TYPE),'')='','',CONCAT('GLM023-',A.CF_TYPE)) AS  Cash_Flow_Type_Id       --现金流类型编号   "
    },
    {
      "line": 73,
      "text": "     ,IF(NVL(TRIM(A.CF_ITEM),'')='','',CONCAT('GLM024-',A.CF_ITEM)) AS  Cash_Flow_Sub_Type_Id   --现金流子类型编号 "
    },
    {
      "line": 74,
      "text": "     ,A.CF_DIRECTION                                      AS  Cash_Flow_Item_Dir_Cd   --现金流方向代码               "
    },
    {
      "line": 75,
      "text": "     ,A.TIMES                                             AS  Pay_Times               --支付期数                     "
    },
    {
      "line": 76,
      "text": "     ,SUBSTR(A.DUE_DATE        ,1,10)                     AS  Pay_Date                --支付日期                     "
    },
    {
      "line": 77,
      "text": "     ,SUBSTR(A.ACTUAL_CALC_DATE,1,10)                     AS  Actl_Payb_Date          --实际应付日期                 "
    },
    {
      "line": 78,
      "text": "     ,A.DUE_AMOUNT                                        AS  Rcvb_Amt                --应收金额                     "
    },
    {
      "line": 79,
      "text": "     ,A.NET_DUE_AMOUNT                                    AS  Net_Rcvb_Amt            --不含税应收金额               "
    },
    {
      "line": 80,
      "text": "     ,A.VAT_DUE_AMOUNT                                    AS  Vat_Amt                 --增值税额                     "
    },
    {
      "line": 81,
      "text": "     ,A.PRINCIPAL                                         AS  Rcvb_Prin               --应收本金                     "
    },
    {
      "line": 82,
      "text": "     ,A.NET_PRINCIPAL                                     AS  Net_Prin                --不含税本金                   "
    },
    {
      "line": 83,
      "text": "     ,A.VAT_PRINCIPAL                                     AS  Prin_Vat_Amt            --本金增值税额                 "
    },
    {
      "line": 84,
      "text": "     ,A.INTEREST                                          AS  Intr_Rcvb               --应收利息                     "
    },
    {
      "line": 85,
      "text": "     ,A.NET_INTEREST                                      AS  Net_Intr                --不含税利息                   "
    },
    {
      "line": 86,
      "text": "     ,A.VAT_INTEREST                                      AS  Intr_Vat_Amt            --利息增值税额                 "
    },
    {
      "line": 87,
      "text": "     ,A.REMAIN_AMOUNT                                     AS  Curpd_Remn_Rent         --当期剩余租金                 "
    },
    {
      "line": 88,
      "text": "     ,A.REMAIN_PRINCIPAL                                  AS  Curpd_Remn_Prin         --当期剩余本金                 "
    },
    {
      "line": 89,
      "text": "     ,A.REMAIN_INTEREST                                   AS  Curpd_Remn_Intr         --当期剩余利息                 "
    },
    {
      "line": 90,
      "text": "     ,A.GENERATED_SOURCE                                  AS  Cash_Flow_Src_Cd        --现金流来源代码               "
    },
    {
      "line": 91,
      "text": "     ,A.CALC_LINE_ID                                      AS  Calc_Line_ID            --计算行ID                     "
    },
    {
      "line": 92,
      "text": "     ,CASE WHEN A.OVERDUE_STATUS = 'Y' THEN '1'"
    },
    {
      "line": 93,
      "text": "           WHEN A.OVERDUE_STATUS = 'N' THEN '0'"
    },
    {
      "line": 94,
      "text": "           ELSE A.OVERDUE_STATUS END                      AS  Ovdu_Flag               --逾期标志                     "
    },
    {
      "line": 95,
      "text": "     ,A.OVERDUE_MAX_DAYS                                  AS  Max_Ovdu_Days           --最大逾期天数                 "
    },
    {
      "line": 96,
      "text": "     ,A.OVERDUE_AMOUNT                                    AS  Ovdu_Amt                --逾期金额                     "
    },
    {
      "line": 97,
      "text": "     ,A.OVERDUE_PRINCIPAL                                 AS  Ovdu_Prin               --逾期本金                     "
    },
    {
      "line": 98,
      "text": "     ,A.RECEIVED_AMOUNT                                   AS  Recv_Amt                --已收金额                     "
    },
    {
      "line": 99,
      "text": "     ,A.RECEIVED_PRINCIPAL                                AS  Recv_Prin               --已收本金                     "
    },
    {
      "line": 100,
      "text": "     ,A.RECEIVED_INTEREST                                 AS  Recv_Intr               --已收利息                     "
    },
    {
      "line": 101,
      "text": "     ,A.WRITE_OFF_FLAG                                    AS  Wtof_Stat_Cd            --核销状态代码                 "
    },
    {
      "line": 102,
      "text": "     ,SUBSTR(A.LAST_RECEIVED_DATE ,1,10)                  AS  Last_Recv_Date          --最后收款日期                 "
    },
    {
      "line": 103,
      "text": "     ,SUBSTR(A.FULL_WRITE_OFF_DATE,1,10)                  AS  Absl_Wtof_Date          --完全核销日期                 "
    },
    {
      "line": 104,
      "text": "     ,A.PENALTY_PROCESS_STATUS                            AS  Fine_Hand_Stat_Cd       --罚金处理状态代码             "
    },
    {
      "line": 105,
      "text": "     ,A.BILLING_STATUS                                    AS  Inv_Stat_Cd             --开票状态代码                 "
    },
    {
      "line": 106,
      "text": "     ,A.BILLING_AMOUNT                                    AS  Inv_Amt                 --开票金额                     "
    },
    {
      "line": 107,
      "text": "     ,A.BILLING_PRINCIPAL                                 AS  Prin_Inv_Amt            --本金开票金额                 "
    },
    {
      "line": 108,
      "text": "     ,A.BILLING_INTEREST                                  AS  Intr_Inv_Amt            --利息开票金额                 "
    },
    {
      "line": 109,
      "text": "     ,CASE WHEN A.RENT_SEND_FLAG = 'Y' THEN '1'"
    },
    {
      "line": 110,
      "text": "           WHEN A.RENT_SEND_FLAG = 'N' THEN '0'"
    },
    {
      "line": 111,
      "text": "           ELSE A.RENT_SEND_FLAG END                      AS  Rent_Ntfc_Send_Flag     --租金通知书发送标志           "
    },
    {
      "line": 112,
      "text": "     ,A.CREATION_DATE                                     AS  Create_Time             --创建日期                     "
    },
    {
      "line": 113,
      "text": "     ,A.LAST_UPDATE_DATE                                  AS  Upd_Time                --最后更新日期                 "
    },
    {
      "line": 114,
      "text": "     ,'${data_src_cd}'                               AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 115,
      "text": "     ,'${filename}'                                  AS  Task_Name               --任务名"
    },
    {
      "line": 116,
      "text": "     ,'${data_day_str}'                              AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 117,
      "text": "     ,'${data_day_str}'                              AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 118,
      "text": "     ,'${data_today}'                                AS  Data_Time               --数据时间"
    },
    {
      "line": 119,
      "text": "     ,'${src_table}'                                 AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 120,
      "text": "FROM (SELECT *  FROM ${src_table} WHERE  Busi_Date='${data_day_str}' AND DEL_FLAG='N')A"
    },
    {
      "line": 121,
      "text": "LEFT JOIN (SELECT *  FROM ODATA_N_GLM.P_CON_CONTRACT WHERE  Busi_Date='${data_day_str}' AND DEL_FLAG='N')B"
    },
    {
      "line": 122,
      "text": "       ON A.CONTRACT_ID=B.CONTRACT_ID"
    },
    {
      "line": 123,
      "text": ";"
    },
    {
      "line": 124,
      "text": ""
    }
  ]
}
