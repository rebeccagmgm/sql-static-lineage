      "line": 83,
      "text": "-- querySql"
    },
    {
      "line": 84,
      "text": "insert overwrite table ta_shares_detail_info_temp1"
    },
    {
      "line": 85,
      "text": "select"
    },
    {
      "line": 86,
      "text": "replace(t1.Cfm_Seri_No,'TA5-','') as serial_no,  -- 主键"
    },
    {
      "line": 87,
      "text": "t2.amac_cd as amac_fund_code, -- 协会备案码"
    },
    {
      "line": 88,
      "text": "t1.Fnd_Acct_Agt_Id as c_fundacco, --基金账号"
    },
    {
      "line": 89,
      "text": "t3.pty_name as cust_name, --客户名称"
    },
    {
      "line": 90,
      "text": "datediff(from_unixtime(unix_timestamp(),'yyyy-MM-dd'),default.datekey2date(t1.Reg_Date)) hold_duration, --份额持有天数,当前日期距确认日期天数"
    },
    {
      "line": 91,
      "text": "t1.Sler_Pty_Id as c_agencyno, --销售商代码"
    },
    {
      "line": 92,
      "text": "t4.pty_name as agency_name, --销售商名称"
    },
    {
      "line": 93,
      "text": "t1.Trd_Acct as c_tradeacco, --交易账号"
    },
    {
      "line": 94,
      "text": "split(t1.Prd_Id,'-')[2] as c_fundcode, --基金代码"
    },
    {
      "line": 95,
      "text": "t2.prd_name as fund_cname, --基金名称"
    },
    {
      "line": 96,
      "text": "t1.Remn_Vol as f_remainshares, --本笔剩余份额"
    },
    {
      "line": 97,
      "text": "case when length(t1.Reg_Date) = 8"
    },
    {
      "line": 98,
      "text": "then default.datekey2date(t1.Reg_Date)"
    },
    {
      "line": 99,
      "text": "else null"
    },
    {
      "line": 100,
      "text": "end as  d_registdate, --注册日期"
    },
    {
      "line": 101,
      "text": "case when length(t1.Cfm_Date) = 8"
    },
    {
      "line": 102,
      "text": "then default.datekey2date(t1.Cfm_Date)"
    },
    {
      "line": 103,
      "text": "else null"
    },
    {
      "line": 104,
      "text": "end as d_cdate, --确认日期"
    },
    {
      "line": 105,
      "text": "case when t5.dw_cd_val_desc = '调整所得' then '份额调整所得' else t5.dw_cd_val_desc end as c_orisource, --份额原始来源"
    },
    {
      "line": 106,
      "text": "t1.Ori_Cfm_Amt as f_oricfmbalance, --原确认金额"
    },
    {
      "line": 107,
      "text": "t1.Ori_Cfm_Vol as f_oricfmshares, --原确认份额"
    },
    {
      "line": 108,
      "text": "case when t6.dw_cd_val_desc = '调整所得' then '份额调整所得' else t6.dw_cd_val_desc end as c_sourcetype, --份额来源"
    },
    {
      "line": 109,
      "text": "t1.Ori_Unit_Nav as f_orinetvalue, --原单位净值"
    },
    {
      "line": 110,
      "text": "t1.Last_Dect_Unit_Nav as f_lastdeductnetvalue, --上次提成单位净值"
    },
    {
      "line": 111,
      "text": "case when t3.pty_stat_cd = '05' then '冻结'"
    },
    {
      "line": 112,
      "text": "when t3.pty_stat_cd = '04' then '正常'"
    },
    {
      "line": 113,
      "text": "when t3.pty_stat_cd = '07' then '销户'"
    },
    {
      "line": 114,
      "text": "else null end as  account_status, --账户状态 引用代码表10026"
    },
    {
      "line": 115,
      "text": "case when length(t1.Last_Dect_Date) = 8"
    },
    {
      "line": 116,
      "text": "then default.datekey2date(t1.Last_Dect_Date)"
    },
    {
      "line": 117,
      "text": "else null"
    },
    {
      "line": 118,
      "text": "end as d_lastdeductdate, --上次提成日期"
    },
    {
      "line": 119,
      "text": "t3.pty_cate_cd as cust_type, --客户类型"
    },
    {
      "line": 120,
      "text": "t3.idty_info_type as certificate_type, --证件类型"
    },
    {
      "line": 121,
      "text": "t3.idty_info_cont as certificate_id  --证件号码"
    },
    {
      "line": 122,
      "text": "from PDATA_N.T03_AMS_TA_SHR_DET t1 --TA份额明细表"
    },
    {
      "line": 123,
      "text": "join (  --TA产品清单"
    },
    {
      "line": 124,
      "text": "select a.cstd_prd_id"
    },
    {
      "line": 125,
      "text": ",b.ta_fnd_cd --产品TA代码"
    },
    {
      "line": 126,
      "text": ",b.prd_name"
    },
    {
      "line": 127,
      "text": ",a.oserv_acct"
    },
    {
      "line": 128,
      "text": ",a.cstd_acct"
    },
    {
      "line": 129,
      "text": ",a.amac_cd"
    },
    {
      "line": 130,
      "text": "from ("
    },
    {
      "line": 131,
      "text": "select cstd_prd_id"
    },
    {
      "line": 132,
      "text": ",prd_name"
    },
    {
      "line": 133,
      "text": ",mngr_name"
    },
    {
      "line": 134,
      "text": ",oserv_acct"
    },
    {
      "line": 135,
      "text": ",cstd_acct"
    },
    {
      "line": 136,
      "text": ",amac_cd"
    },
    {
      "line": 137,
      "text": "from pdata_n.t98_cstd_prd_base_info --71716"
    },
    {
      "line": 138,
      "text": "where busi_date='2026-06-04'"
    },
    {
      "line": 139,
      "text": ") a"
    },
    {
      "line": 140,
      "text": "join ("
    },
    {
      "line": 141,
      "text": "select cstd_prd_id,ta_fnd_cd,prd_name"
    },
    {
      "line": 142,
      "text": "from pdata_n.t98_cstd_prd_ta_info  --91073  TA5产品"
    },
    {
      "line": 143,
      "text": "where busi_date='2026-06-04'"
    },
    {
      "line": 144,
      "text": ") b"
    },
    {
      "line": 145,
      "text": "on a.cstd_prd_id=b.cstd_prd_id"
    },
    {
      "line": 146,
      "text": ") t2"
    },
    {
      "line": 147,
      "text": "on split(t1.Prd_Id,'-')[2] = t2.ta_fnd_cd"
    },
    {
      "line": 148,
      "text": "left join ( --基金账户信息表"
    },
    {
      "line": 149,
      "text": "select replace(a.pty_id,'TA5001-','') as pty_id"
    },
    {
      "line": 150,
      "text": ",a.pty_name"
    },
    {
      "line": 151,
      "text": ",a.pty_stat_cd  --账户状态"
    },
    {
      "line": 152,
      "text": ",b.idty_info_type_cd"
    },
    {
      "line": 153,
      "text": ",d.dw_cd_val_desc as idty_info_type  --证件类型"
    },
    {
      "line": 154,
      "text": ",c.pty_cate_cd  --客户类型"
    },
    {
      "line": 155,
      "text": ",b.idty_info_cont"
    },
    {
      "line": 156,
      "text": "from pdata_n.t01_pty a"
    },
    {
      "line": 157,
      "text": "left join pdata_n.t01_pty_idty_info b"
    },
    {
      "line": 158,
      "text": "on a.pty_id = b.pty_id"
    },
    {
      "line": 159,
      "text": "and b.busi_date = default.pretradedate(date_add('2026-06-04',1),1)"
    },
    {
      "line": 160,
      "text": "and b.src_tbl = 'ODATA_N_TA5.D_TA_TCUSTOMERINFO'"
    },
    {
      "line": 161,
      "text": "left join (  --拆分个人&机构&产品类型"
    },
    {
      "line": 162,
      "text": "select pty_id,'个人' as pty_cate_cd"
    },
    {
      "line": 163,
      "text": "from pdata_n.t01_indv"
    },
    {
      "line": 164,
      "text": "where busi_date = default.pretradedate(date_add('2026-06-04',1),1)"
    },
    {
      "line": 165,
      "text": "and src_tbl = 'ODATA_N_TA5.D_TA_TCUSTOMERINFO'"
    },
    {
      "line": 166,
      "text": "union all"
    },
    {
      "line": 167,
      "text": "select pty_id,"
    },
    {
      "line": 168,
      "text": "case when corp_cust_clas_cd = '1' then '机构'"
    },
    {
      "line": 169,
      "text": "when corp_cust_clas_cd = '3' then '产品' end as pty_cate_cd"
    },
    {
      "line": 170,
      "text": "from pdata_n.t01_corp_cust"
    },
    {
      "line": 171,
      "text": "where busi_date = default.pretradedate(date_add('2026-06-04',1),1)"
    },
    {
      "line": 172,
      "text": "and src_tbl = 'ODATA_N_TA5.D_TA_TCUSTOMERINFO'"
    },
    {
      "line": 173,
      "text": ") c"
    },
    {
      "line": 174,
      "text": "on a.pty_id = c.pty_id"
    },
    {
      "line": 175,
      "text": "left join pdata_n.ref_dw_cd_val d --证件类型转码"
    },
    {
      "line": 176,
      "text": "on b.idty_info_type_cd = d.dw_cd_val and d.dw_cd_id = 'CD006'"
    },
    {
      "line": 177,
      "text": "where a.src_tbl = 'ODATA_N_TA5.D_TA_TCUSTOMERINFO'"
    },
    {
      "line": 178,
      "text": "and a.del_flag = '0'"
    },
    {
      "line": 179,
      "text": ") t3"
    },
    {
      "line": 180,
      "text": "on t1.fnd_trd_acct_agt_id = t3.pty_id"
    },
    {
      "line": 181,
      "text": "left join ( --基金销售商信息"
    },
    {
      "line": 182,
      "text": "select pty_id,pty_name"
    },
    {
      "line": 183,
      "text": "from pdata_n.t01_pty  --63173"
    },
    {
      "line": 184,
      "text": "where src_tbl = 'ODATA_N_TA5.D_TA_TAGENCYINFO'"
    },
    {
      "line": 185,
      "text": "and del_flag = '0'"
    },
    {
      "line": 186,
      "text": ") t4"
    },
    {
      "line": 187,
      "text": "on t1.sler_pty_id = t4.pty_id"
    },
    {
      "line": 188,
      "text": "left join pdata_n.ref_dw_cd_val t5 --份额原始来源转码"
    },
    {
      "line": 189,
      "text": "on t1.Shr_Ori_Src = t5.dw_cd_val and t5.dw_cd_id = 'CD158'"
    },
    {
      "line": 190,
      "text": "left join pdata_n.ref_dw_cd_val t6 --份额来源转码"
    },
    {
      "line": 191,
      "text": "on t1.Shr_Src_Cd = t6.dw_cd_val and t6.dw_cd_id = 'CD158'"
    },
    {
      "line": 192,
      "text": "where t1.src_tbl = 'ODATA_N_TA5.D_TA_TSHAREDETAIL'"
    },
    {
      "line": 193,
      "text": "and t1.busi_date = default.pretradedate('2026-06-04',-1) --匹配模型存数日期"
    },
    {
      "line": 194,
      "text": ";"
    },
    {
      "line": 195,
      "text": ""
    },
    {
      "line": 196,
      "text": "insert overwrite table ta_shares_detail_info_temp2"
    },
    {
      "line": 197,
      "text": "select t1.c_fundcode   -- 基金代码"
    },
    {
      "line": 198,
      "text": ",t1.d_registdate -- 注册日期"
    },
    {
      "line": 199,
      "text": ",t1.d_cdate      -- 确认日期"
    },
    {
      "line": 200,
      "text": ",case when t2.para_val is null then '0' -- 无参数“赎回最少持有天/月数”，锁定期给“0”"
    },
    {
      "line": 201,
      "text": "when t3.para_val = '1' then concat(t2.para_val, '月') -- 按月"
    },
    {
      "line": 202,
      "text": "else concat(t2.para_val, '天') -- 按天"
    },
    {
      "line": 203,
      "text": "end as lock_period -- 锁定期 0|xx天|xx月"
    },
    {
      "line": 204,
      "text": ",case when t2.para_val is null then t1.d_registdate -- 无参数“赎回最少持有天/月数”，锁定期默认为“0”"
    },
    {
      "line": 205,
      "text": "when t3.para_val = '1' then default.add_months(t1.d_registdate, t2.para_val) -- 按月加锁定期"
    },
    {
      "line": 206,
      "text": "else date_add(t1.d_registdate, t2.para_val) -- 按天加锁定期"
    },
    {
      "line": 207,
      "text": "end as d_registdate1 -- 注册日期+锁定期"
    },
    {
      "line": 208,
      "text": ",date_add(case when t2.para_val is null then t1.d_registdate -- 无参数“赎回最少持有天/月数”，锁定期默认为“0”"
    },
    {
      "line": 209,
      "text": "when t3.para_val = '1' then default.add_months(t1.d_registdate, t2.para_val) -- 按月加锁定期"
    },
    {
      "line": 210,
      "text": "else date_add(t1.d_registdate, t2.para_val) -- 按天加锁定期"
    },
    {
      "line": 211,
      "text": "end"
    },
    {
      "line": 212,
      "text": ",-cast(nvl(t4.para_val, 1) as int)"
    },
    {
