    {
      "line": 255,
      "text": "insert overwrite table ta_shares_detail_info"
    },
    {
      "line": 256,
      "text": "select t1.*"
    },
    {
      "line": 257,
      "text": ",t2.lock_period -- 锁定期"
    },
    {
      "line": 258,
      "text": ",case"
    },
    {
      "line": 259,
      "text": "when t2.lock_period = '0' then '1'"
    },
    {
      "line": 260,
      "text": "when ("
    },
    {
      "line": 261,
      "text": "case when default.IsTradeDay(d_registdate1) = '0'"
    },
    {
      "line": 262,
      "text": "then default.pretradedate(d_registdate1, -1)"
    },
    {
      "line": 263,
      "text": "else d_registdate1 end"
    },
    {
      "line": 264,
      "text": ") <= '2026-06-05' then '1'"
    },
    {
      "line": 265,
      "text": "else '0'"
    },
    {
