    {
      "line": 56,
      "text": "      ,'ODATA_N_XIR.T_TTRD_ACC_CASH'                   AS SRC_TBL             --源表"
    },
    {
      "line": 57,
      "text": "      ,BUSI_DATE                                       AS BUSI_DATE           --业务日期"
    },
    {
