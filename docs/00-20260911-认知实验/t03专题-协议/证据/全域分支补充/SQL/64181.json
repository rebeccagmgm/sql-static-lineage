    {
      "line": 48,
      "text": "      ,A.PC1                                           AS BEL_DEPT            --资金账户所属部门"
    },
    {
      "line": 49,
      "text": "      ,A.PC3                                           AS CRS_POS_TRD_APPR_FLAG     --跨头寸内部交易审批标志"
    },
    {
      "line": 50,
      "text": "      ,A.PC3                                           AS CLR_FLAG            --清算标志"
