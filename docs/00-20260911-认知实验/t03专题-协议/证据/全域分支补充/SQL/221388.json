    {
      "line": 45,
      "text": "INSERT OVERWRITE TABLE T03_SB_GOLD_DELAY_COMP_HOLD_INFO PARTITION(Src_Tbl='${src_table}',Busi_Date='${data_day_str}')"
    },
    {
      "line": 46,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 47,
      "text": "--Group1.: Source Table:[ODATA_N_GTS.G_HIS_M_DEFER_POSI_DETAIL:历史会员清算延期持仓明细表] "
    },
    {
      "line": 48,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 49,
      "text": "SELECT"
    },
    {
      "line": 50,
      "text": "     EXCH_DATE                                         AS  Hold_Date               --持仓日期                 "
    },
    {
      "line": 51,
      "text": "    ,ACCT_NO                                           AS  Sge_Cust_Acct_Agt_Id    --上金所资金账户协议编号   "
    },
    {
      "line": 52,
      "text": "    ,IF(NVL(TRIM(ACCT_NO),'')='','','10236')           AS  Sge_Cust_Acct_Agt_Modifr--上金所资金账户协议修饰符 "
    },
    {
      "line": 53,
      "text": "    ,IF(NVL(TRIM(ACCT_NO),'')='','', CONCAT('GTS005-',ACCT_NO) ) "
    },
    {
      "line": 54,
      "text": "                                                       AS  Cust_Pty_Id             --客户当事人编号           "
    },
    {
      "line": 55,
      "text": "    ,CUST_ID                                           AS  Exch_Cust_No            --交易所客户编号           "
    },
    {
      "line": 56,
      "text": "    ,MATCH_NO                                          AS  Trd_No                  --成交编号                 "
    },
    {
      "line": 57,
      "text": "    ,ORDER_NO                                          AS  Decfm_No                --报单编号                 "
    },
    {
      "line": 58,
      "text": "    ,PROD_CODE                                         AS  Comp_Code               --合约代码                 "
    },
    {
      "line": 59,
      "text": "    ,NVL(DW_CD_VAL,LONG_SHORT)                         AS  Long_Shor_Type_Cd       --持仓多空类型代码         "
    },
    {
      "line": 60,
      "text": "    ,STOR_DATE                                         AS  Opps_Date               --开仓日期                 "
    },
    {
      "line": 61,
      "text": "    ,STOR_TIME                                         AS  Opps_Time               --开仓时间                 "
    },
    {
      "line": 62,
      "text": "    ,STOR_AMT                                          AS  Pos_Vol                 --仓位数量                 "
    },
    {
      "line": 63,
      "text": "    ,STOR_PRICE                                        AS  Pos_Unit_Pric           --仓位单价                 "
    },
    {
      "line": 64,
      "text": "    ,COV_FROZ_AMT                                      AS  Drop_Frz_Vol            --平仓冻结数量             "
    },
    {
      "line": 65,
      "text": "    ,DELI_FROZ_AMT                                     AS  Sett_Frz_Vol            --交收冻结数量             "
    },
    {
      "line": 66,
      "text": "    ,COV_AMT                                           AS  Drop_Vol                --平仓数量                 "
    },
    {
      "line": 67,
      "text": "    ,DELI_AMT                                          AS  Sett_Vol                --交收数量                 "
    },
    {
      "line": 68,
      "text": "    ,LAST_REMAIN                                       AS  Pday_Remn_Vol           --上日剩余数量             "
    },
    {
      "line": 69,
      "text": "    ,REMAIN                                            AS  Tdy_Remn_Vol            --当日剩余数量             "
    },
    {
      "line": 70,
      "text": "    ,VARIATION_MARGIN                                  AS  Bail_Chg_Amt            --保证金变动金额           "
    },
    {
      "line": 71,
      "text": "    ,COV_SURPLUS                                       AS  Drop_Balance            --平仓盈余                 "
    },
    {
      "line": 72,
      "text": "    ,MARK_SURPLUS                                      AS  Mtm_Balance             --盯市盈余                 "
    },
    {
      "line": 73,
      "text": "    ,B_MARGIN                                          AS  Exch_Bail               --交易所保证金             "
    },
    {
      "line": 74,
      "text": "    ,M_MARGIN                                          AS  Mem_Bail                --会员保证金               "
    },
    {
      "line": 75,
      "text": "    ,'${data_src_cd}'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 76,
      "text": "    ,'${filename}'                                AS  Task_Name               --任务名"
    },
    {
      "line": 77,
      "text": "    ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 78,
      "text": "    ,'${data_day_str}'                            AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 79,
      "text": "    ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 80,
      "text": "    ,'${src_table}'                               AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 81,
      "text": "FROM   (SELECT *  FROM ${src_table} WHERE  Busi_Date='${data_day_str}' AND EXCH_DATE='${data_day_int}')A"
    },
    {
      "line": 82,
      "text": "LEFT JOIN ("
    },
    {
      "line": 83,
      "text": "         SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 84,
      "text": "           FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 85,
      "text": "         WHERE TGT_TAB_NAME = 'T03_SB_GOLD_DELAY_COMP_HOLD_INFO'"
    },
    {
      "line": 86,
      "text": "            AND TGT_TAB_FLD  = 'Long_Shor_Type_Cd'"
    },
    {
      "line": 87,
      "text": "            AND SRC_TAB_NAME = 'HIS_M_DEFER_POSI_DETAIL'"
    },
    {
      "line": 88,
      "text": "            AND SRC_FLD_NAME = 'LONG_SHORT'"
    },
    {
      "line": 89,
      "text": "            AND SRC_SYS_NAME='GTS')B"
    },
    {
      "line": 90,
      "text": "   ON      A.LONG_SHORT =B.SRC_CD_VAL                  --LONG_SHORT 转码"
