      "text": "   ,pty_name                   string comment '客户名称'"
    },
    {
      "line": 32,
      "text": "   ,bel_inr_org_id             string comment '所属内部机构编号'"
    },
    {
      "line": 33,
      "text": "   ,bel_inr_org_name           string comment '所属内部机构名称'"
    },
    {
      "line": 34,
      "text": "   ,ord_inr_org_id             string comment '订单所属内部机构编号'"
    },
    {
