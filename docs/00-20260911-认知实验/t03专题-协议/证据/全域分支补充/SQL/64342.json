    {
      "line": 35,
      "text": "INSERT OVERWRITE TABLE T03_PB_AST_UNIT_OPER_BUSI_RIGH PARTITION (SRC_TBL='${src_table}',BUSI_DATE='${data_day_str}')"
    },
    {
      "line": 36,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 37,
      "text": "--Group1: Source Table:[ODATA_N_GPB.U_OPERBUSIRIGHT:账户权限]"
    },
    {
      "line": 38,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 39,
      "text": "SELECT"
    },
    {
      "line": 40,
      "text": "       PROJECTID                                       AS AGT_ID              --协议编号"
    },
    {
      "line": 41,
      "text": "      ,CASE WHEN UPPER(SYS_AREA_CODE)='SH' THEN '10203-GPB-SH'"
    },
    {
      "line": 42,
      "text": "            WHEN UPPER(SYS_AREA_CODE)='SZ' THEN '10203-GPB-SZ'   "
    },
    {
      "line": 43,
      "text": "            ELSE ''"
    },
    {
      "line": 44,
      "text": "        END                                            AS AGT_MODIFR          --协议修饰符"
    },
    {
      "line": 45,
      "text": "      ,LAYER                                           AS CTRL_LAYER          --控制层次"
    },
    {
      "line": 46,
      "text": "      ,FUNDID                                          AS PRD_ID              --产品编号"
    },
    {
      "line": 47,
      "text": "      ,CASE WHEN NVL(TRIM(USERID),'') IN ('','0') THEN USERID"
    },
    {
      "line": 48,
      "text": "            ELSE (CASE WHEN UPPER(SYS_AREA_CODE)='SH' THEN CONCAT('GPB012-',USERID)"
    },
    {
      "line": 49,
      "text": "                       WHEN UPPER(SYS_AREA_CODE)='SZ' THEN CONCAT('GPB019-',USERID)"
    },
    {
      "line": 50,
      "text": "                       ELSE USERID"
    },
    {
      "line": 51,
      "text": "                   END )"
    },
    {
      "line": 52,
      "text": "        END                                            AS OPER_USER_ID        --操作员编号"
    },
    {
      "line": 53,
      "text": "      ,COMBID                                          AS COMB_ID             --组合编号"
    },
    {
      "line": 54,
      "text": "      ,QRYFLAG                                         AS QRY_FLAG            --查询标志"
    },
    {
      "line": 55,
      "text": "      ,OPERFLAG                                        AS OPER_FLAG           --操作标志"
    },
    {
      "line": 56,
      "text": "      ,CONFIRMFLAG                                     AS COMPD_FLAG          --复合标志"
    },
    {
      "line": 57,
      "text": "      ,PT_STKTYPES                                     AS ALLOW_OPER_STK      --允许操作证券"
    },
    {
      "line": 58,
      "text": "      ,PT_BUSINCLASSS                                  AS ALLOW_OPER_BUSI     --允许操作业务"
    },
    {
      "line": 59,
      "text": "      ,NVL(PT_INVESTKIND,'')                           AS ALLOW_IVST_RANGE    --允许投资范围"
    },
    {
      "line": 60,
      "text": "      ,NVL(TRADERIGHT,'')                              AS OPER_RIGH_STR       --操作权限字符串"
    },
    {
      "line": 61,
      "text": "      ,NVL(PT_BSFLAG,'')                               AS ALLOW_OPER_ENTR     --允许操作委托"
    },
    {
      "line": 62,
      "text": "      ,UPPER(SYS_AREA_CODE)                            AS SYS_SRC_CD          --源系统来源代码"
    },
    {
      "line": 63,
      "text": "      ,'${data_src_cd}'                           AS DATA_SRC_CD         --数据来源代码"
    },
    {
      "line": 64,
      "text": "      ,UPPER('${filename}')                       AS TASK_NAME           --任务名"
    },
    {
      "line": 65,
      "text": "      ,'${data_day_str}'                          AS DATA_ETL_DATE       --数据加载日期"
    },
    {
      "line": 66,
      "text": "      ,'${data_today_str}'                        AS DATA_UPT_DATE       --数据更新日期"
    },
    {
      "line": 67,
      "text": "      ,'${data_today}'                            AS DATA_TIME           --数据时间"
    },
    {
      "line": 68,
      "text": "FROM  (SELECT *  FROM ${src_table} "
    },
    {
      "line": 69,
      "text": "        WHERE  BUSI_DATE='${data_day_str}' "
    },
    {
      "line": 70,
      "text": "        )A"
    },
