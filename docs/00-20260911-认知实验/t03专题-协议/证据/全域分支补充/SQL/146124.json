      "line": 25,
      "text": "-- querySql"
    },
    {
      "line": 26,
      "text": "insert into table real_account_info partition (account_type_code) "
    },
    {
      "line": 27,
      "text": "select upper(regexp_replace(default.uuid(), '-', '')) real_account_id, "
    },
    {
      "line": 28,
      "text": "       s.real_account, "
    },
    {
      "line": 29,
      "text": "       map() extra_account, "
    },
    {
      "line": 30,
      "text": "       max(s.account_name) account_name, "
    },
    {
      "line": 31,
      "text": "       from_unixtime(unix_timestamp(),'yyyy-MM-dd HH:mm:ss') data_time, "
    },
    {
      "line": 32,
      "text": "       null modify_operator, "
    },
    {
      "line": 33,
      "text": "       '2999-12-31 00:00:00' modify_time, "
    },
    {
      "line": 34,
      "text": "       '1' status, "
    },
    {
      "line": 35,
      "text": "       s.account_type_code "
    },
    {
      "line": 36,
      "text": "  from ( "
    },
    {
      "line": 37,
      "text": " --衡泰内部证券账户+外部证券账户+内部资金账户+外部资金账户 "
    },
    {
      "line": 38,
      "text": "  select t1.* "
    },
    {
      "line": 39,
      "text": "  from (select map('secu_accid',secu_accid,'secu_ext_accid',secu_ext_accid,'cash_accid',cash_accid,'cash_ext_accid',cash_ext_accid) real_account, "
    },
    {
      "line": 40,
      "text": "               max(agt_name) account_name, "
    },
    {
      "line": 41,
      "text": "               'XIR.SCR_ACCT' account_type_code "
    },
    {
      "line": 42,
      "text": "          from (select secu_map.agt_id secu_accid, "
    },
    {
      "line": 43,
      "text": "                       secu_map.rela_agt_id secu_ext_accid, "
    },
    {
      "line": 44,
      "text": "                       in_secu.fnd_acct_agt_id cash_accid, "
    },
    {
      "line": 45,
      "text": "                       ext_secu.fnd_acct_agt_id cash_ext_accid, "
    },
    {
      "line": 46,
      "text": "                       concat(in_cash.agt_name, "
    },
    {
      "line": 47,
      "text": "                              '^', "
    },
    {
      "line": 48,
      "text": "                              ext_cash.agt_name, "
    },
    {
      "line": 49,
      "text": "                              '^', "
    },
    {
      "line": 50,
      "text": "                              in_secu.agt_name, "
    },
    {
      "line": 51,
      "text": "                              '^', "
    },
    {
      "line": 52,
      "text": "                              ext_secu.agt_name) agt_name "
    },
    {
      "line": 53,
      "text": "                  from (select agt_id, rela_agt_id "
    },
    {
      "line": 54,
      "text": "                          from pdata_n.T03_AGT_RELA_H "
    },
    {
      "line": 55,
      "text": "                         where agt_rela_type_cd = 'B21') secu_map "
    },
    {
      "line": 56,
      "text": "                  left join (select * "
    },
    {
      "line": 57,
      "text": "                              from pdata_n.T03_XIR_SCR_ACCT "
    },
    {
      "line": 58,
      "text": "                             where agt_type_cd = '1010201' "
    },
    {
      "line": 59,
      "text": "                               and busi_date = '2024-07-26') ext_secu "
    },
    {
      "line": 60,
      "text": "                    on secu_map.rela_agt_id = ext_secu.agt_id "
    },
    {
      "line": 61,
      "text": "                  left join (select * "
    },
    {
      "line": 62,
      "text": "                              from pdata_n.T03_XIR_SCR_ACCT "
    },
    {
      "line": 63,
      "text": "                             where agt_type_cd = '1010202' "
    },
    {
      "line": 64,
      "text": "                               and busi_date = '2024-07-26') in_secu "
    },
    {
      "line": 65,
      "text": "                    on secu_map.agt_id = in_secu.agt_id "
    },
    {
      "line": 66,
      "text": "                  left join (select * "
    },
    {
      "line": 67,
      "text": "                              from PDATA_N.T03_XIR_FND_ACCT "
    },
    {
      "line": 68,
      "text": "                             where agt_type_cd = '1020901' "
    },
    {
      "line": 69,
      "text": "                               and busi_date = '2024-07-26') ext_cash "
    },
    {
      "line": 70,
      "text": "                    on ext_secu.fnd_acct_agt_id = ext_cash.agt_id "
    },
    {
      "line": 71,
      "text": "                  left join (select * "
    },
    {
      "line": 72,
      "text": "                              from PDATA_N.T03_XIR_FND_ACCT "
    },
    {
      "line": 73,
      "text": "                             where agt_type_cd = '1020902' "
    },
    {
      "line": 74,
      "text": "                               and busi_date = '2024-07-26') in_cash "
    },
    {
      "line": 75,
      "text": "                    on in_secu.fnd_acct_agt_id = in_cash.agt_id) acct "
    },
    {
      "line": 76,
      "text": "         group by secu_accid, secu_ext_accid, cash_accid, cash_ext_accid) t1 "
    },
    {
      "line": 77,
      "text": "  left join (select * "
    },
    {
      "line": 78,
      "text": "               from real_account_info "
    },
    {
      "line": 79,
      "text": "              where account_type_code = 'XIR.SCR_ACCT') t2 "
    },
    {
      "line": 80,
      "text": "    on t1.real_account ['secu_accid'] = t2.real_account ['secu_accid'] "
    },
    {
      "line": 81,
      "text": "   and t1.real_account ['secu_ext_accid'] = t2.real_account ['secu_ext_accid'] "
    },
    {
      "line": 82,
      "text": "   and t1.real_account ['cash_accid'] = t2.real_account ['cash_accid'] "
    },
    {
      "line": 83,
      "text": "   and t1.real_account ['cash_ext_accid'] = t2.real_account ['cash_ext_accid'] "
    },
    {
      "line": 84,
      "text": " where t2.real_account is null "
    },
    {
      "line": 85,
      "text": " ) s  "
    },
    {
      "line": 86,
      "text": " group by s.real_account,s.account_type_code;"
    },
