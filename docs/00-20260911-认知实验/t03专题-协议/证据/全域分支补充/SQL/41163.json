      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 99,
      "text": "SELECT"
    },
    {
      "line": 100,
      "text": "        CONCAT('TA5-',C_CSERIALNO)                                              AS Cfm_Seri_No              --确认单编号"
    },
    {
      "line": 101,
      "text": "       ,C_TENANTID                                                              AS Tnt_Id                   --租户号"
    },
    {
      "line": 102,
      "text": "       ,C_FUNDACCO                                                              AS Fnd_Acct_Agt_Id          --基金账户协议编号"
    },
    {
      "line": 103,
      "text": "       ,'10105'                                                                 AS Fnd_Acct_Agt_Modifr      --基金账户协议修饰符"
    },
    {
      "line": 104,
      "text": "       ,C_FUNDACCO                                                              AS Fnd_Trd_Acct_Agt_Id      --基金交易账户协议编号"
    },
    {
      "line": 105,
      "text": "       ,CONCAT('10107-',C_TACODE,'-',C_AGENCYNO,'-',C_NETNO,'-',C_TRADEACCO)    AS Fnd_Trd_Acct_Agt_Modifr  --基金交易账户协议修饰符"
    },
    {
      "line": 106,
      "text": "       ,CONCAT('TA5001-',C_FUNDACCO)                                            AS Shr_Holder_Pty_Id        --份额持有人编号"
    },
    {
      "line": 107,
      "text": "       ,CONCAT('TA5-',C_TACODE,'-',C_FUNDCODE)                                  AS Prd_Id                   --产品编号"
    },
    {
      "line": 108,
      "text": "       ,'LONG'                                                                  AS Long_Shor_Clas           --多空分类"
    },
    {
      "line": 109,
      "text": "       ,CASE WHEN C_SHARETYPE='A'  THEN 'FND_BEF_FARE'                                                      "
    },
    {
      "line": 110,
      "text": "             WHEN C_SHARETYPE='B'  THEN 'FND_PST_FARE'"
    },
    {
      "line": 111,
      "text": "             WHEN C_SHARETYPE='AB' THEN 'FND_BEF_PST_FARE'"
    },
    {
      "line": 112,
      "text": "             WHEN C_SHARETYPE='C'  THEN 'FND_C_CLAS'"
    },
    {
      "line": 113,
      "text": "             END                                                                AS Hold_Type_Cd             --持仓类型代码"
    },
    {
