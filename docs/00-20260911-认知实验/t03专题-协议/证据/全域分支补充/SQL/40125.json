    },
    {
      "line": 42,
      "text": "DROP TABLE IF EXISTS TEMP.T03_AMS_FND_TRD_ACCT_TEMP_STA009;"
    },
    {
      "line": 43,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_AMS_FND_TRD_ACCT_TEMP_STA009"
    },
    {
      "line": 44,
      "text": "AS"
    },
    {
      "line": 45,
      "text": "SELECT"
    },
    {
      "line": 46,
      "text": "        A.C_FUNDACCO                            AS Agt_Id1                                  --协议编号"
    },
    {
      "line": 47,
      "text": "       ,CONCAT('10107-',C_AGENCYNO,'-',C_NETNO,'-',NVL(C_TRADEACCO,C_TRADEACCOBAK)) AS Agt_Modifr1 --协议修饰符"
    },
    {
      "line": 48,
      "text": "       ,CONCAT('STA001-',A.C_FUNDACCO)          AS Agt_Holder1                              --协议持有人编号"
    },
    {
      "line": 49,
      "text": "       ,''                                      AS Tnt_Id1                                  --租户号"
    },
    {
      "line": 50,
      "text": "       ,''                                      AS Ta_No1                                   --TA编号"
    },
    {
      "line": 51,
      "text": "       ,A.C_FUNDACCO                            AS Fnd_Acct_Agt_Id1                         --基金账户协议编号"
    },
    {
      "line": 52,
      "text": "       ,'10105'                                 AS Fnd_Acct_Agt_Modifr1                     --基金账户协议修饰符"
    },
    {
      "line": 53,
      "text": "       ,A.C_AGENCYNO                            AS Sler_Id1                                 --销售商编号"
    },
    {
      "line": 54,
      "text": "       ,A.C_NETNO                               AS Net_No1                                  --网点编号"
    },
    {
      "line": 55,
      "text": "       ,A.C_TRADEACCO                           AS Trd_Acct1                                --交易账号"
    },
    {
      "line": 56,
      "text": "       ,NVL(C.DW_CD_VAL,A.C_OPENFLAG)           AS Agt_Stat_Cd1                             --协议状态代码"
    },
    {
      "line": 57,
      "text": "       ,A.C_CHILDNETNO                          AS Oper_Net_No1                             --操作网点编号"
    },
    {
      "line": 58,
      "text": "       ,A.C_BANKNO                              AS Bnk_No1                                  --银行编号"
    },
    {
      "line": 59,
      "text": "       ,A.C_BANKACCO                            AS Sett_Bnk_Acct1                           --交收银行账号"
    },
    {
      "line": 60,
      "text": "       ,A.C_NAMEINBANK                          AS Sett_Bnk_Acct_Name1                      --交收银行户名"
    },
    {
      "line": 61,
      "text": "       ,A.C_BONUSTYPE                           AS Divd_Method_Cd1                          --分红方式代码"
    },
    {
      "line": 62,
      "text": "       ,''                                      AS Clr_Bat_No1                              --清算批次号"
    },
    {
      "line": 63,
      "text": "       ,A.C_SPECIALACCOFLAG                     AS Spec_Acct_Flag1                          --特殊账号标志"
    },
    {
      "line": 64,
      "text": "       ,'STA'                                   AS Data_Src_Cd1                             --数据来源代码"
    },
    {
      "line": 65,
      "text": "       ,'ODATA_N_STA.S_TACCONET'                AS Src_Tbl1                                 --源表"
    },
    {
      "line": 66,
      "text": "       ,UPPER('${filename}')               AS Task_Name1                               --任务名"
    },
    {
      "line": 67,
      "text": "       ,'${data_day_str}'                  AS Data_Etl_Date1                           --数据加载日期"
    },
    {
      "line": 68,
      "text": "       ,'${data_day_str}'                  AS Data_Upt_Date1                           --数据更新日期"
    },
    {
      "line": 69,
      "text": "FROM  (SELECT * FROM ODATA_N_STA.S_TACCONET WHERE BUSI_DATE='${data_day_str}')A"
    },
    {
      "line": 70,
      "text": ""
    },
    {
      "line": 71,
      "text": "LEFT JOIN ("
    },
    {
      "line": 72,
      "text": "          SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 73,
      "text": "          FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 74,
      "text": "          WHERE TGT_TAB_NAME = 'T03_AMS_FND_TRD_ACCT'"
    },
    {
      "line": 75,
      "text": "            AND TGT_TAB_FLD  = 'Agt_Stat_Cd'"
    },
    {
      "line": 76,
      "text": "            AND SRC_TAB_NAME = 'TACCONET'"
    },
    {
      "line": 77,
      "text": "            AND SRC_FLD_NAME = 'C_OPENFLAG'"
    },
    {
      "line": 78,
      "text": "            AND SRC_SYS_NAME='STA') C"
    },
    {
      "line": 79,
      "text": "ON        A.C_OPENFLAG = C.SRC_CD_VAL                  --C_OPENFLAG转码"
    },
    {
      "line": 80,
      "text": ""
    },
    {
      "line": 81,
      "text": ";"
    },
    {
      "line": 82,
      "text": ""
    },
    {
      "line": 83,
      "text": "DROP TABLE IF EXISTS TEMP.T03_AMS_FND_TRD_ACCT_MID_STA009;"
    },
    {
      "line": 84,
      "text": "CREATE TABLE IF NOT EXISTS TEMP.T03_AMS_FND_TRD_ACCT_MID_STA009"
    },
    {
      "line": 85,
      "text": "AS"
    },
    {
      "line": 86,
      "text": "SELECT"
    },
    {
      "line": 87,
      "text": "       A.*"
    },
    {
      "line": 88,
      "text": "      ,B.*"
    },
    {
      "line": 89,
      "text": "      ,CASE WHEN A.AGT_ID IS NULL AND B.AGT_ID1 IS NOT NULL THEN 'I' --新增"
    },
    {
      "line": 90,
      "text": "            WHEN A.AGT_ID IS NOT NULL AND B.AGT_ID1 IS NULL THEN 'D' --删除"
    },
    {
      "line": 91,
      "text": "            WHEN A.AGT_ID IS NOT NULL AND B.AGT_ID1 IS NOT NULL AND ("
    },
    {
      "line": 92,
      "text": "                COALESCE(A.Agt_Holder           ,'')   <> COALESCE(B.Agt_Holder1           ,'')"
    },
    {
      "line": 93,
      "text": "             OR COALESCE(A.Tnt_Id               ,'')   <> COALESCE(B.Tnt_Id1               ,'')"
    },
    {
      "line": 94,
      "text": "             OR COALESCE(A.Ta_No                ,'')   <> COALESCE(B.Ta_No1                ,'')"
    },
    {
      "line": 95,
      "text": "             OR COALESCE(A.Fnd_Acct_Agt_Id      ,'')   <> COALESCE(B.Fnd_Acct_Agt_Id1      ,'')"
    },
    {
      "line": 96,
      "text": "             OR COALESCE(A.Fnd_Acct_Agt_Modifr  ,'')   <> COALESCE(B.Fnd_Acct_Agt_Modifr1  ,'')"
    },
    {
      "line": 97,
      "text": "             OR COALESCE(A.Sler_Id              ,'')   <> COALESCE(B.Sler_Id1              ,'')"
    },
    {
      "line": 98,
      "text": "             OR COALESCE(A.Net_No               ,'')   <> COALESCE(B.Net_No1               ,'')"
    },
    {
      "line": 99,
      "text": "             OR COALESCE(A.Trd_Acct             ,'')   <> COALESCE(B.Trd_Acct1             ,'')"
    },
    {
      "line": 100,
      "text": "             OR COALESCE(A.Agt_Stat_Cd          ,'')   <> COALESCE(B.Agt_Stat_Cd1          ,'')"
    },
    {
      "line": 101,
      "text": "             OR COALESCE(A.Oper_Net_No          ,'')   <> COALESCE(B.Oper_Net_No1          ,'')"
    },
    {
      "line": 102,
      "text": "             OR COALESCE(A.Bnk_No               ,'')   <> COALESCE(B.Bnk_No1               ,'')"
    },
    {
      "line": 103,
      "text": "             OR COALESCE(A.Sett_Bnk_Acct        ,'')   <> COALESCE(B.Sett_Bnk_Acct1        ,'')"
    },
    {
      "line": 104,
      "text": "             OR COALESCE(A.Sett_Bnk_Acct_Name   ,'')   <> COALESCE(B.Sett_Bnk_Acct_Name1   ,'')"
    },
    {
      "line": 105,
      "text": "             OR COALESCE(A.Divd_Method_Cd       ,'')   <> COALESCE(B.Divd_Method_Cd1       ,'')"
    },
    {
      "line": 106,
      "text": "             OR COALESCE(A.Clr_Bat_No           ,'')   <> COALESCE(B.Clr_Bat_No1           ,'')"
    },
    {
      "line": 107,
      "text": "             OR COALESCE(A.Spec_Acct_Flag       ,'')   <> COALESCE(B.Spec_Acct_Flag1       ,'')"
    },
    {
      "line": 108,
      "text": "             )"
    },
    {
      "line": 109,
      "text": "            THEN     'U' --变更"
    },
    {
      "line": 110,
      "text": "            ELSE     'S' --无变更"
    },
    {
      "line": 111,
      "text": "            END AS DATA_TYPE"
    },
    {
      "line": 112,
      "text": "FROM  (SELECT * FROM T03_AMS_FND_TRD_ACCT"
    },
    {
      "line": 113,
      "text": "        WHERE SRC_TBL ='ODATA_N_STA.S_TACCONET'   --只对比ODATA_N_STA.S_TACCONET表的数据"
    },
    {
      "line": 114,
      "text": "          AND BUSI_DATE=default.pretradedate('${data_day_str}',1)"
    },
    {
      "line": 115,
      "text": "      )A"
    },
    {
      "line": 116,
      "text": "FULL OUTER JOIN TEMP.T03_AMS_FND_TRD_ACCT_TEMP_STA009 B"
    },
    {
      "line": 117,
      "text": "ON    A.AGT_ID=B.AGT_ID1"
    },
    {
      "line": 118,
      "text": "AND   A.AGT_MODIFR=B.AGT_MODIFR1"
    },
    {
      "line": 119,
      "text": ";"
    },
