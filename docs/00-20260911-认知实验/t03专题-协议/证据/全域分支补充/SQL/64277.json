    },
    {
      "line": 76,
      "text": "SELECT"
    },
    {
      "line": 77,
      "text": "     SECU_EXT_ACCID                               AS LVL1_SCR_ACCT_AGT_ID         --一级证券账户协议编号"
    },
    {
      "line": 78,
      "text": "    ,'1010201'                                    AS LVL1_SCR_ACCT_AGT_MODIFR     --一级证券账户协议修饰符"
    },
    {
      "line": 79,
      "text": "    ,ACCID                                        AS LVL2_SCR_ACCT_AGT_ID         --二级证券账户协议编号"
    },
    {
      "line": 80,
      "text": "    , '1010202'                                   AS LVL2_SCR_ACCT_AGT_MODIFR     --二级证券账户协议修饰符"
    },
    {
      "line": 81,
      "text": "    ,I_CODE                                       AS PRD_ID                       --产品编号"
    },
    {
      "line": 82,
      "text": "    ,''                                           AS SRC_PRD_CATE_CD              --源产品类别代码"
    },
    {
      "line": 83,
      "text": "    ,CASE WHEN LS = 'L' THEN 'LONG'"
    },
    {
      "line": 84,
      "text": "          WHEN LS = 'S' THEN 'SHOR'"
    },
    {
      "line": 85,
      "text": "          ELSE LS END                             AS LONG_SHOR_CLAS               --多空分类"
    },
    {
      "line": 86,
      "text": "    ,A_TYPE                                       AS HOLD_TYPE_CD                 --持仓类型代码"
    },
    {
      "line": 87,
      "text": "    ,NVL(DW_CD_VAL,M_TYPE)                        AS EXCH_TYPE_CD                 --市场代码"
    },
    {
      "line": 88,
      "text": "    ,VIRTUAL_ACCID                                AS VRTL_ID                      --虚拟ID"
    },
    {
      "line": 89,
      "text": "    ,PS_L_AMOUNT                                  AS LONG_VOL                     --多头余额"
    },
    {
      "line": 90,
      "text": "    ,PS_L_REC_AMOUNT                              AS LONG_RCVB_VOL                --多头应收额"
    },
    {
      "line": 91,
      "text": "    ,PS_L_PAY_AMOUNT                              AS LONG_PAYB_VOL                --多头应付额"
    },
    {
      "line": 92,
      "text": "    ,PS_L_QUO_AMOUNT                              AS LONG_LMT                     --多头额度"
    },
    {
      "line": 93,
      "text": "    ,PS_L_AVAAMOUNT                               AS LONG_CAN_SELL                --多头可卖数"
    },
    {
      "line": 94,
      "text": "    ,PS_L_FREAMOUNT                               AS LONG_FRZ_VOL                 --多头冻结数"
    },
    {
      "line": 95,
      "text": "    ,PS_L_MARGIN_USED                             AS LONG_MARG_OCCP               --多头保证金占用"
    },
    {
      "line": 96,
      "text": "    ,PS_L_COST                                    AS LONG_COST                    --非逐日多头成本"
    },
    {
      "line": 97,
      "text": "    ,PS_L_COST_NOT_FEE                            AS LONG_COST_NO_FEE             --不含费用非逐日多头成本"
    },
    {
      "line": 98,
      "text": "    ,PS_L_ACTUAL_PL                               AS LONG_ACTL_PRFT               --非逐日多头实际损益"
    },
    {
      "line": 99,
      "text": "    ,PS_L_COST_D                                  AS LONG_COST_MTM                --逐日多头成本"
    },
    {
      "line": 100,
      "text": "    ,PS_L_ACTUAL_PL_D                             AS LONG_ACTL_PRFT_MTM           --逐日多头实际损益"
    },
    {
      "line": 101,
      "text": "    ,PS_L_COST_T1                                 AS LONG_COST_T1                 --多头T+1成本"
    },
    {
      "line": 102,
      "text": "    ,PS_L_COST_NETPRICE                           AS LONG_COST_NET_PRIC           --多头净价成本"
    },
    {
      "line": 103,
      "text": "    ,PS_L_COST_CHARGE                             AS BEGN_LONG_COST_CHRG          --期初多头成本占资费用"
    },
    {
      "line": 104,
      "text": "    ,PS_S_AMOUNT                                  AS SHOR_VOL                     --空头余额"
    },
    {
      "line": 105,
      "text": "    ,PS_S_REC_AMOUNT                              AS SHOR_RCVB_VOL                --空头应收额"
    },
    {
      "line": 106,
      "text": "    ,PS_S_PAY_AMOUNT                              AS SHOR_PAYB_VOL                --空头应付额"
    },
    {
