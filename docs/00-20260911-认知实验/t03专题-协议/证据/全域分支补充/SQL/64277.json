    },
    {
      "line": 110,
      "text": "    ,PS_S_MARGIN_USED                             AS SHOR_MARG_OCCP               --空头保证金占用"
    },
    {
      "line": 111,
      "text": "    ,PS_S_COST                                    AS SHOR_COST                    --非逐日空头成本"
    },
    {
      "line": 112,
      "text": "    ,PS_S_COST_NOT_FEE                            AS SHOR_COST_NO_FEE             --不含费用非逐日空头成本"
    },
    {
      "line": 113,
      "text": "    ,PS_S_ACTUAL_PL                               AS SHOR_ACTL_PRFT               --非逐日空头实际损益"
    },
    {
      "line": 114,
      "text": "    ,PS_L_COST_T1_REAL                            AS BEGN_LONG_COST_MTM           --逐日期初空头成本"
    },
    {
      "line": 115,
      "text": "    ,PS_S_COST_D                                  AS SHOR_COST_MTM                --逐日空头成本"
    },
    {
      "line": 116,
      "text": "    ,PS_S_ACTUAL_PL_D                             AS SHOR_ACTL_PRFT_MTM           --逐日空头实际损益"
    },
    {
      "line": 117,
      "text": "    ,PS_L_FRE_BF_AMOUNT                           AS FUTR_SCR_BEGN_IMPA_VOL       --期货保证券出入库期初质押数量"
    },
    {
      "line": 118,
      "text": "    ,PS_L_FRE_SWAP_AMOUNT                         AS SWAP_SCR_BEGN_IMPA_VOL       --互换保证券出入库期初质押数量"
    },
    {
      "line": 119,
      "text": "    ,PS_L_FRE_QR_AMOUNT                           AS QRP_SCR_BEGN_IMPA_VOL        --报价回购出入库期初质押数量"
    },
    {
      "line": 120,
      "text": "    ,PS_UPDATETIME                                AS UPD_TIME                     --更新时间"
    },
    {
      "line": 121,
      "text": "    ,END_DATE                                     AS END_DATE                     --失效时间"
    },
    {
      "line": 122,
      "text": "    ,'XIR'                                        AS DATA_SRC_CD                  --数据来源代码"
    },
    {
      "line": 123,
      "text": "    ,UPPER('${filename}')                    AS TASK_NAME                    --任务名"
    },
    {
      "line": 124,
      "text": "    ,'${data_day_str}'                       AS DATA_ETL_DATE                --数据加载日期"
    },
    {
      "line": 125,
      "text": "    ,'${data_day_str}'                       AS DATA_UPT_DATE                --数据更新日期"
    },
    {
      "line": 126,
      "text": "    ,'${data_today}'                         AS DATA_TIME                    --数据时间"
    },
    {
      "line": 127,
      "text": "    ,'ODATA_N_XIR.T_TTRD_ACC_BALANCE_SECU_HIS'    AS SRC_TBL                      --源表"
    },
    {
      "line": 128,
      "text": "    ,BEG_DATE                                     AS BUSI_DATE                    --业务日期"
    },
    {
      "line": 129,
      "text": "FROM (SELECT * FROM ODATA_N_XIR.T_TTRD_ACC_BALANCE_SECU_HIS WHERE BUSI_DATE >=DEFAULT.ADD_MONTHS('${data_day_str}',-1))A"
    },
    {
      "line": 130,
      "text": " LEFT JOIN ("
    },
    {
      "line": 131,
      "text": "         SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 132,
      "text": "           FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 133,
      "text": "          WHERE TGT_TAB_NAME = 'T03_XIR_LVL2_SCR_HOLD_ADTNL'"
    },
    {
      "line": 134,
      "text": "            AND TGT_TAB_FLD  = 'Exch_Type_Cd'"
    },
    {
      "line": 135,
      "text": "            AND SRC_TAB_NAME = 'TTRD_ACC_BALANCE_SECU_HIS'"
    },
    {
      "line": 136,
      "text": "            AND SRC_FLD_NAME = 'M_TYPE'"
    },
    {
      "line": 137,
      "text": "            AND SRC_SYS_NAME='XIR')B"
    },
    {
      "line": 138,
      "text": "   ON      A.M_TYPE =B.SRC_CD_VAL                  --M_TYPE 转码"
    },
    {
      "line": 139,
      "text": " "
    },
    {
      "line": 140,
      "text": ";"
