    {
      "line": 51,
      "text": "--Group1: Source Table:[ODATA_N_FAP.F_INVEST_PLAN:实盘组合表] "
    },
    {
      "line": 52,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 53,
      "text": "SELECT"
    },
    {
      "line": 54,
      "text": "     FUNDACCOUNT                                       AS  Agt_Id                  --协议编号"
    },
    {
      "line": 55,
      "text": "    ,'10201'                                           AS  Agt_Modifr              --协议修饰符"
    },
    {
      "line": 56,
      "text": "    ,CONCAT('FAS-S-',STRATEGYID)                       AS  Trc_Strg_Prd_Id         --跟踪策略产品编号"
    },
    {
      "line": 57,
      "text": "    ,CONCAT('FAS-P-',BINDPORTID)                       AS  Ivst_Advs_Comb_Prd_Id   --投顾组合产品编号"
    },
    {
      "line": 58,
      "text": "    ,ID                                                AS  Src_Firm_Comb_Id        --源实盘组合编号"
    },
    {
      "line": 59,
      "text": "    ,NAME                                              AS  Comb_Name               --组合名称"
    },
    {
      "line": 60,
      "text": "    ,CREATEAT                                          AS  Comb_Create_Time        --组合创建时间"
    },
    {
      "line": 61,
      "text": "    ,ENDAT                                             AS  Comb_Exp_Time           --组合到期时间"
    },
    {
      "line": 62,
      "text": "    ,STATUS                                            AS  Comb_Stat_Cd            --组合状态代码"
    },
    {
      "line": 63,
      "text": "    ,CLIENTID                                          AS  Shr_Holder_Pty_Id       --份额持有人编号"
    },
    {
      "line": 64,
      "text": "    ,ASSETUNITID                                       AS  Ast_Unit_Id             --资产单元编号"
    },
    {
      "line": 65,
      "text": "    ,AMOUNT                                            AS  Fir_Tran_Amt            --首次转入金额"
    },
    {
      "line": 66,
      "text": "    ,PTYPE                                             AS  Frim_Comb_Type_Cd       --实盘组合类型代码"
    },
    {
      "line": 67,
      "text": "    ,UPDATEAT                                          AS  Upd_Time                --更新时间"
    },
    {
      "line": 68,
      "text": "    ,OTHER                                             AS  Oth_Info                --其他信息"
    },
    {
      "line": 69,
      "text": "    ,PERIOD                                            AS  Ivst_Advs_Comb_Cyc      --投顾组合期限"
    },
    {
      "line": 70,
      "text": "    ,RECOMMEND                                         AS  Recmd_Emp_Id            --推荐员工编号"
    },
    {
      "line": 71,
      "text": "    ,QUITAT                                            AS  Comb_Quit_Time          --组合退出时间"
    },
    {
      "line": 72,
      "text": "    ,RUNAT                                             AS  Comb_Run_Time           --组合开始运行时间"
    },
    {
      "line": 73,
      "text": "    ,RENEW                                             AS  Comb_Cont_Flag          --组合续期标志"
    },
    {
      "line": 74,
      "text": "    ,CLOSEDAT                                          AS  Comb_Clos_Time          --组合关闭时间"
    },
    {
      "line": 75,
      "text": "    ,QUITWAY                                           AS  Comb_Quit_Method_Cd     --组合退出方式代码"
    },
    {
      "line": 76,
      "text": "    ,TRANSINAT                                         AS  Fnd_Tran_Time           --资金转入时间"
    },
    {
      "line": 77,
      "text": "    ,FROZENSTATUS                                      AS  Frz_Flag                --冻结标志"
    },
    {
      "line": 78,
      "text": "    ,PARTNERID                                         AS  Ivst_Advs_Org           --投顾机构"
    },
    {
      "line": 79,
      "text": "    ,REDEEMLIMITSTR                                    AS  Trd_Lmt_Info            --交易限制信息"
    },
    {
      "line": 80,
      "text": "    ,'${data_src_cd}'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 81,
      "text": "    ,'${filename}'                                AS  Task_Name               --任务名"
    },
    {
      "line": 82,
      "text": "    ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 83,
      "text": "    ,'${data_today_str}'                          AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 84,
      "text": "    ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 85,
      "text": "    ,STRATEGYNAME                                      AS  Trc_Strg_Prd_Name       --跟踪策略产品名称"
    },
    {
      "line": 86,
      "text": "    ,BINDPORTNAME                                      AS  Ivst_Advs_Comb_Prd_Name --投顾组合产品名称"
    },
