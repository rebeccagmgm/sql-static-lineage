    {
      "line": 33,
      "text": "WITH TMP_T_TTRD_ACC_CASH_EXT AS("
    },
    {
      "line": 34,
      "text": "SELECT A.ACCID,A.ACCNAME,A.EXHACC,A.ACCTYPE,A.CUSTODIAN_BANK,A.MARKETS,A.STATUS,A.BUSI_DATE "
    },
    {
      "line": 35,
      "text": "         FROM ${src_table_xir}.T_TTRD_ACC_CASH_EXT A"
    },
    {
      "line": 36,
      "text": "        WHERE A.BUSI_DATE='${data_day_str}'"
    },
    {
      "line": 37,
      "text": "      ),"
    },
    {
      "line": 38,
      "text": "TMP_MARKETS AS("
    },
    {
      "line": 39,
      "text": "SELECT D.ACCID,"
    },
    {
      "line": 40,
      "text": "        concat_ws(',',collect_set(NVL(C.DW_CD_VAL,D.MARKETS))) as MARKETS"
    },
    {
      "line": 41,
      "text": "FROM(SELECT A.ACCID, TRIM(D.MARKETS) AS  MARKETS"
    },
    {
      "line": 42,
      "text": "         FROM TMP_T_TTRD_ACC_CASH_EXT A"
    },
    {
      "line": 43,
      "text": "              lateral view explode(split(MARKETS, ',')) D AS MARKETS "
    },
    {
      "line": 44,
      "text": "        )D"
    },
    {
      "line": 45,
      "text": " LEFT JOIN ("
    },
    {
      "line": 46,
      "text": "         SELECT DISTINCT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 47,
      "text": "           FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 48,
      "text": "          WHERE TGT_TAB_NAME = 'T03_XIR_FND_ACCT'"
    },
    {
      "line": 49,
      "text": "            AND TGT_TAB_FLD  = 'Exch_Type_Cd'"
    },
    {
      "line": 50,
      "text": "            AND SRC_TAB_NAME = 'TTRD_ACC_CASH_EXT'"
    },
    {
      "line": 51,
      "text": "            AND SRC_FLD_NAME = 'MARKETS'"
    },
    {
      "line": 52,
      "text": "            AND SRC_SYS_NAME='XIR')C"
    },
    {
      "line": 53,
      "text": "   ON D.MARKETS =C.SRC_CD_VAL               "
    },
    {
      "line": 54,
      "text": "GROUP BY D.ACCID"
    },
    {
      "line": 55,
      "text": ")"
    },
    {
