    {
      "line": 54,
      "text": "INSERT OVERWRITE TABLE T03_CVS_MKTHOLD_ACCT PARTITION(SRC_TBL='ODATA_N_CVS.A_T_FL_SEC_ACC',BUSI_DATE='2026-05-21')"
    },
    {
      "line": 55,
      "text": "SELECT"
    },
    {
      "line": 56,
      "text": "FID                                               AS  Mkthold_Acct_Agt_ID     --股东账户协议编号"
    },
    {
      "line": 57,
      "text": ",concat('10112-',FMARKET_CODE)                                      AS  Mkthold_Acct_Agt_Modifr --股东账户协议编号修饰符        '10112-'||FMARKET_CODE"
    },
    {
      "line": 58,
      "text": ",FPARENT_ID                                        AS  Prnt_Acct               --上级账户"
    },
    {
      "line": 59,
      "text": ",FCLASSES                                          AS  Acct_Clas_Cd            --账户分类代码"
    },
    {
      "line": 60,
      "text": ",FCODE                                             AS  Mkthold_Card_No         --股东卡编号"
    },
    {
      "line": 61,
      "text": ",FNAME                                             AS  Acct_Name               --账户名称"
    },
    {
      "line": 62,
      "text": ",FLEVEL                                            AS  Acct_Grad               --账户级别"
    },
    {
      "line": 63,
      "text": ",NVL(B.DW_CD_VAL,A.FMARKET_CODE)                                     AS  Exch_Type_Cd            --市场代码                    需代码标准化，已维护"
    },
    {
      "line": 64,
      "text": ",FACCOUNT_ATTR                                     AS  Acct_Attr               --账户属性"
    },
    {
      "line": 65,
      "text": ",FPRODUCT_ID                                       AS  Prd_Id                  --产品编号"
    },
    {
      "line": 66,
      "text": ",FPUBLIC_PRIVATE_TYPE                              AS  Attr_Type_Cd            --属性类型代码"
    },
    {
      "line": 67,
      "text": ",FTYPE                                             AS  Acct_Type_Cd            --账户类型代码"
    },
    {
      "line": 68,
      "text": ",FBANK_BOND_ACCOUNT_TYPE                           AS  Ib_Mkt_Bond_Acct_Type_cd--银行间债券账户类别代码"
    },
    {
      "line": 69,
      "text": ",FTRUST_FUND_ACCOUNT                               AS  Trust_Prd_Fnd_Acct_Flag --信托产品基金专户标志"
    },
    {
      "line": 70,
      "text": ",FLEAF                                             AS  Det_Acct_Flag           --明细账户标志"
    },
    {
      "line": 71,
      "text": ",FINVEST_TYPE                                      AS  Ivst_Clas_Cd            --投资分类代码"
    },
    {
      "line": 72,
      "text": ",FSTART_DATE                                       AS  Enable_Date             --启用日期"
    },
    {
      "line": 73,
      "text": ",FEND_DATE                                         AS  Trmt_Date               --终止日期"
    },
    {
      "line": 74,
      "text": ",FORIGIN                                           AS  Acct_Data_Src_Cd        --账号数据来源代码"
    },
    {
      "line": 75,
      "text": ",FCREATOR_ID                                       AS  Create_User_No          --创建人编号"
    },
    {
      "line": 76,
      "text": ",FCREATE_TIME                                      AS  Create_Time             --创建时间"
    },
    {
      "line": 77,
      "text": ",FLAST_EDITOR_ID                                   AS  Last_Modif_User_No      --最后修改人编号"
    },
    {
      "line": 78,
      "text": ",FLAST_EDIT_TIME                                   AS  Last_Modif_Time         --最后修改时间"
    },
    {
      "line": 79,
      "text": ",FCHECKED                                          AS  Appr_Flag               --审核标志"
    },
    {
      "line": 80,
      "text": ",FCHECKER_ID                                       AS  Appr_User_No            --审核人编号"
    },
    {
      "line": 81,
      "text": ",FCHECK_TIME                                       AS  Appr_Time               --审核时间"
    },
    {
      "line": 82,
      "text": ",FDELETED                                          AS  Logic_Del_Flag          --逻辑删除标志"
    },
    {
      "line": 83,
      "text": ",FDELETE_USER_ID                                   AS  Del_User_No             --删除人编号"
    },
    {
      "line": 84,
      "text": ",FMARK_DELETE_TIME                                 AS  Logic_Del_Time          --逻辑删除时间"
    },
    {
      "line": 85,
      "text": ",FREL_ID                                           AS  Data_Modifr_Bef_No      --数据修改前编号"
    },
    {
      "line": 86,
      "text": ",FEDIT_REASON                                      AS  Edit_Rsn                --编辑原因"
    },
    {
      "line": 87,
      "text": ",FDELETE_REASON                                    AS  Del_Rsn                 --删除原因"
    },
    {
      "line": 88,
      "text": ",NVL(C.DW_CD_VAL,A.FSECSTATUS)                                        AS  Clos_Flag               --销户标志                    需代码标准化，已维护"
    },
    {
      "line": 89,
      "text": ",'CVS'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 90,
      "text": ",'PDATA_N.T03_CVS_MKTHOLD_ACCT_CVS056'                                AS  Task_Name               --任务名"
    },
    {
      "line": 91,
      "text": ",'2026-05-21'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 92,
      "text": ",'2026-05-22'                          AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 93,
      "text": ",'2026-05-22 08:29:43'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 94,
      "text": "FROM   (SELECT *  FROM ODATA_N_CVS.A_T_FL_SEC_ACC WHERE  BUSI_DATE='2026-05-21' )A"
    },
    {
      "line": 95,
      "text": "LEFT JOIN ("
    },
    {
      "line": 96,
      "text": "SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 97,
      "text": "FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 98,
      "text": "WHERE TGT_TAB_NAME = 'T03_CVS_MKTHOLD_ACCT'"
    },
    {
      "line": 99,
      "text": "AND TGT_TAB_FLD  = 'Exch_Type_Cd'"
    },
    {
      "line": 100,
      "text": "AND SRC_TAB_NAME = 'A_T_FL_SEC_ACC'"
    },
    {
      "line": 101,
      "text": "AND SRC_FLD_NAME = 'FMARKET_CODE'"
    },
    {
      "line": 102,
      "text": "AND SRC_SYS_NAME='CVS')B"
    },
    {
      "line": 103,
      "text": "ON      A.FMARKET_CODE =B.SRC_CD_VAL                  --M_TYPE 转码"
    },
    {
      "line": 104,
      "text": "LEFT JOIN ("
    },
    {
      "line": 105,
      "text": "SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 106,
      "text": "FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 107,
      "text": "WHERE TGT_TAB_NAME = 'T03_CVS_MKTHOLD_ACCT'"
    },
    {
      "line": 108,
      "text": "AND TGT_TAB_FLD  = 'Clos_Flag'"
    },
    {
      "line": 109,
      "text": "AND SRC_TAB_NAME = 'A_T_FL_SEC_ACC'"
    },
    {
      "line": 110,
      "text": "AND SRC_FLD_NAME = 'FSECSTATUS'"
    },
    {
      "line": 111,
      "text": "AND SRC_SYS_NAME='CVS')C"
    },
    {
      "line": 112,
      "text": "ON      A.FSECSTATUS =C.SRC_CD_VAL                  --M_TYPE 转码"
    },
    {
      "line": 113,
      "text": ";"
    },
