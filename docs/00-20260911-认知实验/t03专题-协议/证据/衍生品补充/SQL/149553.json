      "text": "                AND SRC_TBL IN ('ODATA_N_OIS.G_SAME_COUNTERPARTY')  )A   --历史(昨日)开链数据"
    },
    {
      "line": 69,
      "text": "    FULL OUTER JOIN ${db_temp}.T01_PTY_RELA_H_TEMP_OIS022 B               --当天的数据"
    },
    {
      "line": 70,
      "text": "    ON   NVL(A.Pty_Id          ,'') = NVL(B.Pty_Id1          ,'')"
    },
    {
