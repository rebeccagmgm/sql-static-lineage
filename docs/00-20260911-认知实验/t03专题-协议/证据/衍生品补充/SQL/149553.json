    {
      "line": 34,
      "text": "              WHEN A.IS_PROD_HOLDER IN ('02','03') THEN '210500'"
    },
    {
      "line": 35,
      "text": "              ELSE A.IS_PROD_HOLDER END              AS  Pty_Cate_Cd1            --当事人类别代码       "
    },
    {
      "line": 36,
      "text": "        ,B.CLIENT_ID                               AS  Rela_Pty_Id1            --关联当事人编号       "
    },
    {
