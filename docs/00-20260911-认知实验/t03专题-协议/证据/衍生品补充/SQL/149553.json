    {
      "line": 59,
      "text": "                 (   COALESCE(A.Rela_Pty_Id             ,'')   <> COALESCE(B.Rela_Pty_Id1            ,'')"
    },
    {
      "line": 60,
      "text": "                  OR COALESCE(A.Rela_Pty_Cate_Cd        ,'')   <> COALESCE(B.Rela_Pty_Cate_Cd1       ,'')"
    },
    {
      "line": 61,
      "text": "             ) THEN 'U'                                                        --当天和历史均存在,除主键外如有字段变更为变更"
    },
    {
      "line": 62,
      "text": "                 ELSE 'S' END AS DATA_TYPE                                         --其他为无变更"
    },
    {
      "line": 63,
      "text": "    FROM   (  SELECT"
