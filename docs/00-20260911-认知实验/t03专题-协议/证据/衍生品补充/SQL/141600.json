      "text": "        A.*,B.*"
    },
    {
      "line": 50,
      "text": "       ,CASE WHEN A.AGT_GRP_ID IS NULL AND B.AGT_GRP_ID1 IS NOT NULL THEN 'I'           --当天不存在历史的数据为新增"
    },
    {
      "line": 51,
      "text": "             WHEN A.AGT_GRP_ID IS NOT NULL AND B.AGT_GRP_ID1 IS NULL THEN 'D'           --历史不存在当天的数据为删除"
    },
    {
      "line": 52,
      "text": "             WHEN A.AGT_GRP_ID IS NOT NULL AND B.AGT_GRP_ID1 IS NOT NULL AND"
    },
    {
      "line": 53,
      "text": "             ("
    },
    {
      "line": 54,
      "text": "                  COALESCE(A.AGT_GRP_CATE_CD         ,'')   <> COALESCE(B.AGT_GRP_CATE_CD1        ,'')"
    },
    {
      "line": 55,
      "text": "               OR COALESCE(A.AGT_ID                  ,'')   <> COALESCE(B.AGT_ID1                 ,'')"
    },
    {
      "line": 56,
      "text": "               OR COALESCE(A.AGT_MODIFR              ,'')   <> COALESCE(B.AGT_MODIFR1             ,'')"
    },
    {
      "line": 57,
      "text": "             ) THEN 'U'                                                        --当天和历史均存在,除主键外如有字段变更为变更"
    },
    {
      "line": 58,
      "text": "             ELSE 'S' END AS DATA_TYPE                                         --其他为无变更"
    },
    {
      "line": 59,
      "text": "FROM   (  SELECT"
