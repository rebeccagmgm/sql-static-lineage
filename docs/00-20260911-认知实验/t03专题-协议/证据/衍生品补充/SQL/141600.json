      "text": "            AND END_DATE  > '${data_day_str}'"
    },
    {
      "line": 64,
      "text": "            AND SRC_TBL IN ('ODATA_N_TIT.D_MARGIN_ACCT_BUNDLE_MAPPING')  )A   --历史(昨日)开链数据"
    },
    {
      "line": 65,
      "text": "FULL OUTER JOIN ${db_temp}.T03_AGT_AGT_GRP_RELA_H_TEMP_TIT249 B               --当天的数据"
    },
    {
      "line": 66,
      "text": "ON   NVL(A.AGT_GRP_ID              ,'') = NVL(B.AGT_GRP_ID1              ,'')"
