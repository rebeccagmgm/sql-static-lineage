      "text": "AND  NVL(A.AGT_AGT_GRP_RELA_TYPE_CD,'') = NVL(B.AGT_AGT_GRP_RELA_TYPE_CD1,'')"
    },
    {
      "line": 68,
      "text": "AND  NVL(A.AGT_ID                  ,'') = NVL(B.AGT_ID1                  ,'')"
    },
    {
      "line": 69,
      "text": "AND  NVL(A.AGT_MODIFR              ,'') = NVL(B.AGT_MODIFR1              ,'')"
    },
    {
      "line": 70,
