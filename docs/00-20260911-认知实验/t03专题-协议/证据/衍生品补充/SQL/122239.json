      "text": ""
    },
    {
      "line": 50,
      "text": "DROP TABLE IF EXISTS ${db_temp}.T03_OTC_DERI_AGT_RELA_ADTNL_INFO_MID_TIT174;"
    },
    {
      "line": 51,
      "text": "CREATE TABLE ${db_temp}.T03_OTC_DERI_AGT_RELA_ADTNL_INFO_MID_TIT174"
    },
    {
      "line": 52,
      "text": "AS"
    },
    {
      "line": 53,
      "text": "SELECT"
    },
    {
      "line": 54,
      "text": "       A.*,B.*"
    },
    {
      "line": 55,
      "text": "       ,CASE WHEN A.Book_Agt_Id IS NULL     AND B.Book_Agt_Id1 IS NOT NULL THEN 'I'           --当天不存在历史的数据为新增"
    },
    {
      "line": 56,
      "text": "             WHEN A.Book_Agt_Id IS NOT NULL AND B.Book_Agt_Id1 IS NULL THEN 'D'           --历史不存在当天的数据为删除"
    },
    {
      "line": 57,
      "text": "             WHEN A.Book_Agt_Id IS NOT NULL AND B.Book_Agt_Id1 IS NOT NULL AND"
    },
    {
      "line": 58,
      "text": "             (   COALESCE(A.Rela_Book_Agt_Id        ,'')   <> COALESCE(B.Rela_Book_Agt_Id1       ,'')"
    },
    {
      "line": 59,
      "text": "              OR COALESCE(A.Rela_Book_Agt_Modifr    ,'')   <> COALESCE(B.Rela_Book_Agt_Modifr1   ,'')"
    },
    {
      "line": 60,
      "text": "              OR COALESCE(A.Prft_Dir_Tran_Cd        ,'')   <> COALESCE(B.Prft_Dir_Tran_Cd1       ,'')"
    },
    {
      "line": 61,
      "text": "              OR COALESCE(A.Src_Book_Map_Id         ,'')   <> COALESCE(B.Src_Book_Map_Id1        ,'')"
    },
    {
      "line": 62,
      "text": "             ) THEN 'U'                                                        --当天和历史均存在,除主键外如有字段变更为变更"
    },
    {
      "line": 63,
      "text": "             ELSE 'S' END AS DATA_TYPE                                         --其他为无变更"
    },
    {
      "line": 64,
      "text": "FROM   (  SELECT"
    },
    {
      "line": 65,
      "text": "            *"
    },
    {
      "line": 66,
      "text": "          FROM  T03_OTC_DERI_AGT_RELA_ADTNL_INFO"
    },
    {
      "line": 67,
      "text": "          WHERE STRT_DATE <='${data_day_str}'"
    },
    {
      "line": 68,
      "text": "            AND END_DATE  > '${data_day_str}'"
    },
    {
      "line": 69,
      "text": "            AND SRC_TBL IN ('ODATA_N_TIT.D_BK_BOOK_MAPPING')  )A   --历史(昨日)开链数据"
    },
    {
      "line": 70,
      "text": "FULL OUTER JOIN ${db_temp}.T03_OTC_DERI_AGT_RELA_ADTNL_INFO_TEMP_TIT174 B               --当天的数据"
    },
    {
      "line": 71,
      "text": "ON   NVL(A.Book_Agt_Id          ,'')= NVL(B.Book_Agt_Id1          ,'')  "
    },
    {
      "line": 72,
      "text": "AND  NVL(A.Book_Agt_Modifr      ,'')= NVL(B.Book_Agt_Modifr1      ,'')      "
    },
    {
      "line": 73,
      "text": "AND  NVL(A.Agt_Rela_Type_Cd     ,'')= NVL(B.Agt_Rela_Type_Cd1     ,'')            "
    },
    {
      "line": 74,
      "text": "AND  NVL(A.Rela_Book_Agt_Id     ,'')= NVL(B.Rela_Book_Agt_Id1     ,'')   "
    },
    {
      "line": 75,
      "text": ";"
    },
