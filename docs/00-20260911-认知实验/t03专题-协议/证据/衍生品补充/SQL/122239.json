      "text": "    ,DIRECTION                               AS  Prft_Dir_Tran_Cd1       --盈亏方向转换代码"
    },
    {
      "line": 40,
      "text": "    ,'${data_src_cd}'                   AS  Data_Src_Cd1            --数据来源代码"
    },
    {
      "line": 41,
      "text": "    ,'${src_table}'                     AS  Src_Tbl1                --源表"
    },
    {
      "line": 42,
      "text": "    ,'${filename}'                      AS  Task_Name1              --任务名"
    },
    {
      "line": 43,
      "text": "    ,'${src_table}'                     AS  Real_Src_Tbl1           --真实源表"
    },
    {
      "line": 44,
      "text": "    ,ID                                      AS  Src_Book_Map_Id1        --源账簿映射编号"
    },
    {
      "line": 45,
      "text": "FROM (SELECT * FROM ODATA_N_TIT.D_BK_BOOK_MAPPING WHERE BUSI_DATE ='${data_day_str}') A"
    },
    {
      "line": 46,
      "text": ""
    },
    {
