    {
      "line": 31,
      "text": "--Group1: Source Table:[ODATA_N_TIT.D_BK_BOOK_MAPPING：场外衍生品账簿协议关系附加信息]"
    },
    {
      "line": 32,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 33,
      "text": "SELECT"
    },
    {
      "line": 34,
      "text": "     KEY_BOOK_ID_FROM                        AS  Book_Agt_Id1            --协议编号"
    },
    {
      "line": 35,
      "text": "    ,'20411'                                 AS  Book_Agt_Modifr1        --协议修饰符"
    },
    {
      "line": 36,
      "text": "    ,'N05'                                   AS  Agt_Rela_Type_Cd1       --协议关系类型代码                 'N05' --账簿协议与账簿协议"
    },
    {
      "line": 37,
      "text": "    ,KEY_BOOK_ID_TO                          AS  Rela_Book_Agt_Id1       --关联协议编号    "
