    {
      "line": 50,
      "text": "--Group1.: Source Table:[ODATA_N_TIT.D_REF_OP_DEAL_AUTOCALL_KODATE:场外交易-期权敲出观察日及票息信息] "
    },
    {
      "line": 51,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 52,
      "text": "SELECT"
    },
    {
      "line": 53,
      "text": "     A.KEY_OTC_TRADE_ID                                AS  Opt_Comp_Agt_Id         --期权合约协议编号"
    },
    {
      "line": 54,
      "text": "    ,'20207'                                           AS  Opt_Comp_Agt_Modifr     --期权合约协议修饰符"
    },
    {
      "line": 55,
      "text": "    ,'KO'                                              AS  Encb_Type               --障碍类型                     'KO' --敲出"
    },
    {
      "line": 56,
      "text": "    ,SUBSTR(OBS_DATE,1,10)                             AS  Obsv_Date               --观察日期      "
    },
    {
      "line": 57,
      "text": "    ,SUBSTR(EARLY_TERMINATION_DATE,1,10)               AS  Erly_Trmt_Date          --提前终止日期  "
    },
    {
      "line": 58,
      "text": "    ,UP_KO_BARRIER                                     AS  Up_Encb_Val             --上障碍值      "
    },
    {
      "line": 59,
      "text": "    ,UP_KO_BARRIER_PCT                                 AS  Up_Encb_Pct             --上障碍百分比  "
    },
    {
      "line": 60,
      "text": "    ,DOWN_KO_BARRIER                                   AS  Down_Encb_Val           --下障碍值      "
    },
    {
      "line": 61,
      "text": "    ,DOWN_KO_BARRIER_PCT                               AS  Down_Encb_Pct           --下障碍百分比  "
    },
    {
      "line": 62,
      "text": "    ,''                                                AS  Rset_Encb_Val           --重置障碍值    "
    },
    {
      "line": 63,
      "text": "    ,''                                                AS  Rset_Encb_Pct           --重置障碍百分比"
    },
    {
      "line": 64,
      "text": "    ,COUPON_RATE                                       AS  Coup_Rate               --票息率        "
    },
    {
      "line": 65,
      "text": "    ,NETTING_COUPON                                    AS  Real_Bal_Coup           --轧差票息      "
    },
    {
      "line": 66,
      "text": "    ,NETTING_COUPON_RATE                               AS  Real_Bal_Coup_Rate      --轧差票息率    "
    },
    {
      "line": 67,
      "text": "    ,LAYERING_COUPON                                   AS  Clasf_Coup              --分档票息      "
    },
    {
      "line": 68,
      "text": "    ,SUBSTR(COUPON_PAYMENT_DATE,1,10)                  AS  Coup_Pay_Date           --票息支付日期  "
    },
    {
      "line": 69,
      "text": "    ,INTEREST_MONTHS                                   AS  Inta_Mths               --计息月数      "
    },
    {
      "line": 70,
      "text": "    ,INTEREST_DAYS                                     AS  Inta_Days               --计息天数      "
