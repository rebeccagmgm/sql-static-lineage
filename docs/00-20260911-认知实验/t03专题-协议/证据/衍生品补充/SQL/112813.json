      "line": 81,
      "text": "    ,'${src_table}'                               AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 82,
      "text": "    ,''                                                AS  Ko_Lvl                  --敲出水平"
    },
    {
      "line": 83,
      "text": "    ,''                                                AS  Ko_Lvl_Pric             --敲出水平价格"
    },
    {
      "line": 84,
      "text": "    ,''                                                AS  Prtc_Rate               --参与率"
    },
    {
      "line": 85,
      "text": "    ,''                                                AS  Ki_Date                 --敲入日期"
    },
    {
      "line": 86,
      "text": "FROM   (SELECT *  FROM ${src_table} WHERE  BUSI_DATE='${data_day_str}' )A"
    },
    {
