    {
      "line": 151,
      "text": "--Group5: Source Table:[ODATA_N_TIT.D_REF_FAST_TRS:极速互换合约要素表] "
    },
    {
      "line": 152,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 153,
      "text": "SELECT"
    },
    {
      "line": 154,
      "text": "     A.KEY_OTC_TRADE_ID                                AS  Swap_Comp_Agt_Id        --互换合约协议编号        "
    },
    {
      "line": 155,
      "text": "    ,'20206'                                           AS  Swap_Comp_Agt_Modifr    --互换合约协议修饰符      "
    },
    {
      "line": 156,
      "text": "    ,IF(NVL(TRIM(KEY_CTPTY_ID),'')='','',CONCAT('TIT060-',KEY_CTPTY_ID))"
    },
    {
      "line": 157,
      "text": "                                                       AS  Cutp_Pty_Id             --交易对手当事人编号      "
    },
    {
      "line": 158,
      "text": "    ,CONTRACT_CODE                                     AS  Ext_Comp_No             --外部合约编号            "
    },
    {
      "line": 159,
      "text": "    ,''                                                AS  Crrc_Cd                 --币种代码                "
    },
    {
      "line": 160,
      "text": "    ,BUNDLE_ID                                         AS  Comb_Agt_Grp_Id         --组合协议编号            "
    },
    {
      "line": 161,
      "text": "    ,''                                                AS  Comb_Type_Cd            --组合类型代码            "
    },
    {
      "line": 162,
      "text": "    ,TRS_TYPE                                          AS  Swap_Type_Cd            --互换类型代码            "
    },
    {
      "line": 163,
      "text": "    ,IF(NVL(TRIM(SELLER),'')='','',CONCAT('TIT060-',SELLER))     AS  Sler_Cutp_Pty_Id        --销售方交易对手当事人编号"
    },
    {
      "line": 164,
      "text": "    ,PARTY                                             AS  Our_Id_Type_Cd          --我司身份类型代码        "
    },
    {
      "line": 165,
      "text": "    ,CLEARING_HOUSE                                    AS  Clr_Org_Id_Type_Cd      --清算机构身份类型代码    "
    },
    {
      "line": 166,
      "text": "    ,''                                                AS  Ast_Acct_Agt_Id         --资金账户协议编号        "
    },
    {
      "line": 167,
      "text": "    ,''                                                AS  Ast_Acct_Agt_Modify     --资金账户协议修饰符       "
    },
    {
      "line": 168,
      "text": "    ,ACCOUNT_NUMBER                                    AS  Bnk_Acct                --银行账户                "
    },
    {
      "line": 169,
      "text": "    ,BANK_OF_DEPOSIT                                   AS  Bnk_Bod_Name            --银行账户开户行名称      "
    },
    {
      "line": 170,
      "text": "    ,LARGE_PAYMENT_ACCOUNT                             AS  Larg_Amt_Paid_No        --大额支付号              "
    },
    {
      "line": 171,
      "text": "    ,PAYMENT_DATE_DELAY                                AS  Pay_Delay_Days          --兑付日延期天数          "
    },
    {
      "line": 172,
      "text": "    ,''                                                AS  Pay_Date                --兑付日                  "
    },
    {
      "line": 173,
      "text": "    ,TIME_TO_MATURITY                                  AS  Term_Days               --期限天数                "
    },
    {
      "line": 174,
      "text": "    ,''                                                AS  Trd_Date                --交易日期                "
    },
    {
      "line": 175,
      "text": "    ,SUBSTR(START_DATE,1,10)                           AS  Strt_Pric_Date          --期初定价日            "
    },
    {
      "line": 176,
      "text": "    ,SUBSTR(END_DATE,1,10)                             AS  End_Pric_Date           --期末定价日            "
    },
