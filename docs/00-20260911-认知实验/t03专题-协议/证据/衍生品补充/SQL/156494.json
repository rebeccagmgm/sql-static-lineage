      "text": "-- querySql"
    },
    {
      "line": 39,
      "text": "INSERT OVERWRITE TABLE T03_OTC_OPT_COMP_SUB_TRD_OBSV_DATE_ATTR_INFO PARTITION(SRC_TBL='${src_table}')"
    },
    {
      "line": 40,
      "text": "    -----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 41,
      "text": "    --Group2: Source Table:[ODATA_N_TIT.D_REF_OPTION_LIZARD_OBS_DATE:LIZARD观察日信息表] "
    },
    {
      "line": 42,
      "text": "    -----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 43,
      "text": "    SELECT"
    },
    {
      "line": 44,
      "text": "         NVL(C.KEY_OTC_TRADE_ID,'')              AS  Opt_Comp_Agt_Id         --期权合约协议编号  "
    },
    {
      "line": 45,
      "text": "        ,IF(C.KEY_OTC_TRADE_ID IS NULL,'', '20207' )"
    },
    {
      "line": 46,
      "text": "                                                 AS  Opt_Comp_Agt_Modifr     --期权合约协议修饰符"
    },
    {
      "line": 47,
      "text": "        ,B.EXTERNAL_TRADE_ID                     AS  Sub_Trd_Id              --子交易编号        "
    },
    {
      "line": 48,
      "text": "        ,'LIZARD_ATTR'                           AS  Obsv_Date_Attr_Clas_Cd  --观察日属性类型代码  'LIZARD_ATTR' --壁虎期权属性"
    },
    {
      "line": 49,
      "text": "        ,CONCAT('TIT-',A.KEY_INSTRUMENT_ID )     AS  Prd_Id                  --产品编号          "
    },
    {
      "line": 50,
      "text": "        ,A.KEY_INSTRUMENT_ID                     AS  Src_Prd_Id              --源产品编号        "
    },
    {
      "line": 51,
      "text": "        ,SUBSTR(A.OBS_DATE,1,10)                 AS  Obsv_Date               --观察日期          "
    },
    {
      "line": 52,
      "text": "        ,SUBSTR(A.DELIVERY_DATE,1,10)            AS  Pay_Date                --兑付日            "
    },
    {
      "line": 53,
      "text": "        ,SUBSTR(A.EVENT_DATE,1,10)               AS  Knock_In_Date           --敲入日期          "
    },
    {
      "line": 54,
      "text": "        ,A.NETTING_COUPON_RATE                   AS  Real_Bal_Coup_Rate      --轧差票息率        "
    },
    {
      "line": 55,
      "text": "        ,A.COUPON_RATE                           AS  Coup_Rate               --票息率            "
    },
    {
      "line": 56,
      "text": "        ,A.LIZARD_PR                             AS  Prtc_Rate               --参与率            "
    },
    {
      "line": 57,
      "text": "        ,A.LIZARD_LEVEL                          AS  Barr_Pric_Pct           --障碍价格百分比    "
    },
    {
      "line": 58,
      "text": "        ,A.LIZARD_LEVEL_PRICE                    AS  Barr_Pric               --障碍价格          "
    },
    {
      "line": 59,
      "text": "        ,''                                      AS  Up_Barr_Pric_Pct        --上障碍价格百分比  "
    },
    {
      "line": 60,
      "text": "        ,''                                      AS  Up_Barr_Pric            --上障碍价格        "
    },
    {
      "line": 61,
      "text": "        ,''                                      AS  Down_Barr_Pric_Pct      --下障碍价格百分比  "
    },
    {
      "line": 62,
      "text": "        ,''                                      AS  Down_Barr_Pric          --下障碍价格        "
    },
    {
      "line": 63,
      "text": "        ,'${data_src_cd}'                   AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 64,
      "text": "        ,'${filename}'                      AS  Task_Name               --任务名"
    },
    {
      "line": 65,
      "text": "        ,'${data_day_str}'                  AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 66,
      "text": "        ,'${data_today_str}'                AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 67,
      "text": "        ,'${data_today}'                    AS  Data_Time               --数据时间"
    },
    {
      "line": 68,
      "text": "        ,'${src_table}'                     AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 69,
      "text": "    FROM   (SELECT *  FROM ${src_table} WHERE  BUSI_DATE='${data_day_str}' )A"
    },
    {
      "line": 70,
      "text": "    LEFT JOIN  (SELECT EXTERNAL_TRADE_ID,CONTRACT_INS_ID,KEY_INSTRUMENT_ID FROM ODATA_N_TIT.D_REF_INS_OPTION_INFO WHERE BUSI_DATE ='${data_day_str}') B"
    },
    {
      "line": 71,
      "text": "           ON A.KEY_INSTRUMENT_ID=B.KEY_INSTRUMENT_ID"
    },
    {
      "line": 72,
      "text": "    LEFT JOIN (SELECT KEY_OTC_TRADE_ID,KEY_INSTRUMENT_ID FROM ODATA_N_TIT.D_TRD_OTC_TRADE  WHERE BUSI_DATE ='${data_day_str}'  )C"
    },
    {
      "line": 73,
      "text": "           ON B.CONTRACT_INS_ID=C.KEY_INSTRUMENT_ID "
    },
    {
      "line": 74,
      "text": "    ;"
    },
    {
      "line": 75,
      "text": ""
    }
  ]
