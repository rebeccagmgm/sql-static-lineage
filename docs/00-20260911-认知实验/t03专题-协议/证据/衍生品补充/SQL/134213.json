    {
      "line": 42,
      "text": "-- querySql"
    },
    {
      "line": 43,
      "text": "INSERT OVERWRITE TABLE T03_DERI_COMP_SETT_INFO PARTITION(SRC_TBL,BUSI_DATE)"
    },
    {
      "line": 44,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 45,
      "text": "--Group1.: Source Table:[ODATA_N_CSS.E_OTC_SETTLE_JOUR:结算明细表] "
    },
    {
      "line": 46,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 47,
      "text": "SELECT"
    },
    {
      "line": 48,
      "text": "     T1.HANDLE_DATE                                       AS  Hand_Date               --处理日期    "
    },
    {
      "line": 49,
      "text": "    ,T1.CLEAR_DATE                                        AS  Clr_Date                --清算日期    "
    },
    {
      "line": 50,
      "text": "    ,T1.SETTLE_TYPE                                       AS  Sett_Item               --结算事项    "
    },
    {
      "line": 51,
      "text": "    ,T1.CONTRACT_CODE                                     AS  Src_Comp_No             --源合约编号  "
    },
    {
      "line": 52,
      "text": "    ,COALESCE(T2.KEY_OTC_TRADE_ID,T3.KEY_TRADE_COMFIRM_ID)  AS  Agt_Id                  --协议编号    "
    },
    {
      "line": 53,
      "text": "    ,CASE WHEN T4.KEY_OTC_TRADE_ID      IS NOT NULL THEN '20206'"
    },
    {
      "line": 54,
      "text": "          WHEN T5.KEY_OTC_TRADE_ID      IS NOT NULL THEN '20207'"
    },
    {
      "line": 55,
      "text": "          WHEN T3.KEY_TRADE_COMFIRM_ID  IS NOT NULL THEN '20206-KST'"
    },
    {
      "line": 56,
      "text": "          ELSE '' END                                  AS  Agt_Modifr              --协议修饰符  "
    },
    {
      "line": 57,
      "text": "    ,T1.CONTRACT_TYPE                                     AS  Comp_Type               --合约类型    "
    },
    {
      "line": 58,
      "text": "    ,T1.SHORT_NAME                                        AS  Deal_Cutp_Abbr          --交易对手简称"
    },
    {
      "line": 59,
      "text": "    ,T1.TERMINATION_PRICE                                 AS  Sett_Pric               --结算价格    "
    },
    {
      "line": 60,
      "text": "    ,T1.PAY_AMOUNT                                        AS  Our_Payb_Amt            --我司应付金额"
    },
    {
      "line": 61,
      "text": "    ,T1.REC_AMOUNT                                        AS  Our_Rcvb_Amt            --我司应收金额"
    },
    {
      "line": 62,
      "text": "    ,T1.MARGIN_ADJUSTED                                   AS  Marg_Amt                --保证金      "
    },
    {
      "line": 63,
      "text": "    ,T1.PREMIUM                                           AS  Opt_Fee                 --期权费      "
    },
    {
      "line": 64,
      "text": "    ,T1.BACKEND                                           AS  Reed_Fee                --后端费用    "
    },
    {
      "line": 65,
      "text": "    ,T1.DIVIDEND                                          AS  Divd_Amt                --分红金额    "
    },
    {
      "line": 66,
      "text": "    ,T1.OTHER_AMOUNT                                      AS  Oth_Fee                 --其他费用    "
    },
    {
      "line": 67,
      "text": "    ,T1.SETTLE_AMOUNT                                     AS  Sett_Amt                --结算金额    "
    },
    {
      "line": 68,
      "text": "    ,T1.CURRENCY                                          AS  Crrc_Cd                 --币种代码    "
    },
    {
      "line": 69,
      "text": "    ,T1.BUSINESS_TYPE                                     AS  Busi_Cate               --业务类别    "
    },
    {
      "line": 70,
      "text": "    ,T1.UNDERLYING                                        AS  Sett_Undrl              --结算标的    "
    },
    {
      "line": 71,
      "text": "    ,T1.CREATED_DATETIME                                  AS  Estb_Time               --创建时间    "
    },
    {
      "line": 72,
      "text": "    ,'${data_src_cd}'                                AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 73,
      "text": "    ,'${filename}'                                   AS  Task_Name               --任务名"
    },
    {
      "line": 74,
      "text": "    ,'${data_day_str}'                               AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 75,
      "text": "    ,'${data_today_str}'                             AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 76,
      "text": "    ,'${data_today}'                                 AS  Data_Time               --数据时间"
    },
    {
      "line": 77,
      "text": "    ,T1.DEPARTMENT                                        AS  Bel_Dept                --所属部门"
    },
    {
      "line": 78,
      "text": "    ,'ODATA_N_CSS.E_OTC_SETTLE_JOUR'                      AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 79,
      "text": "    ,'ODATA_N_CSS.E_OTC_SETTLE_JOUR'                      AS  Src_Tbl                 --源表"
    },
    {
      "line": 80,
      "text": "    ,'${data_day_str}'                               AS  Busi_Date               --业务日期"
    },
    {
      "line": 81,
      "text": "FROM   (SELECT *  FROM ${src_table} WHERE  BUSI_DATE='${data_day_str}' )T1"
    },
    {
      "line": 82,
      "text": "LEFT JOIN ODATA_N_TIT.D_TRD_OTC_TRADE  T2 "
    },
    {
      "line": 83,
      "text": "       ON T1.CONTRACT_CODE=T2.INTERNAL_TRADE_ID "
    },
    {
      "line": 84,
      "text": "      AND default.datekey2date(T1.CLEAR_DATE)=T2.BUSI_DATE"
    },
    {
      "line": 85,
      "text": "LEFT JOIN  (SELECT DISTINCT KEY_TRADE_COMFIRM_ID FROM ODATA_N_TIT.D_KS_TRADE_COMFIRM_INFO WHERE BUSI_DATE='${data_day_str}' ) T3"
    },
    {
      "line": 86,
      "text": "       ON T1.CONTRACT_CODE=T3.KEY_TRADE_COMFIRM_ID "
    },
    {
      "line": 87,
      "text": "LEFT JOIN (SELECT * FROM ODATA_N_TIT.D_REF_TRS  WHERE BUSI_DATE ='${data_day_str}'  )T4"
    },
    {
      "line": 88,
      "text": "       ON T2.KEY_OTC_TRADE_ID=T4.KEY_OTC_TRADE_ID"
    },
    {
      "line": 89,
      "text": "LEFT JOIN (SELECT KEY_OTC_TRADE_ID FROM ODATA_N_TIT.D_REF_OTC_OPTION_DEAL  WHERE BUSI_DATE ='${data_day_str}'  )T5"
    },
    {
      "line": 90,
      "text": "       ON T2.KEY_OTC_TRADE_ID=T5.KEY_OTC_TRADE_ID"
    },
    {
      "line": 91,
      "text": ""
    },
    {
      "line": 92,
      "text": ";"
    },
    {
      "line": 93,
      "text": ""
    }
  ]
