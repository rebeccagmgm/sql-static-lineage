    },
    {
      "line": 35,
      "text": "INSERT OVERWRITE TABLE T03_OTC_DERI_AGT_AGT_GRP_RELA_ADTNL_INFO PARTITION(SRC_TBL='${src_table}',BUSI_DATE='${data_day_str}')"
    },
    {
      "line": 36,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 37,
      "text": "--Group2: Source Table:[ODATA_N_TIT.D_MARGIN_BUNDLE_CONTRACT_MAPPING:组合和合约的映射] "
    },
    {
      "line": 38,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 39,
      "text": "SELECT"
    },
    {
      "line": 40,
      "text": "     A.BUNDLE_ID                                       AS  Agt_Grp_Id              --协议组编号            "
    },
    {
      "line": 41,
      "text": "    ,'13'                                              AS  Agt_Agt_Grp_Rela_Type_Cd--协议协议组关系类型代码"
    },
    {
      "line": 42,
      "text": "    ,'TIT_OTC_COMP_GRP'                                AS  Agt_Grp_Cate_Cd         --协议组类别代码        "
    },
    {
      "line": 43,
      "text": "    ,NVL(B.KEY_OTC_TRADE_ID,'')                        AS  Otc_Comp_Agt_Id         --场外合约协议编号      "
    },
    {
      "line": 44,
      "text": "    ,CASE WHEN C.KEY_OTC_TRADE_ID IS NOT NULL THEN '20206'"
    },
    {
      "line": 45,
      "text": "          WHEN D.KEY_OTC_TRADE_ID IS NOT NULL THEN '20207'"
    },
    {
      "line": 46,
      "text": "          ELSE '' END  "
    },
    {
      "line": 47,
      "text": "                                                       AS  Otc_Comp_Agt_Modifr     --场外合约协议修饰符    "
    },
    {
      "line": 48,
      "text": "    ,''                                                AS  Marg_Acct_Agt_Id        --保证金账户协议编号    "
    },
    {
      "line": 49,
      "text": "    ,''                                                AS  Marg_Acct_Agt_Modifr    --保证金账户协议修饰符  "
    },
    {
      "line": 50,
      "text": "    ,A.KEY_CAPITAL_ACCT_ID                             AS  Ast_Acct_Agt_Id         --资金账户协议编号      "
    },
    {
      "line": 51,
      "text": "    ,'10220'                                           AS  Ast_Acct_Agt_Modifr     --资金账户协议修饰符    "
    },
    {
      "line": 52,
      "text": "    ,IF(NVL(TRIM(A.ENTITY_ID),'')='','',CONCAT('TIT-',A.ENTITY_ID))"
    },
    {
      "line": 53,
      "text": "                                                       AS  Prd_Id                  --产品编号              "
    },
    {
      "line": 54,
      "text": "    ,A.ENTITY_ID                                       AS  Src_Prd_Id              --源产品编号            "
    },
    {
      "line": 55,
      "text": "    ,A.INTERNAL_TRADE_ID                               AS  Inr_Comp_No             --内部合约编号          "
    },
    {
      "line": 56,
      "text": "    ,A.CONTRACT_TYPE                                   AS  Src_Agt_Type_Cd         --源协议类型代码        "
    },
    {
      "line": 57,
      "text": "    ,A.CONTRACT_SUB_TYPE                               AS  Src_Agt_Sub_Type_Cd     --源协议子类型代码      "
    },
    {
      "line": 58,
      "text": "    ,CASE WHEN A.IS_TERMINATED  = 'Y' THEN '1'"
    },
    {
      "line": 59,
      "text": "          WHEN A.IS_TERMINATED  = 'N' THEN '0'"
    },
    {
      "line": 60,
      "text": "          ELSE A.IS_TERMINATED END                     AS  Comp_Trmt_Flag          --合约终止标志          "
    },
    {
      "line": 61,
      "text": "    ,'${data_src_cd}'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 62,
      "text": "    ,'${filename}'                                AS  Task_Name               --任务名"
    },
    {
      "line": 63,
      "text": "    ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 64,
      "text": "    ,'${data_today_str}'                          AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 65,
      "text": "    ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 66,
      "text": "FROM   (SELECT *  FROM ODATA_N_TIT.D_MARGIN_BUNDLE_CONTRACT_MAPPING WHERE  BUSI_DATE='${data_day_str}' )A"
    },
    {
      "line": 67,
      "text": "LEFT JOIN (SELECT * FROM ODATA_N_TIT.D_TRD_OTC_TRADE WHERE BUSI_DATE ='${data_day_str}') B"
    },
    {
      "line": 68,
      "text": "       ON A.ENTITY_ID=B.KEY_INSTRUMENT_ID"
    },
    {
      "line": 69,
      "text": "LEFT JOIN (SELECT * FROM ODATA_N_TIT.D_REF_TRS  WHERE BUSI_DATE ='${data_day_str}'  )C"
    },
    {
      "line": 70,
      "text": "       ON B.KEY_OTC_TRADE_ID=C.KEY_OTC_TRADE_ID"
    },
    {
      "line": 71,
      "text": "LEFT JOIN (SELECT KEY_OTC_TRADE_ID FROM ODATA_N_TIT.D_REF_OTC_OPTION_DEAL WHERE BUSI_DATE ='${data_day_str}'  )D"
    },
    {
      "line": 72,
      "text": "       ON B.KEY_OTC_TRADE_ID=D.KEY_OTC_TRADE_ID"
    },
    {
      "line": 73,
      "text": ""
    },
    {
      "line": 74,
      "text": ";"
    },
