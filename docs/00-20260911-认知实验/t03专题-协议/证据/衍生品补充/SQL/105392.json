    {
      "line": 140,
      "text": "INSERT OVERWRITE TABLE T03_OTC_SWAP_COMP_HOLD_INFO PARTITION(SRC_TBL,BUSI_DATE)"
    },
    {
      "line": 141,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 142,
      "text": "--Group1: Source Table:[ODATA_N_TIT.D_POS_TRS_LEG_HIS_POS:持仓-TRS浮动及结构化腿历史持仓）] "
    },
    {
      "line": 143,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 144,
      "text": "SELECT"
    },
    {
      "line": 145,
      "text": "     KEY_LEG_POSITION_ID                               AS  Swap_Comp_Hold_Id       --互换合约持仓编号       "
    },
    {
      "line": 146,
      "text": "    ,B.KEY_OTC_TRADE_ID                                AS  Swap_Comp_Agt_Id        --互换合约协议编号       "
    },
    {
      "line": 147,
      "text": "    ,'20206'                                           AS  Swap_Comp_Agt_Modifr    --互换合约协议修饰符     "
    },
    {
      "line": 148,
      "text": "    ,A.KEY_LEG_ID                                      AS  Leg_Glbl_Seq_No         --Leg全局序号            "
    },
    {
      "line": 149,
      "text": "    ,LONG_SHORT                                        AS  Long_Shor_Clas          --多空分类               "
    },
    {
      "line": 150,
      "text": "    ,CONCAT('TIT-',UNDERLYING_INS_ID)                  AS  Prd_Id                  --产品编号               "
    },
    {
      "line": 151,
      "text": "    ,UNDERLYING_INS_ID                                 AS  Src_Prd_Id              --源产品编号             "
    },
    {
      "line": 152,
      "text": "    ,NVL(C.DW_CD_VAL,EXCHANGE_MARKET)                  AS  Exch_Type_Cd            --市场代码               "
    },
    {
      "line": 153,
      "text": "    ,EXCHANGE_MARKET                                   AS  Src_Trd_Type_Cd         --源交易类别代码         "
    },
    {
      "line": 154,
      "text": "    ,QUANTITY                                          AS  Vol                     --数量                   "
    },
    {
      "line": 155,
      "text": "    ,INIT_QUANTITY                                     AS  Bgng_Vol                --期初数量               "
    },
    {
      "line": 156,
      "text": "    ,INIT_PRICE                                        AS  Bgng_Pric               --期初价格               "
    },
    {
      "line": 157,
      "text": "    ,INIT_EXCHANGE_RATE                                AS  Init_Rate               --初始汇率               "
    },
    {
      "line": 158,
      "text": "    ,INIT_CLEAN_PRICE                                  AS  Bgng_Mtch_Net_Pric      --期初成交净价           "
    },
    {
      "line": 159,
      "text": "    ,INIT_HAND                                         AS  Bgng_Unit_Vol           --期初手数               "
    },
    {
      "line": 160,
      "text": "    ,CURRENCY                                          AS  Crrc_Cd                 --币种代码               "
    },
    {
      "line": 161,
      "text": "    ,TERMINATE_QUANTITY                                AS  End_Vol                 --期末数量               "
    },
    {
      "line": 162,
      "text": "    ,TERMINATE_PRICE                                   AS  End_Pric                --期末价格               "
    },
    {
      "line": 163,
      "text": "    ,TRD_FEE_RATE                                      AS  Trd_Fee_Rate            --交易费率               "
    },
    {
      "line": 164,
      "text": "    ,PRICE                                             AS  Mkt_Quot_Pric           --行情价格               "
    },
    {
      "line": 165,
      "text": "    ,CONTRACT_MULTIPLIER                               AS  Comp_Qty_Mulplr         --合约数量乘数           "
    },
    {
      "line": 166,
      "text": "    ,NVL(D.DW_CD_VAL,TRS_COMMISSION_TYPE)              AS  Cms_Mode_Cd             --佣金模式代码           "
    },
    {
      "line": 167,
      "text": "    ,PER_SHARE_COMMISSION                              AS  Peshr_Cms               --每股佣金               "
    },
    {
      "line": 168,
      "text": "    ,DISCOUNT_PRICE                                    AS  Disc_Pric               --折扣价格               "
    },
    {
      "line": 169,
      "text": "    ,REALIZED_PROFIT                                   AS  Tdy_Rlz_Prft            --当日已实现收益         "
    },
    {
      "line": 170,
      "text": "    ,ACCUMULATE_REALIZED_PROFIT                        AS  Tot_Rlz_Prft            --累计已实现收益         "
    },
