      "text": "--Group1.: Source Table:[ODATA_N_TIT.B_TRD_BOOK_MAPPING:交易流水到titans账簿映射表] "
    },
    {
      "line": 31,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 32,
      "text": "SELECT"
    },
    {
      "line": 33,
      "text": "      A.KEY_BOOK_ID                                     AS  Book_Agt_Id             --账簿协议编号    "
    },
    {
