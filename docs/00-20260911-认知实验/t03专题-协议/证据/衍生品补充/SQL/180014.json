    },
    {
      "line": 28,
      "text": "INSERT OVERWRITE TABLE T03_OTC_DERI_BOOK_AGT_TRD_JOUR_MAP_REGU PARTITION(Src_Tbl='${src_table}',Busi_Date='${data_day_str}')"
    },
    {
      "line": 29,
      "text": "-----------------------------------------------------------------------------------------------------"
