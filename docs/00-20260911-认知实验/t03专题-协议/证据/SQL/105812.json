      "text": "             AND TGT_TAB_FLD  = 'Ord_Stat_Cd'"
    },
    {
      "line": 67,
      "text": "             AND SRC_TAB_NAME = 'INSURANCE_ORDER'"
    },
    {
      "line": 68,
      "text": "             AND SRC_FLD_NAME = 'STATUS'"
    },
    {
      "line": 69,
      "text": "             AND SRC_SYS_NAME='PRD')B"
    },
    {
      "line": 70,
      "text": "      ON      A.STATUS =B.SRC_CD_VAL                  --STATUS 转码"
    },
    {
      "line": 71,
      "text": ";"
