      "text": "                  OR COALESCE(A.Agt_Type_Cd             ,'') <> COALESCE(B.Agt_Type_Cd             ,'')"
    },
    {
      "line": 102,
      "text": "                  OR COALESCE(A.Ord_Cate_Cd             ,'') <> COALESCE(B.Ord_Cate_Cd             ,'')"
    },
    {
      "line": 103,
      "text": "                  OR COALESCE(A.Ord_Type_Cd             ,'') <> COALESCE(B.Ord_Type_Cd             ,'')"
    },
    {
      "line": 104,
      "text": "                  OR COALESCE(A.Ord_Holder              ,'') <> COALESCE(B.Ord_Holder              ,'')"
    },
    {
      "line": 105,
      "text": "                  OR COALESCE(A.Ord_Stat_Cd             ,'') <> COALESCE(B.Ord_Stat_Cd             ,'')"
    },
    {
      "line": 106,
      "text": "                  OR COALESCE(A.Create_Time             ,'') <> COALESCE(B.Create_Time             ,'')"
    },
    {
      "line": 107,
      "text": "                  OR COALESCE(A.Appr_Time               ,'') <> COALESCE(B.Appr_Time               ,'')"
    },
    {
      "line": 108,
      "text": "                  OR COALESCE(A.Pay_Method              ,'') <> COALESCE(B.Pay_Method              ,'')"
    },
    {
      "line": 109,
      "text": "                  OR COALESCE(A.Pay_Src                 ,'') <> COALESCE(B.Pay_Src                 ,'')"
    },
    {
      "line": 110,
      "text": "                  OR COALESCE(A.Appr_User               ,'') <> COALESCE(B.Appr_User               ,'')"
    },
    {
      "line": 111,
      "text": "                  OR COALESCE(A.Recv_User               ,'') <> COALESCE(B.Recv_User               ,'')"
    },
    {
      "line": 112,
      "text": "             ) THEN 'U' --变更"
    },
    {
      "line": 113,
      "text": "             ELSE 'S' --无变更"
    },
    {
