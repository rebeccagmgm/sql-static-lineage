    {
      "line": 87,
      "text": "        ,B.Appr_Time                  AS Appr_Time1                --审核时间"
    },
    {
      "line": 88,
      "text": "        ,B.Pay_Method                 AS Pay_Method1               --支付方式"
    },
    {
      "line": 89,
      "text": "        ,B.Pay_Src                    AS Pay_Src1                  --支付来源"
    },
    {
      "line": 90,
      "text": "        ,B.Appr_User                  AS Appr_User1                --审核用户"
    },
    {
      "line": 91,
      "text": "        ,B.Recv_User                  AS Recv_User1                --接收用户"
    },
    {
      "line": 92,
      "text": "        ,B.DATA_SRC_CD                AS DATA_SRC_CD1              --数据来源代码"
    },
    {
      "line": 93,
      "text": "        ,B.SRC_TBL                    AS SRC_TBL1                  --源表"
    },
    {
      "line": 94,
      "text": "        ,B.TASK_NAME                  AS TASK_NAME1                --任务名"
    },
    {
      "line": 95,
      "text": "        ,B.DATA_ETL_DATE              AS DATA_ETL_DATE1            --数据加载日期"
    },
    {
      "line": 96,
      "text": "        ,B.DATA_UPT_DATE              AS DATA_UPT_DATE1            --数据更新日期"
    },
    {
      "line": 97,
      "text": "        ,CASE WHEN A.Agt_Id IS NULL     AND B.Agt_Id IS NOT NULL THEN 'I' --新增"
    },
    {
      "line": 98,
      "text": "              WHEN A.Agt_Id IS NOT NULL AND B.Agt_Id IS NULL THEN 'D' --删除"
    },
    {
      "line": 99,
      "text": "              WHEN A.Agt_Id IS NOT NULL AND B.Agt_Id IS NOT NULL AND ("
