    {
      "line": 47,
      "text": "    ,''                                       AS  Ord_Type_Cd             --订单类型代码"
    },
    {
      "line": 48,
      "text": "    ,LPAD(CLIENT_ID,12,'0')                   AS  Ord_Holder              --订单持有人  "
