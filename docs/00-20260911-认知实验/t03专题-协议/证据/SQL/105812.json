    {
      "line": 82,
      "text": "        ,B.Ord_Cate_Cd                AS Ord_Cate_Cd1              --订单类别代码"
    },
    {
      "line": 83,
      "text": "        ,B.Ord_Type_Cd                AS Ord_Type_Cd1              --订单类型代码"
    },
    {
      "line": 84,
      "text": "        ,B.Ord_Holder                 AS Ord_Holder1               --订单持有人"
    },
    {
      "line": 85,
      "text": "        ,B.Ord_Stat_Cd                AS Ord_Stat_Cd1              --订单状态代码"
