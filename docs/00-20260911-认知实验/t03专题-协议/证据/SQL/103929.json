    },
    {
      "line": 44,
      "text": "    ,''                                       AS  Bel_Inr_Org_Id          --所属内部机构编号"
    },
    {
      "line": 45,
      "text": "    ,CONCAT('TIT060-',KEY_CTPTY_ID)           AS  Agt_Holder              --协议持有人      "
    },
    {
      "line": 46,
      "text": "    ,''                                       AS  Exch_Type_Cd            --市场代码        "
    },
    {
      "line": 47,
      "text": "    ,default.date2datekey(SUBSTR(CREATED_DATETIME,1,10))"
    },
    {
      "line": 48,
      "text": "                                              AS  Vld_Date                --生效日期        "
    },
    {
      "line": 49,
      "text": "    ,''                                       AS  Due_Date                --到期日期        "
    },
    {
      "line": 50,
      "text": "    ,NVL(DW_CD_VAL,ENABLED)                   AS  Agt_Stat_Cd             --协议状态代码    "
    },
    {
      "line": 51,
      "text": "    ,CURRENCY                                 AS  Crrc_Cd                 --币种代码        "
    },
    {
      "line": 52,
      "text": "    ,'${data_src_cd}'                    AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 53,
      "text": "    ,'${src_table}'                      AS  Src_Tbl                 --源表"
    },
    {
      "line": 54,
      "text": "    ,'${filename}'                       AS  Task_Name               --任务名"
    },
    {
      "line": 55,
      "text": "    ,'${data_day_str}'                   AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 56,
      "text": "    ,'${data_day_str}'                   AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 57,
      "text": "    ,'${src_table}'                      AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 58,
      "text": "FROM  ${src_table} A"
    },
    {
      "line": 59,
      "text": "LEFT JOIN ("
    },
    {
      "line": 60,
      "text": "         SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 61,
      "text": "          FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 62,
      "text": "          WHERE TGT_TAB_NAME = 'T03_AGT'"
    },
    {
      "line": 63,
      "text": "             AND TGT_TAB_FLD  = 'Agt_Stat_Cd'"
    },
    {
      "line": 64,
      "text": "             AND SRC_TAB_NAME = 'CAPITAL_ACCOUNT'"
    },
    {
      "line": 65,
      "text": "             AND SRC_FLD_NAME = 'ENABLED'"
    },
    {
      "line": 66,
      "text": "             AND SRC_SYS_NAME='TIT')B"
    },
    {
      "line": 67,
      "text": "      ON      A.ENABLED =B.SRC_CD_VAL                  --ENABLED 转码"
    },
    {
      "line": 68,
      "text": ";"
