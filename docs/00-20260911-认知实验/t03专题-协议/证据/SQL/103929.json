    {
      "line": 84,
      "text": "        ,B.Agt_Stat_Cd                AS Agt_Stat_Cd1              --协议状态代码"
    },
    {
      "line": 85,
      "text": "        ,B.Crrc_Cd                    AS Crrc_Cd1                  --币种代码"
    },
    {
      "line": 86,
      "text": "        ,B.DATA_SRC_CD                AS DATA_SRC_CD1              --数据来源代码"
    },
    {
      "line": 87,
      "text": "        ,B.SRC_TBL                    AS SRC_TBL1                  --源表"
    },
    {
      "line": 88,
      "text": "        ,B.TASK_NAME                  AS TASK_NAME1                --任务名"
    },
    {
      "line": 89,
      "text": "        ,B.DATA_ETL_DATE              AS DATA_ETL_DATE1            --数据加载日期"
    },
