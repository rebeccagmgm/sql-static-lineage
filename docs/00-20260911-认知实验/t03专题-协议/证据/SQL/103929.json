      "text": "        ,B.Real_Src_Tbl               AS Real_Src_Tbl1             --真实源表"
    },
    {
      "line": 92,
      "text": "        ,CASE WHEN A.Agt_Id IS NULL     AND B.Agt_Id IS NOT NULL THEN 'I' --新增"
    },
    {
      "line": 93,
      "text": "              WHEN A.Agt_Id IS NOT NULL AND B.Agt_Id IS NULL THEN 'D' --删除"
    },
    {
      "line": 94,
      "text": "              WHEN A.Agt_Id IS NOT NULL AND B.Agt_Id IS NOT NULL AND ("
    },
    {
      "line": 95,
      "text": "                     COALESCE(A.Agt_Modifr              ,'') <> COALESCE(B.Agt_Modifr              ,'')"
    },
    {
      "line": 96,
      "text": "                  OR COALESCE(A.Agt_Cate_Cd             ,'') <> COALESCE(B.Agt_Cate_Cd             ,'')"
    },
    {
      "line": 97,
      "text": "                  OR COALESCE(A.Agt_Type_Cd             ,'') <> COALESCE(B.Agt_Type_Cd             ,'')"
    },
    {
      "line": 98,
      "text": "                  OR COALESCE(A.Bel_Inr_Org_Id          ,'') <> COALESCE(B.Bel_Inr_Org_Id          ,'')"
    },
    {
      "line": 99,
      "text": "                  OR COALESCE(A.Agt_Holder              ,'') <> COALESCE(B.Agt_Holder              ,'')"
    },
    {
      "line": 100,
      "text": "                  OR COALESCE(A.Exch_Type_Cd            ,'') <> COALESCE(B.Exch_Type_Cd            ,'')"
    },
    {
      "line": 101,
      "text": "                  OR COALESCE(A.Vld_Date                ,'') <> COALESCE(B.Vld_Date                ,'')"
    },
    {
      "line": 102,
      "text": "                  OR COALESCE(A.Due_Date                ,'') <> COALESCE(B.Due_Date                ,'')"
    },
    {
      "line": 103,
      "text": "                  OR COALESCE(A.Agt_Stat_Cd             ,'') <> COALESCE(B.Agt_Stat_Cd             ,'')"
    },
    {
      "line": 104,
      "text": "                  OR COALESCE(A.Crrc_Cd                 ,'') <> COALESCE(B.Crrc_Cd                 ,'')"
    },
    {
      "line": 105,
      "text": "             ) THEN 'U' --变更"
    },
    {
      "line": 106,
      "text": "             ELSE 'S' --无变更"
    },
    {
      "line": 107,
      "text": "             END                 AS DATA_TYPE              --数据类型"
    },
    {
      "line": 108,
      "text": "FROM  (SELECT * FROM T03_AGT "
    },
    {
      "line": 109,
      "text": "                WHERE SRC_TBL='ODATA_N_TIT.D_CAPITAL_ACCOUNT')A"
