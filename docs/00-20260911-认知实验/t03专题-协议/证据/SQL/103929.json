    {
      "line": 37,
      "text": "--GROUP94: SOURCE TABLE:[ODATA_N_TIT.D_CAPITAL_ACCOUNT: 客户资金账户信息]"
    },
    {
      "line": 38,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 39,
      "text": "SELECT"
    },
    {
      "line": 40,
      "text": "     KEY_CAPITAL_ACCT_ID                      AS  Agt_Id                  --协议编号        "
    },
    {
      "line": 41,
      "text": "    ,'10220'                                  AS  Agt_Modifr              --协议修饰符      "
    },
    {
      "line": 42,
      "text": "    ,'102'                                    AS  Agt_Cate_Cd             --协议类别代码    "
