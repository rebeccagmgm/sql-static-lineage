    },
    {
      "line": 79,
      "text": "        ,B.Bel_Inr_Org_Id             AS Bel_Inr_Org_Id1           --所属内部机构编号"
    },
    {
      "line": 80,
      "text": "        ,B.Agt_Holder                 AS Agt_Holder1               --协议持有人"
    },
    {
      "line": 81,
      "text": "        ,B.Exch_Type_Cd               AS Exch_Type_Cd1             --市场代码"
    },
    {
      "line": 82,
      "text": "        ,B.Vld_Date                   AS Vld_Date1                 --生效日期"
    },
    {
      "line": 83,
      "text": "        ,B.Due_Date                   AS Due_Date1                 --到期日期"
