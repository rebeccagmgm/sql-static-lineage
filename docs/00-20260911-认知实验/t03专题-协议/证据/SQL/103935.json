      "text": "              OR COALESCE(A.Rela_Agt_Modifr         ,'')   <> COALESCE(B.Rela_Agt_Modifr1        ,'')"
    },
    {
      "line": 93,
      "text": "             ) THEN 'U'                                                        --当天和历史均存在,除主键外如有字段变更为变更"
    },
    {
      "line": 94,
      "text": "             ELSE 'S' END AS DATA_TYPE                                         --其他为无变更"
    },
    {
      "line": 95,
      "text": "FROM   (  SELECT"
