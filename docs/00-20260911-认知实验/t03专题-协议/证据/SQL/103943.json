    {
      "line": 136,
      "text": "--Group1: Source Table:[ODATA_N_TIT.D_REF_OTC_OPTION_DEAL:场外交易-期权交易合同要素表] "
    },
    {
      "line": 137,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 138,
      "text": "SELECT"
    },
    {
      "line": 139,
      "text": "     A.KEY_OTC_TRADE_ID                                AS  Opt_Comp_Agt_Id         --期权合约协议编号       "
    },
    {
      "line": 140,
      "text": "    ,'20207'                                           AS  Opt_Comp_Agt_Modifr     --期权合约协议修饰符   "
    },
    {
      "line": 141,
      "text": "    ,CONTRACT_CODE                                     AS  Ext_Comp_No             --外部合约编号         "
    },
    {
      "line": 142,
      "text": "    ,IF(NVL(TRIM(KEY_CTPTY_ID),'')='','',CONCAT('TIT060-',KEY_CTPTY_ID))"
    },
    {
      "line": 143,
      "text": "                                                       AS  Cutp_Pty_Id             --交易对手当事人编号   "
    },
    {
      "line": 144,
      "text": "    ,KEY_CAPITAL_ACCT_ID                               AS  Ast_Acct_Agt_Id         --资金账户协议编号     "
    },
    {
      "line": 145,
      "text": "    ,IF(NVL(TRIM(KEY_CAPITAL_ACCT_ID),'')='','','10218')"
    },
    {
      "line": 146,
      "text": "                                                       AS  Ast_Acct_Agt_Modifr     --资金账户协议修饰符   "
    },
    {
      "line": 147,
      "text": "    ,BUNDLE_ID                                         AS  Comb_Agt_Grp_Id         --组合协议组编号         "
    },
    {
      "line": 148,
      "text": "    ,PARTY                                             AS  Our_Id_Type_Cd          --我司身份类型代码     "
    },
    {
      "line": 149,
      "text": "    ,CLEARING_HOUSE                                    AS  Clr_Org_Id_Type_Cd      --清算机构身份类型代码 "
    },
    {
      "line": 150,
      "text": "    ,IF(NVL(TRIM(COUPON_PAYER),'')='','',CONCAT('TIT060-',COUPON_PAYER)) "
    },
    {
      "line": 151,
      "text": "                                                       AS  Coup_Paid_Pty_Id        --票息支付当事人编号   "
    },
    {
      "line": 152,
      "text": "    ,SUBSTR(TRADE_DATE,1,10)                           AS  Trd_Date                --交易日期             "
    },
    {
      "line": 153,
      "text": "    ,SUBSTR(PREMIUM_DATE,1,10)                                       AS  Opt_Fee_Paid_Date       --期权费支付日期       "
    },
    {
      "line": 154,
      "text": "    ,PAYMENT_DATE_DELAY                                AS  Pay_Delay_Days          --兑付日延期天数       "
    },
    {
      "line": 155,
      "text": "    ,SUBSTR(PAYMENT_DATE,1,10)                                        AS  Pay_Date                --兑付日               "
    },
    {
      "line": 156,
      "text": "    ,TIME_TO_MATURITY                                  AS  Term_Days               --期限天数               "
    },
    {
      "line": 157,
      "text": "    ,MAXIMUM_LOSS_LEVEL                                AS  Max_Prin_Los_Prop       --最大本金亏损比例       "
    },
    {
      "line": 158,
      "text": "    ,CASE WHEN IS_ANNUALIZED = 'Y' THEN '1' "
    },
    {
      "line": 159,
      "text": "          WHEN IS_ANNUALIZED = 'N' THEN '0'"
    },
    {
      "line": 160,
      "text": "          ELSE '' END                                  AS  Annu_Flag               --年化标志               "
    },
    {
      "line": 161,
      "text": "    ,NOTIONAL                                          AS  Nom_Prin                --名义本金               "
    },
    {
      "line": 162,
      "text": "    ,COLLATERAL_NOTIONAL                               AS  Absl_Nom_Prin           --绝对名义本金           "
    },
    {
      "line": 163,
      "text": "    ,COLLATERAL_NOTIONAL_CURRENCY                      AS  Absl_Nom_Prin_Crrc_Cd   --绝对名义本金币种代码   "
    },
    {
      "line": 164,
      "text": "    ,SETTLEMENT_CURRENCY                               AS  Sett_Crrc_Cd            --结算币种代码           "
    },
    {
      "line": 165,
      "text": "    ,PREMIUM_RATE                                      AS  Opt_Fee_Rate            --期权费率               "
    },
    {
      "line": 166,
      "text": "    ,PREMIUM                                           AS  Opt_Fee                 --期权费                 "
    },
    {
      "line": 167,
      "text": "    ,MINIMUM_YIELD                                     AS  Low_Yield               --最低收益率             "
    },
    {
      "line": 168,
      "text": "    ,CASE WHEN DIVIDEND = 'Y' THEN '1' "
    },
    {
      "line": 169,
      "text": "          WHEN DIVIDEND = 'N' THEN '0'"
    },
    {
      "line": 170,
      "text": "          ELSE '' END                                  AS  Divd_Adj_Flag           --分红调整标志           "
    },
    {
      "line": 171,
      "text": "    ,COUPON_SETTLEMENT                                 AS  Coup_Pay_Way_Cd         --票息兑付方式代码       "
    },
    {
      "line": 172,
      "text": "    ,COUPON_CALCULATION                                AS  Coup_Calc_Way_Cd        --票息计算方式代码       "
    },
    {
      "line": 173,
      "text": "    ,EARLY_TERMINATION_DELAY                           AS  Erly_Trmt_Defr_Days     --提前终止日递延天数     "
    },
    {
      "line": 174,
      "text": "    ,COUPON_PAYMENT_DELAY                              AS  Coup_Pay_Defr_Days      --票息支付日递延天数     "
    },
    {
      "line": 175,
      "text": "    ,KEY_CONTACT_ID                                    AS  Cust_Lkman_Id           --客户联系人编号         "
    },
