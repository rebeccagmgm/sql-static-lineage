    {
      "line": 44,
      "text": "--Group1: Source Table:[ODATA_N_TIT.D_REF_FX_FORWARD_STRUCTURE:外汇远期-结构要素] "
    },
    {
      "line": 45,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 46,
      "text": "SELECT"
    },
    {
      "line": 47,
      "text": "      KEY_OTC_TRADE_ID                                  AS  Fx_Fwd_Comp_Agt_Id      --外汇远期合约协议编号  "
    },
    {
      "line": 48,
      "text": "     ,'20208'                                           AS  Fx_Fwd_Comp_Agt_Modifr  --外汇远期合约协议修饰符"
    },
    {
      "line": 49,
      "text": "     ,IF(NVL(TRIM(UNDERLYING_INS_ID),'')='','',CONCAT('TIT-',UNDERLYING_INS_ID))"
    },
    {
      "line": 50,
      "text": "                                                        AS  Undrl_Prd_Id            --标的产品编号          "
    },
    {
      "line": 51,
      "text": "     ,UNDERLYING_INS_ID                                 AS  Src_Undrl_Prd_Id        --源标的产品编号        "
    },
    {
      "line": 52,
      "text": "     ,UNDERLYING_WIND_CODE                              AS  Undrl_Cd                --标的代码              "
    },
    {
      "line": 53,
      "text": "     ,SETTLEMENT_METHOD                                 AS  Deli_Method_Cd          --交割方式代码          "
    },
    {
      "line": 54,
      "text": "     ,SUBSTR(START_DATE,1,10)                           AS  Bgng_Prcg_Date          --期初定价日期          "
    },
    {
      "line": 55,
      "text": "     ,SUBSTR(END_DATE  ,1,10)                           AS  End_Prcg_Date           --期末定价日期          "
    },
    {
      "line": 56,
      "text": "     ,SETTLEMENT_CCY                                    AS  Sett_Crrc_Cd            --结算币种代码          "
    },
    {
      "line": 57,
      "text": "     ,FIRST_CCY                                         AS  Crrc_Cd1                --币种代码1             "
    },
    {
      "line": 58,
      "text": "     ,SECOND_CCY                                        AS  Crrc_Cd2                --币种代码2             "
    },
    {
      "line": 59,
      "text": "     ,INITIAL_QTY                                       AS  Bgng_Vol                --期初数量              "
    },
    {
      "line": 60,
      "text": "     ,FIRST_QTY                                         AS  Sler_Paid_Crrc1_Vol     --销售方支付币种1数量   "
    },
    {
      "line": 61,
      "text": "     ,SECOND_QTY                                        AS  Sler_Paid_Crrc2_Vol     --销售方支付币种2数量   "
    },
    {
      "line": 62,
      "text": "     ,STRIKE_FX_RATE                                    AS  Deli_Rate               --交割汇率              "
    },
    {
      "line": 63,
      "text": "     ,SETTLEMENT_FX_RATE                                AS  Sett_Rate               --结算汇率              "
    },
    {
      "line": 64,
      "text": "     ,MATURITY_FX_RATE                                  AS  End_Rate                --期末汇率              "
    },
    {
      "line": 65,
      "text": "     ,CREATED_DATETIME                                  AS  Create_Time             --创建时间              "
    },
    {
      "line": 66,
      "text": "     ,CREATED_BY                                        AS  Create_User_Id          --创建用户编号          "
    },
    {
      "line": 67,
      "text": "     ,UPDATED_DATETIME                                  AS  Upd_Time                --更新时间              "
    },
    {
      "line": 68,
      "text": "     ,UPDATED_BY                                        AS  Upd_User_Id             --更新用户编号          "
    },
    {
      "line": 69,
      "text": "     ,'${data_src_cd}'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 70,
      "text": "     ,'${filename}'                                AS  Task_Name               --任务名"
    },
    {
      "line": 71,
      "text": "     ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 72,
      "text": "     ,'${data_day_str}'                            AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 73,
      "text": "     ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 74,
      "text": "     ,'${src_table}'                               AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 75,
      "text": "FROM (SELECT *  FROM ${src_table} WHERE  Busi_Date='${data_day_str}' )A"
    },
