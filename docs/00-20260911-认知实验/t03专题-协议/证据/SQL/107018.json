    {
      "line": 181,
      "text": "    ,NVL(FP.CONTR_MULPLR,'1')                          AS  Comp_Mulplr             --合约乘数          "
    },
    {
      "line": 182,
      "text": "    ,'PDATA_N'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 183,
      "text": "    ,'PDATA_N.T98_OTC_SWAP_COMP_TRD_UNDRL_INFO'                                AS  Task_Name               --任务名"
    },
    {
      "line": 184,
      "text": "    ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 185,
      "text": "    ,'${data_day_str}'                            AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 186,
      "text": "    ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 187,
      "text": "    ,RTL.Res_Flag                                      AS  Res_Flag                --限售标志"
    },
    {
      "line": 188,
      "text": "    ,HP.Disc_Pric                                      AS  Valu_Use_Mkt_Quot_Pric  --估值使用行情价格"
    },
    {
      "line": 189,
      "text": "    ,RI.Src_Mkt_Cd                                     AS  Src_Trd_Type_Cd                    --源交易类别代码"
    },
    {
      "line": 190,
      "text": "    ,RI.Scr_Type_Src                                   AS  Src_Scr_Type_Cd                    --源证券类型代码"
    },
    {
      "line": 191,
      "text": "    ,HP.Bgng_Pric                                      AS  Bgng_Pric                          --期初价格"
    },
    {
      "line": 192,
      "text": "    ,SUBSTR(RTL.Res_Pd_End_Day,1,10)                   AS  Res_Pd_End_Date                    --限售期结束日期"
    },
    {
      "line": 193,
      "text": "    ,RT.Crrc_Cd                                        AS  Crrc_Cd                 --币种代码"
    },
    {
      "line": 194,
      "text": "    ,RT.Sett_Crrc_Cd                                   AS  Sett_Crrc_Cd            --结算币种代码"
    },
    {
      "line": 195,
      "text": "    ,RT.Lcrrc_Crrc_Cd                                  AS  Lcrrc_Crrc_Cd           --本币币种代码"
    },
    {
      "line": 196,
      "text": "    ,FP.Futr_Type_Cd                                   AS  Futr_Type_Cd            --期货类型代码"
    },
    {
      "line": 197,
      "text": "    ,PS.Const_Cn_Desc                                  AS  Futr_Type_Desc          --期货类型描述"
    },
    {
      "line": 198,
      "text": "    ,RT.CUTP_PTY_ID                                    AS  Cutp_Pty_Id             --交易对手当事人编号"
    },
    {
      "line": 199,
      "text": "    ,CFN.FULL_NAME_CH                                  AS  Cutp_Full_Name          --交易对手全称"
    },
    {
      "line": 200,
      "text": "    ,CFN.SHOR_NAME_CH                                  AS  Cutp_Shor_Name          --交易对手简称"
    },
    {
      "line": 201,
      "text": "    ,CFN.SHOR_NAME_EN                                  AS  Cutp_Shor_Name_En       --交易对手英文简称"
    },
    {
      "line": 202,
      "text": "    ,CLE.CUTP_LEGAL_ENTY                               AS  Cutp_Legal_Enty         --交易对手法律主体"
    },
    {
      "line": 203,
      "text": "    ,RT.EXT_COMP_NO                                    AS  Ext_Comp_No             --外部合约编号"
    },
    {
      "line": 204,
      "text": "    ,RT.Src_Tbl                                        AS  Src_Tbl                 --源表"
    },
    {
      "line": 205,
      "text": "    ,HP.BUSI_DATE                                      AS  Busi_Date               --业务日期"
    },
    {
      "line": 206,
      "text": "FROM (select * from PDATA_N.T03_OTC_SWAP_COMP_INFO where busi_date='${data_day_str}'   and src_tbl='ODATA_N_TIT.D_REF_TRS' ) RT --REF_TRS "
    },
    {
      "line": 207,
      "text": "    JOIN (select * from pdata_n.T03_AGT_STATI_INFO_H where strt_date<='${data_day_str}'   and end_date>'${data_day_str}'   and Agt_Stati_Info_Type_Cd='09' and src_tbl='ODATA_N_TIT.D_TRD_OTC_TRADE' ) TT "
    },
    {
      "line": 208,
      "text": "    ON RT.Swap_Comp_Agt_Id  = TT.Agt_Id"
    },
    {
      "line": 209,
      "text": "    AND RT.Swap_Comp_Agt_Modifr=TT.Agt_Modifr"
    },
    {
      "line": 210,
      "text": "    JOIN (select * from PDATA_N.T03_AGT_CLAS_H where strt_date<='${data_day_str}'   and end_date>'${data_day_str}'   and Agt_Clas_Type_Cd='05' and src_tbl='ODATA_N_TIT.D_TRD_OTC_TRADE' ) TOT"
    },
    {
      "line": 211,
      "text": "    ON TT.Agt_Id  = TOT.Agt_Id"
    },
    {
      "line": 212,
      "text": "    AND TT.Agt_Modifr=TOT.Agt_Modifr"
    },
    {
      "line": 213,
      "text": ""
    },
    {
      "line": 214,
      "text": "   JOIN (select * from pdata_n.T03_AGT_RELA_H where strt_date<='${data_day_str}'   and end_date>'${data_day_str}'   and Agt_Rela_Type_Cd='N03' and src_tbl='ODATA_N_TIT.D_TRD_OTC_TRADE' ) TOT1"
    },
    {
      "line": 215,
      "text": "   ON TT.Agt_Id  = TOT1.Agt_Id"
    },
    {
      "line": 216,
      "text": "   AND TT.Agt_Modifr=TOT1.Agt_Modifr"
    },
    {
      "line": 217,
      "text": ""
    },
    {
      "line": 218,
      "text": "   JOIN MAPPING MP"
    },
    {
      "line": 219,
      "text": "   ON TOT.Agt_Id = MP.KEY_OTC_TRADE_ID"
    },
    {
      "line": 220,
      "text": "   AND TOT1.Rela_Agt_Id= MP.KEY_BOOK_ID_FROM"
    },
    {
      "line": 221,
      "text": "   "
    },
    {
      "line": 222,
      "text": "   JOIN (select * from PDATA_N.T03_AGT_NAME_H WHERE strt_date<='${data_day_str}'   and end_date>'${data_day_str}'   AND SRC_TBL='ODATA_N_TIT.D_REF_BOOK')RB"
    },
    {
      "line": 223,
      "text": "   ON MP.KEY_BOOK_ID_TO =RB.Agt_Id"
    },
    {
      "line": 224,
      "text": "   "
    },
    {
      "line": 225,
      "text": "   JOIN (select * from PDATA_N.T03_OTC_DERI_BOOK_ADTNL_INFO where busi_date='${data_day_str}' AND SRC_TBL='ODATA_N_TIT.D_REF_BOOK' )RB1"
    },
    {
      "line": 226,
      "text": "   ON MP.KEY_BOOK_ID_TO =RB1.Book_Agt_Id"
    },
    {
      "line": 227,
      "text": ""
    },
    {
      "line": 228,
      "text": "   JOIN (select * from PDATA_N.T03_OTC_SWAP_COMP_LEG_INFO where busi_date='${data_day_str}'   and src_tbl='ODATA_N_TIT.D_REF_TRS_LEG') RTL "
    },
    {
      "line": 229,
      "text": "      ON RT.Swap_Comp_Agt_Id  = RTL.Swap_Comp_Agt_Id"
    },
    {
      "line": 230,
      "text": "      AND  RT.Swap_Comp_Agt_Modifr  = RTL.Swap_Comp_Agt_Modifr"
    },
    {
      "line": 231,
      "text": "      AND RTL.Swap_Comp_Leg_Type_Cd = 'STRUCTURE_LEG_TYPE'"
    },
    {
      "line": 232,
      "text": "   "
    },
    {
      "line": 233,
      "text": "   JOIN (select * from PDATA_N.T03_OTC_SWAP_COMP_HOLD_INFO a "
    },
    {
      "line": 234,
      "text": "          where src_tbl='ODATA_N_TIT.D_POS_TRS_LEG_HIS_POS' "
    },
    {
      "line": 235,
      "text": "            and exists (select 1 from D_POS_TRS_LEG_HIS_POS_TEMP b where a.busi_date=b.busi_date)  --取得当前有更新的日期更新"
    },
    {
      "line": 236,
      "text": "   ) HP  "
    },
    {
      "line": 237,
      "text": "   ON RTL.Leg_Glbl_Seq_No  = HP.Leg_Glbl_Seq_No "
    },
    {
      "line": 238,
      "text": "   JOIN  (select * from pdata_news_n.t02_tit_scr_base_info  WHERE src_id='TIT' and grp_id = '01') RI "
    },
    {
      "line": 239,
      "text": "   ON HP.Prd_Id = RI.src_sys_prdno"
    },
    {
      "line": 240,
      "text": ""
    },
    {
      "line": 241,
      "text": "   LEFT JOIN pdata_news_n.t02_fxr_cfets_quot RRM "
    },
    {
      "line": 242,
      "text": "   ON  HP.BUSI_DATE =default.datekey2date(RRM.trd_dt )"
    },
    {
      "line": 243,
      "text": "   AND RT.Crrc_Cd = RRM.src_crrc_cd"
    },
    {
      "line": 244,
      "text": "   and RRM.src_id='TIT' "
    },
    {
      "line": 245,
      "text": "       and RRM.grp_id = '01' "
    },
    {
      "line": 246,
      "text": "   LEFT JOIN (SELECT * FROM PDATA_NEWS_N.t02_fut_base_info  WHERE src_id='TIT' AND grp_id = '01' )  FP "
    },
    {
      "line": 247,
      "text": "   ON  RI.scr_type = 'FUT'"
    },
    {
      "line": 248,
      "text": "   AND  RI.src_sys_prdno  = FP.src_sys_prdno "
    },
    {
      "line": 249,
      "text": "   LEFT JOIN (SELECT * FROM PDATA_NEWS_N.T02_PUB_CST_INFO  WHERE  const_type_cd='var00001')  PS"
    },
    {
      "line": 250,
      "text": "   ON   FP.Futr_Type_Cd=PS.CONST_CD"
    },
    {
      "line": 251,
      "text": "   LEFT JOIN (SELECT * FROM PDATA_N.T01_PTY_NAME  WHERE  SRC_TBL='ODATA_N_TIT.D_REF_COUNTER_PARTY' AND BUSI_DATE='${data_day_str}' )  CFN"
    },
    {
      "line": 252,
      "text": "   ON   RT.Cutp_Pty_Id=CFN.pty_id"
    },
    {
      "line": 253,
      "text": "   LEFT JOIN (SELECT * FROM PDATA_N.T01_PTY_CUTP  WHERE  SRC_TBL='ODATA_N_TIT.D_REF_COUNTER_PARTY' AND BUSI_DATE='${data_day_str}')  CLE"
    },
    {
      "line": 254,
      "text": "   ON   CFN.pty_id=CLE.pty_id"
    },
    {
      "line": 255,
      "text": "   WHERE RT.Comp_Stat_Cd NOT IN ('230','254','253','218','255')  --230 未处理, 254 待交易在途, 253 待交易, 218 作废, 255 草稿在途"
    },
    {
      "line": 256,
      "text": "   ;"
    },
    {
      "line": 257,
      "text": ""
    }
  ]
}