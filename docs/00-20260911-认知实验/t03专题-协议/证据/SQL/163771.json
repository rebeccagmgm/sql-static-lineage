      "text": "-- querySql"
    },
    {
      "line": 43,
      "text": "INSERT OVERWRITE TABLE T03_OTC_FX_FWD_COMP_INFO PARTITION(Src_Tbl='${src_table}',Busi_Date='${data_day_str}')"
    },
    {
      "line": 44,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 45,
      "text": "--Group1: Source Table:[ODATA_N_TIT.D_REF_FX_FORWARD:外汇远期-合约要素] "
    },
    {
      "line": 46,
      "text": "-----------------------------------------------------------------------------------------------------"
    },
    {
      "line": 47,
      "text": "SELECT"
    },
    {
      "line": 48,
      "text": "      KEY_OTC_TRADE_ID                                  AS  Fx_Fwd_Comp_Agt_Id      --外汇远期合约协议编号    "
    },
    {
      "line": 49,
      "text": "     ,'20208'                                           AS  Fx_Fwd_Comp_Agt_Modifr  --外汇远期合约协议修饰符 "
    },
    {
      "line": 50,
      "text": "     ,IF(NVL(TRIM(KEY_CTPTY_ID),'')='','',CONCAT('TIT060-',KEY_CTPTY_ID))"
    },
    {
      "line": 51,
      "text": "                                                        AS  Cutp_Pty_Id             --交易对手当事人编号      "
    },
    {
      "line": 52,
      "text": "     ,CONTRACT_CODE                                     AS  Inr_Comp_No             --内部合约编号            "
    },
    {
      "line": 53,
      "text": "     ,NVL(DW_CD_VAL,CONTR_STATUS)                       AS  Comp_Stat_Cd            --合约状态代码        "
    },
    {
      "line": 54,
      "text": "     ,IF(NVL(TRIM(SELLER),'')='','',CONCAT('TIT060-',SELLER))"
    },
    {
      "line": 55,
      "text": "                                                        AS  Sler_Cutp_Pty_Id        --销售方交易对手当事人编号"
    },
    {
      "line": 56,
      "text": "     ,PARTY                                             AS  Our_Id_Type_Cd          --我司身份类型代码        "
    },
    {
      "line": 57,
      "text": "     ,CLEARING_HOUSE                                    AS  Clr_Org_Id_Type_Cd      --清算机构身份类型代码    "
    },
    {
      "line": 58,
      "text": "     ,TIME_TO_MATURITY                                  AS  Term_Days               --期限天数                "
    },
    {
      "line": 59,
      "text": "     ,ACTUAL_TIME_TO_MATURITY                           AS  Actl_Term_Days          --实际期限天数            "
    },
    {
      "line": 60,
      "text": "     ,PAYMENT_DATE_DELAY                                AS  Pay_Delay_Days          --兑付日延期天数          "
    },
    {
      "line": 61,
      "text": "     ,NOTIONAL                                          AS  Nom_Prin                --名义本金                "
    },
    {
      "line": 62,
      "text": "     ,DYNAMIC_NOTIONAL                                  AS  Dyna_Nom_Prin           --动态名义本金            "
    },
    {
      "line": 63,
      "text": "     ,SUBSTR(INPUT_DATE         ,1,10)                  AS  Actl_Appr_Vld_Date      --实际审批生效日期        "
    },
    {
      "line": 64,
      "text": "     ,SUBSTR(PAYMENT_DATE       ,1,10)                  AS  Pay_Date                --兑付日期                "
    },
    {
      "line": 65,
      "text": "     ,SUBSTR(ACTUAL_PAYMENT_DATE,1,10)                  AS  Actl_Pay_Date           --实际兑付日期            "
    },
    {
      "line": 66,
      "text": "     ,TERMINATION_FEE                                   AS  Term_Sett_Amt           --终止结算金额            "
    },
    {
      "line": 67,
      "text": "     ,SUBSTR(EARLY_TERM_DATE,1,10)                      AS  Erly_Trmt_Date          --提前终止日期            "
    },
    {
      "line": 68,
      "text": "     ,CREATED_BY                                        AS  Create_User_Id          --创建用户编号            "
    },
    {
      "line": 69,
      "text": "     ,CREATED_DATETIME                                  AS  Create_Time             --创建时间                "
    },
    {
      "line": 70,
      "text": "     ,UPDATED_BY                                        AS  Upd_User_Id             --更新用户编号            "
    },
    {
      "line": 71,
      "text": "     ,UPDATED_DATETIME                                  AS  Upd_Time                --更新时间                "
    },
    {
      "line": 72,
      "text": "     ,'${data_src_cd}'                             AS  Data_Src_Cd             --数据来源代码"
    },
    {
      "line": 73,
      "text": "     ,'${filename}'                                AS  Task_Name               --任务名"
    },
    {
      "line": 74,
      "text": "     ,'${data_day_str}'                            AS  Data_Etl_Date           --数据加载日期"
    },
    {
      "line": 75,
      "text": "     ,'${data_day_str}'                            AS  Data_Upt_Date           --数据更新日期"
    },
    {
      "line": 76,
      "text": "     ,'${data_today}'                              AS  Data_Time               --数据时间"
    },
    {
      "line": 77,
      "text": "     ,'${src_table}'                               AS  Real_Src_Tbl            --真实源表"
    },
    {
      "line": 78,
      "text": "FROM (SELECT *  FROM ${src_table} WHERE  Busi_Date='${data_day_str}' )A"
    },
    {
      "line": 79,
      "text": "LEFT JOIN ("
    },
    {
      "line": 80,
      "text": "         SELECT SRC_CD_VAL,DW_CD_VAL"
    },
    {
      "line": 81,
      "text": "          FROM PDATA_N.REF_CD_CVT_MAP"
    },
    {
      "line": 82,
      "text": "          WHERE TGT_TAB_NAME = 'T03_OTC_FX_FWD_COMP_INFO'"
    },
    {
      "line": 83,
      "text": "             AND TGT_TAB_FLD  = 'Comp_Stat_Cd'"
    },
    {
      "line": 84,
      "text": "             AND SRC_TAB_NAME = 'REF_FX_FORWARD'"
    },
    {
      "line": 85,
      "text": "             AND SRC_FLD_NAME = 'CONTR_STATUS'"
    },
    {
      "line": 86,
      "text": "             AND SRC_SYS_NAME='TIT')B"
    },
    {
      "line": 87,
      "text": "      ON      A.CONTR_STATUS =B.SRC_CD_VAL                  --CONTR_STATUS 转码"
    },
