      "text": "    ,TRIGGER_COUNT                                     AS  Trgr_Line_Qty           --触线数量         "
    },
    {
      "line": 150,
      "text": "    ,TRIGGER_TYPE                                      AS  Trgr_Line_Type_Cd       --触线类型代码     "
    },
    {
      "line": 151,
      "text": "    ,TRIGGER_VALUE_TYPE                                AS  Trgr_Line_Val_Type_Cd   --触线值类型代码   "
    },
    {
      "line": 152,
      "text": "    ,DIGITAL_TRIGGER                                   AS  Digit_Trgr_Line_Val     --二值期权触线值   "
    },
    {
      "line": 153,
      "text": "    ,NVL(E.DW_CD_VAL,PAYOUT_TYPE)                      AS  Fee_Paid_Way_Cd         --费用支付方式代码 "
    },
    {
      "line": 154,
      "text": "    ,GFS_PARTICIPATION_RATE                            AS  Prtc_Rate               --参与率           "
    },
    {
