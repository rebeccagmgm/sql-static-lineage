    },
    {
      "line": 190,
      "text": "       ON A.KEY_INSTRUMENT_ID=A2.KEY_INSTRUMENT_ID"
    },
    {
      "line": 191,
      "text": "LEFT JOIN (SELECT KEY_INSTRUMENT_ID,ATTRIBUTE_VALUE  FROM ODATA_N_TIT.D_REF_OPTION_ATTRIBUTE  WHERE BUSI_DATE ='${data_day_str}' AND ATTRIBUTE_NAME='PREMIUM' )A3"
    },
    {
      "line": 192,
      "text": "       ON A.KEY_INSTRUMENT_ID=A3.KEY_INSTRUMENT_ID"
