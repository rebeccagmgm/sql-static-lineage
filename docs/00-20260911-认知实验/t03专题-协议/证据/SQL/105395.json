      "text": "LEFT JOIN (SELECT KEY_OTC_TRADE_ID,KEY_INSTRUMENT_ID FROM ODATA_N_TIT.D_TRD_OTC_TRADE  WHERE BUSI_DATE ='${data_day_str}'  )B"
