      "text": "LEFT JOIN (SELECT KEY_INSTRUMENT_ID,ATTRIBUTE_VALUE  FROM ODATA_N_TIT.D_REF_OPTION_ATTRIBUTE  WHERE BUSI_DATE ='${data_day_str}' AND ATTRIBUTE_NAME='GFS_OPTION_TYPE' )A1"
