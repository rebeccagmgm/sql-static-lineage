    },
    {
      "line": 99,
      "text": "SELECT"
    },
    {
      "line": 100,
      "text": "     B.KEY_OTC_TRADE_ID                                  AS  Opt_ComP_Agt_Id         --期权合约协议编号"
    },
    {
      "line": 101,
      "text": "    ,CASE WHEN C.KEY_OTC_TRADE_ID IS NOT NULL THEN '20207'"
    },
    {
      "line": 102,
      "text": "          END                                          AS  Opt_ComP_Agt_Modifr     --期权合约协议修饰符      "
    },
    {
      "line": 103,
      "text": "    ,EXTERNAL_TRADE_ID                                 AS  Sub_Trd_Id              --子交易编号                              "
    },
    {
      "line": 104,
      "text": "    ,SUBSTR(VALID_STARTDATE,1,10)                      AS  Eff_Date                --生效日期                      "
    },
    {
      "line": 105,
      "text": "    ,SUBSTR(VALID_ENDDATE,1,10)                        AS  Exp_Date                --到期日期                      "
    },
    {
      "line": 106,
      "text": "    ,NVL(D.DW_CD_VAL,TRADE_STATUS)                     AS  Trd_Stat_Cd             --交易状态代码                          "
    },
    {
      "line": 107,
      "text": "    ,SEQ                                               AS  Sub_Trd_Seq             --子交易序号                              "
    },
    {
      "line": 108,
      "text": "    ,SUBSTR(TERMINATION_DATE,1,10)                     AS  Sub_Trd_Trmt_Date       --子交易终止日期 "
    },
    {
      "line": 109,
      "text": "    ,COEFFICIENT                                       AS  Sub_Trd_Coef            --子交易系数      "
    },
    {
      "line": 110,
      "text": "    ,CONCAT('TIT-',A.KEY_INSTRUMENT_ID)                  AS  Prd_Id                  --产品编号        "
    },
    {
      "line": 111,
      "text": "    ,A.KEY_INSTRUMENT_ID                                 AS  Src_Prd_Id              --源产品编号      "
    },
    {
      "line": 112,
      "text": "    ,PRODUCT_SUBTYPE                                   AS  Src_Scr_Sub_Type_Cd     --源证券子类型代码"
    },
    {
      "line": 113,
      "text": "    ,GFS_PRODUCT_REFERENCE                             AS  Src_Prd_Cd_Shor_Name    --源产品代码简称  "
    },
    {
      "line": 114,
      "text": "    ,KEY_BOOK_ID                                       AS  Book_Agt_Id             --账簿协议编号    "
    },
    {
      "line": 115,
      "text": "    ,IF(NVL(TRIM(KEY_BOOK_ID),'')='','','20411')       AS  Book_Agt_Modifr         --账簿协议修饰符  "
    },
    {
      "line": 116,
      "text": "    ,EXERCISE_TYPE                                     AS  Opt_Exec_Type_Cd        --期权执行类型代码"
    },
    {
      "line": 117,
      "text": "    ,CASE WHEN BUY_SELL = 'BUY'  THEN '1' "
    },
    {
      "line": 118,
      "text": "          WHEN BUY_SELL = 'SELL' THEN '2' END          AS  Buy_Sell_Dir_Cd         --买卖方向代码    "
    },
    {
      "line": 119,
      "text": "    ,CONCAT('TIT-',UNDERLYING_INS_ID)                  AS  Undrl_Cd                --标的代码                 "
    },
    {
      "line": 120,
      "text": "    ,SUBSTR(EFFECTIVE_DATE,1,10)                       AS  Bgng_Prcg_Date          --期初定价日期             "
    },
    {
      "line": 121,
      "text": "    ,SUBSTR(MATURITY_DATE,1,10)                        AS  Maty_Date               --到期日期                 "
    },
    {
      "line": 122,
      "text": "    ,SUBSTR(DELIVERY_DATE,1,10)                        AS  Yield_Pay_Date          --收益兑付日期             "
    },
    {
      "line": 123,
      "text": "    ,NOTIONAL                                          AS  Prin                    --本金        "
    },
    {
      "line": 124,
      "text": "    ,NOTIONAL_CURRENCY                                 AS  Prin_Crrc_Cd            --本金币种代码"
    },
    {
      "line": 125,
      "text": "    ,QUANTITY                                          AS  Qty                     --数量        "
    },
    {
      "line": 126,
      "text": "    ,SETTLE_TYPE                                       AS  Sett_Mode_Cd            --结算模式代码"
    },
    {
      "line": 127,
      "text": "    ,SETTLEMENT_CURRENCY                               AS  Sett_Crrc_Cd            --结算币种代码"
    },
    {
