      "text": "       ,CONCAT('10101-',EXCHANGE_TYPE,'-',STOCK_ACCOUNT)  AS AGT_MODIFR               --协议修饰符"
    },
    {
      "line": 58,
      "text": "       ,CLIENT_ID                                         AS AGT_HOLDER               --协议持有人编号"
    },
    {
      "line": 59,
      "text": "       ,'101'                                             AS AGT_CATE_CD              --协议类别代码"
    },
    {
      "line": 60,
      "text": "       ,'10101'                                           AS AGT_TYPE_CD              --协议类型代码"
    },
    {
      "line": 61,
      "text": "       ,LPAD(BRANCH_NO,4,'0')                             AS BEL_INR_ORG_ID           --所属内部机构编号"
    },
    {
      "line": 62,
      "text": "       ,NVL(B.DW_CD_VAL,A.EXCHANGE_TYPE)                  AS EXCH_TYPE_CD             --市场代码"
